@inject IJSRuntime JS
@inject ILogger<GenerarTicket> Logger

<button class="btn-pdf" @onclick="() => ExportarPdf(Venta,Empleado)">
    <i class="fa-solid fa-file-pdf"></i>
    <span>Exportar PDF</span>
</button>

@code {
    [Parameter]
    public Pulperia.Models.Venta Venta { get; set; } = default!;

    [Parameter]
    public Pulperia.Models.Empleado Empleado { get; set; } = default!;
    private async Task ExportarPdf(Pulperia.Models.Venta venta, Pulperia.Models.Empleado empleado)
    {
        try
        {
            // Generar PDF
            var pdfData = Pulperia.Services.VentaPdfGenerator.Generar(venta, empleado);

            // Nombre archivo
            var fileName = $"Recibo_{empleado.Nombre}_{empleado.Apellido}_{venta.Fecha:dd-MM-yyyy}_{venta.Id}.pdf";

            // Descargar
            await JS.InvokeVoidAsync(
                "saveAsFile",
                fileName,
                Convert.ToBase64String(pdfData)
            );
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error generando el PDF de la venta {VentaId}.", venta?.Id);
        }
    }
}