@inject PulperiaDbContext db

<div class="modal fade @(isVisible ? "show d-block" : "")" tabindex="-1" style="background-color: rgba(0,0,0,0.6);">

    <div class="modal-dialog modal-lg">
        <div class="modal-content bg-dark text-white border-secondary">

            <div class="modal-header border-secondary">
                <h5 class="modal-title">➕ Nuevo Producto</h5>
                <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
            </div>

            <div class="modal-body">

                <EditForm Model="@producto" OnValidSubmit="Guardar">

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label">Nombre</label>
                            <InputText class="form-control" @bind-Value="producto.Nombre" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Presentación</label>
                            <InputText class="form-control" @bind-Value="producto.Presentacion" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Costo</label>
                            <InputNumber class="form-control" @bind-Value="producto.PrecioCosto" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Venta</label>
                            <InputNumber class="form-control" @bind-Value="producto.PrecioVenta" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Stock</label>
                            <InputNumber class="form-control" @bind-Value="producto.StockActual" />
                        </div>
                                <div class="col-md-4">
                            <label class="form-label">Stock Minimo</label>
                            <InputNumber class="form-control" @bind-Value="producto.StockMinimo" />
                        </div>


                        <div class="col-md-4">
                            <label class="form-label">Categoria</label>
                            <InputSelect class="form-control" @bind-Value="producto.CategoriaId" >
                            @foreach(var i in Categorias){
                                <option value="@i.Id" > @i.Nombre</option>
                            }
                            </InputSelect>
                        </div>
                        

                    </div>

                    <div class="mt-4 d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-secondary" @onclick="Close">
                            Cancelar
                        </button>

                        <button type="submit" class="btn btn-primary">
                            Guardar
                        </button>
                    </div>

                </EditForm>

            </div>

        </div>
    </div>
</div>

@code {

    [Parameter] public EventCallback OnSaved { get; set; }

    private Producto producto = new Producto();
    private bool isVisible = false;

    private List<Categoria> Categorias =new();

    protected override async Task OnInitializedAsync()
    {
        Categorias = db.Categoria.ToList();
    }


    public void Show()
    {
        isVisible = true;
        StateHasChanged();
    }

    private void Close()
    {
        isVisible = false;
        producto = new Producto();
    }

    private async Task Guardar()
    {
        db.Producto.Add(producto);
        await db.SaveChangesAsync();

        isVisible = false;
        producto = new Producto();

        await OnSaved.InvokeAsync();
    }
}