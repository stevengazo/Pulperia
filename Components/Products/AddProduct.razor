@inject PulperiaDbContext db
@inject LogService LogService

<div class="@(isVisible ? "pm-overlay" : "d-none")">
    <div class="pm-box">

        <div class="pm-header">
            <p class="pm-title">Nuevo producto</p>
            <button class="pm-close" @onclick="Close">✕</button>
        </div>

        <div class="pm-body">
            <EditForm Model="@producto" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />

                <div class="pm-grid">

                    <div class="pm-field">
                        <label>Nombre</label>
                        <InputText class="form-control" @bind-Value="producto.Nombre" />
                        <ValidationMessage For="@(() => producto.Nombre)" class="pm-validation" />
                    </div>

                    <div class="pm-field">
                        <label>Presentación</label>
                        <InputText class="form-control" @bind-Value="producto.Presentacion" />
                        <ValidationMessage For="@(() => producto.Presentacion)" class="pm-validation" />
                    </div>

                    <div class="pm-3col">
                        <div class="pm-field">
                            <label>Costo</label>
                            <InputNumber class="form-control" @bind-Value="producto.PrecioCosto" />
                            <ValidationMessage For="@(() => producto.PrecioCosto)" class="pm-validation" />
                        </div>
                        <div class="pm-field">
                            <label>Venta</label>
                            <InputNumber class="form-control" @bind-Value="producto.PrecioVenta" />
                            <ValidationMessage For="@(() => producto.PrecioVenta)" class="pm-validation" />
                        </div>
                        <div class="pm-field">
                            <label>Stock actual</label>
                            <InputNumber class="form-control" @bind-Value="producto.StockActual" />
                            <ValidationMessage For="@(() => producto.StockActual)" class="pm-validation" />
                        </div>
                    </div>

                    <div class="pm-field">
                        <label>Stock mínimo</label>
                        <InputNumber class="form-control" @bind-Value="producto.StockMinimo" />
                        <ValidationMessage For="@(() => producto.StockMinimo)" class="pm-validation" />
                    </div>

                    <div class="pm-field">
                        <label>Categoría</label>

                        @if (!creandoCategoria)
                        {
                            <div class="pm-inline">
                                <InputSelect class="form-control" @bind-Value="producto.CategoriaId">
                                    <option value="">— Seleccione —</option>
                                    @foreach (var i in Categorias)
                                    {
                                        <option value="@i.Id">@i.Nombre</option>
                                    }
                                </InputSelect>
                                <button type="button" class="pm-icon-btn"
                                        title="Crear nueva categoría"
                                        @onclick="IniciarCreacionCategoria">
                                    +
                                </button>
                            </div>
                            <ValidationMessage For="@(() => producto.CategoriaId)" class="pm-validation" />
                        }
                        else
                        {
                            <div class="pm-inline">
                                <input class="form-control"
                                       placeholder="Nombre de la nueva categoría"
                                       @bind="nuevaCategoria"
                                       @bind:event="oninput" />
                                <button type="button" class="pm-icon-btn pm-icon-ok"
                                        title="Guardar categoría"
                                        disabled="@(guardandoCategoria || string.IsNullOrWhiteSpace(nuevaCategoria))"
                                        @onclick="CrearCategoria">
                                    ✓
                                </button>
                                <button type="button" class="pm-icon-btn"
                                        title="Cancelar"
                                        @onclick="CancelarCreacionCategoria">
                                    ✕
                                </button>
                            </div>
                            @if (!string.IsNullOrEmpty(categoriaError))
                            {
                                <span class="pm-validation">@categoriaError</span>
                            }
                        }
                    </div>

                </div>

                <div class="pm-divider"></div>

                <div class="pm-footer">
                    <button type="button" class="pm-btn pm-btn-cancel" @onclick="Close" disabled="@isSaving">Cancelar</button>
                    <button type="submit" class="pm-btn pm-btn-save" disabled="@isSaving">
                        @(isSaving ? "Guardando..." : "Guardar")
                    </button>
                </div>

            </EditForm>
        </div>

    </div>
</div>

@code {
    [Parameter] public EventCallback OnSaved { get; set; }

    private Producto producto = new Producto();
    private bool isVisible = false;
    private bool isSaving = false;
    private List<Categoria> Categorias = new();

    // Creación inline de categoría
    private bool creandoCategoria = false;
    private string nuevaCategoria = "";
    private string? categoriaError;
    private bool guardandoCategoria = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarCategorias();
    }

    private async Task CargarCategorias()
    {
        Categorias = await db.Categoria
            .AsNoTracking()
            .OrderBy(c => c.Nombre)
            .ToListAsync();
    }

    private void IniciarCreacionCategoria()
    {
        creandoCategoria = true;
        nuevaCategoria = "";
        categoriaError = null;
    }

    private void CancelarCreacionCategoria()
    {
        creandoCategoria = false;
        nuevaCategoria = "";
        categoriaError = null;
    }

    private async Task CrearCategoria()
    {
        if (guardandoCategoria) return;

        var nombre = nuevaCategoria?.Trim() ?? "";

        if (string.IsNullOrWhiteSpace(nombre))
        {
            categoriaError = "Ingrese un nombre.";
            return;
        }

        if (Categorias.Any(c =>
                string.Equals(c.Nombre, nombre, StringComparison.OrdinalIgnoreCase)))
        {
            categoriaError = "Esa categoría ya existe.";
            return;
        }

        guardandoCategoria = true;

        try
        {
            var categoria = new Categoria { Nombre = nombre };
            db.Categoria.Add(categoria);
            await db.SaveChangesAsync();

            await LogService.RegistrarAsync(
                tabla: "Categoria",
                accion: "INSERT",
                registroId: categoria.Id.ToString(),
                nuevo: new { categoria.Id, categoria.Nombre });

            await CargarCategorias();
            producto.CategoriaId = categoria.Id;

            creandoCategoria = false;
            nuevaCategoria = "";
            categoriaError = null;
        }
        finally
        {
            guardandoCategoria = false;
        }
    }

    public void Show()
    {
        isVisible = true;
        StateHasChanged();
    }

    private void Close()
    {
        isVisible = false;
        producto = new Producto();
        CancelarCreacionCategoria();
    }

    private async Task Guardar()
    {
        if (isSaving) return;
        isSaving = true;

        try
        {
            db.Producto.Add(producto);
            await db.SaveChangesAsync();

            await LogService.RegistrarAsync(
                tabla: "Producto",
                accion: "INSERT",
                registroId: producto.Id.ToString(),
                nuevo: new
                {
                    producto.Id,
                    producto.Nombre,
                    producto.Presentacion,
                    producto.PrecioCosto,
                    producto.PrecioVenta,
                    producto.StockActual,
                    producto.StockMinimo,
                    producto.CategoriaId
                });

            isVisible = false;
            producto = new Producto();

            await OnSaved.InvokeAsync();
        }
        finally
        {
            isSaving = false;
        }
    }
}