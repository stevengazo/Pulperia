@inject PulperiaDbContext db

<div class="@(isVisible ? "pm-overlay" : "d-none")">
    <div class="pm-box">

        <div class="pm-header">
            <p class="pm-title">Nuevo producto</p>
            <button class="pm-close" @onclick="Close">✕</button>
        </div>

        <div class="pm-body">
            <EditForm Model="@producto" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />

                <div class="pm-grid">

                    <div class="pm-field">
                        <label>Nombre</label>
                        <InputText class="form-control" @bind-Value="producto.Nombre" />
                        <ValidationMessage For="@(() => producto.Nombre)" class="pm-validation" />
                    </div>

                    <div class="pm-field">
                        <label>Presentación</label>
                        <InputText class="form-control" @bind-Value="producto.Presentacion" />
                        <ValidationMessage For="@(() => producto.Presentacion)" class="pm-validation" />
                    </div>

                    <div class="pm-3col">
                        <div class="pm-field">
                            <label>Costo</label>
                            <InputNumber class="form-control" @bind-Value="producto.PrecioCosto" />
                            <ValidationMessage For="@(() => producto.PrecioCosto)" class="pm-validation" />
                        </div>
                        <div class="pm-field">
                            <label>Venta</label>
                            <InputNumber class="form-control" @bind-Value="producto.PrecioVenta" />
                            <ValidationMessage For="@(() => producto.PrecioVenta)" class="pm-validation" />
                        </div>
                        <div class="pm-field">
                            <label>Stock actual</label>
                            <InputNumber class="form-control" @bind-Value="producto.StockActual" />
                            <ValidationMessage For="@(() => producto.StockActual)" class="pm-validation" />
                        </div>
                    </div>

                    <div class="pm-field">
                        <label>Stock mínimo</label>
                        <InputNumber class="form-control" @bind-Value="producto.StockMinimo" />
                        <ValidationMessage For="@(() => producto.StockMinimo)" class="pm-validation" />
                    </div>

                    <div class="pm-field">
                        <label>Categoría</label>
                        <InputSelect class="form-control" @bind-Value="producto.CategoriaId">
                            <option value="">— Seleccione —</option>
                            @foreach (var i in Categorias)
                            {
                                <option value="@i.Id">@i.Nombre</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => producto.CategoriaId)" class="pm-validation" />
                    </div>

                </div>

                <div class="pm-divider"></div>

                <div class="pm-footer">
                    <button type="button" class="pm-btn pm-btn-cancel" @onclick="Close" disabled="@isSaving">Cancelar</button>
                    <button type="submit" class="pm-btn pm-btn-save" disabled="@isSaving">
                        @(isSaving ? "Guardando..." : "Guardar")
                    </button>
                </div>

            </EditForm>
        </div>

    </div>
</div>

@code {
    [Parameter] public EventCallback OnSaved { get; set; }

    private Producto producto = new Producto();
    private bool isVisible = false;
    private bool isSaving = false;
    private List<Categoria> Categorias = new();

    protected override async Task OnInitializedAsync()
    {
        Categorias = await db.Categoria.AsNoTracking().ToListAsync();
    }

    public void Show()
    {
        isVisible = true;
        StateHasChanged();
    }

    private void Close()
    {
        isVisible = false;
        producto = new Producto();
    }

    private async Task Guardar()
    {
        if (isSaving) return;
        isSaving = true;

        try
        {
            db.Producto.Add(producto);
            await db.SaveChangesAsync();

            isVisible = false;
            producto = new Producto();

            await OnSaved.InvokeAsync();
        }
        finally
        {
            isSaving = false;
        }
    }
}