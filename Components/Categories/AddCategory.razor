@page "/add-category"

@inject PulperiaDbContext db
@inject LogService LogService

<h3 class="mb-3">➕ Agregar Categoría</h3>

<div class="card shadow-sm">
    <div class="card-body">

        <EditForm Model="@categoria" OnValidSubmit="Guardar">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Nombre de la categoría</label>
                <InputText class="form-control"
                           @bind-Value="categoria.Nombre" />
                <ValidationMessage For="@(() => categoria.Nombre)" class="text-danger small" />
            </div>

            <div class="d-flex justify-content-end gap-2">
                <button type="button"
                        class="btn btn-secondary"
                        @onclick="Limpiar">
                    Limpiar
                </button>

                <button type="submit"
                        class="btn btn-primary">
                    Guardar
                </button>
            </div>

        </EditForm>

    </div>
</div>

@code {

    private Categoria categoria = new Categoria();

    private async Task Guardar()
    {
        db.Categoria.Add(categoria);
        await db.SaveChangesAsync();

        await LogService.RegistrarAsync(
            tabla: "Categoria",
            accion: "INSERT",
            registroId: categoria.Id.ToString(),
            nuevo: new { categoria.Id, categoria.Nombre });

        categoria = new Categoria();
    }

    private void Limpiar()
    {
        categoria = new Categoria();
    }
}