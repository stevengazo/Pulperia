# Copia este archivo a .env y completa los valores (el .env queda fuera de git).
# Usado por docker-compose.yml

# Contraseña del usuario 'sa' de SQL Server.
# Requisito: 8+ caracteres con mayúsculas, minúsculas, números y símbolos.
SA_PASSWORD=Tu_Password_Fuerte123!

# Credenciales de Supabase (mismas que appsettings.json).
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANONKEY=TU_ANON_KEY
