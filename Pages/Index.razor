@page "/"
@using Microsoft.EntityFrameworkCore
@using Pulperia.Models
@inject EmpleadoService emp;
@inject IDbContextFactory<PulperiaDbContext> dbContextFactory
@implements IAsyncDisposable

<PageTitle>Dashboard</PageTitle>
<UserValidator>
<div class="dashboard-wrapper">

    <!-- HEADER -->
    <div class="dash-header">
        <div class="dash-head-left">
            <h2 class="dash-title">Dashboard</h2>
            <p class="dash-subtitle">Estadísticas generales de la pulpería</p>

            <div class="dash-chips">
                <span class="dash-chip">
                    <i class="bi bi-box-seam-fill"></i>
                    @TotalProductos productos
                </span>
                <span class="dash-chip">
                    <i class="bi bi-tag-fill"></i>
                    @TotalCategorias categorías
                </span>
            </div>
        </div>

        <div class="dash-head-right">
            <DateRangePicker OnRangeChanged="OnRangeChanged" />
            <span class="dash-period">@PeriodoTexto</span>
        </div>
    </div>

    <!-- CARDS SUPERIORES (según el período) -->
    <div class="row g-3 mb-4">

        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-icon" style="background: rgba(34,197,94,0.12); color: #4ade80;">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <p class="stat-label">Ventas del período</p>
                <h3 class="stat-value" style="color: #4ade80;">₡@TotalVentas.ToString("N0")</h3>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-icon" style="background: rgba(248,113,113,0.12); color: #f87171;">
                    <i class="bi bi-cart-dash-fill"></i>
                </div>
                <p class="stat-label">Compras del período</p>
                <h3 class="stat-value" style="color: #f87171;">₡@TotalCompras.ToString("N0")</h3>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-icon" style="background: rgba(255,170,67,0.12); color: #ffaa43;">
                    <i class="bi bi-cash-coin"></i>
                </div>
                <p class="stat-label">Ganancia del período</p>
                <h3 class="stat-value" style="color: @(Ganancia >= 0 ? "#ffaa43" : "#f87171");">
                    ₡@Ganancia.ToString("N0")
                </h3>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-icon" style="background: rgba(139,92,246,0.12); color: #a78bfa;">
                    <i class="bi bi-receipt"></i>
                </div>
                <p class="stat-label">N.º de ventas</p>
                <h3 class="stat-value" style="color: #a78bfa;">@NumVentas</h3>
            </div>
        </div>

    </div>

    <!-- SEGUNDA FILA: TABLAS -->
    <div class="row g-3 mb-4">

        <!-- BAJO STOCK -->
        <div class="col-lg-6">
            <div class="dash-card">
                <div class="dash-card-header">
                    <span class="dash-card-dot" style="background:#f87171;"></span>
                    <h6 class="dash-card-title">Productos con bajo stock</h6>
                    <span class="dash-card-hint">estado actual</span>
                </div>

                <div class="dash-card-body">
                    @if (ProductosBajoStock.Any())
                    {
                        <table class="dash-table">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th>Stock</th>
                                    <th>Mínimo</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in ProductosBajoStock)
                                {
                                    <tr>
                                        <td>@item.Nombre</td>
                                        <td><span class="badge-danger">@item.StockActual</span></td>
                                        <td class="text-muted-soft">@item.StockMinimo</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="bi bi-check-circle"></i>
                            <span>Todo el stock está bien</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- TOP PRODUCTOS -->
        <div class="col-lg-6">
            <div class="dash-card">
                <div class="dash-card-header">
                    <span class="dash-card-dot" style="background:#ffaa43;"></span>
                    <h6 class="dash-card-title">Productos más vendidos</h6>
                    <span class="dash-card-hint">del período</span>
                </div>

                <div class="dash-card-body">
                    @if (TopProductos.Any())
                    {
                        <table class="dash-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Producto</th>
                                    <th>Vendidos</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{int rank = 1;}
                                @foreach (var item in TopProductos)
                                {
                                    <tr>
                                        <td class="rank-cell">@(rank++)</td>
                                        <td>@item.Nombre</td>
                                        <td><span class="badge-accent">@item.TotalVendido</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="bi bi-bar-chart"></i>
                            <span>Sin ventas en el período</span>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>

    <!-- BARRAS EMPLEADOS -->
    <div class="row g-3">
        <div class="col-12">
            <div class="dash-card">
                <div class="dash-card-header">
                    <span class="dash-card-dot" style="background:#4ade80;"></span>
                    <h6 class="dash-card-title">Ventas por empleado</h6>
                    <span class="dash-card-hint">del período</span>
                </div>

                <div class="dash-card-body">
                    @if (comprasEmpleados.Any())
                    {
                        @foreach (var item in comprasEmpleados.OrderByDescending(e => e.Value))
                        {
                            var porcentaje = MaxEmpleado > 0 ? (item.Value / MaxEmpleado) * 100 : 0;

                            <div class="emp-row">
                                <div class="emp-info">
                                    <span class="emp-name">@item.Key</span>
                                    <span class="emp-amount">₡@item.Value.ToString("N2")</span>
                                </div>
                                <div class="emp-bar-track">
                                    <div class="emp-bar-fill" style="width: @porcentaje.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="bi bi-people"></i>
                            <span>Sin ventas a empleados en el período</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

</div>
</UserValidator>

@code {

    private PulperiaDbContext db;

    public async ValueTask DisposeAsync()
    {
        if (db is not null)
            await db.DisposeAsync();
    }

    // ── Datos crudos (se cargan una vez) ──────────────────────────
    private List<Pulperia.Models.Producto> Productos = new();
    private List<Venta> ventas = new();
    private List<CompraInventario> compras = new();
    private Dictionary<int, string> nombrePorProducto = new();
    private Dictionary<string, string> nombrePorEmpleado = new();

    // ── Métricas del período seleccionado ─────────────────────────
    private decimal TotalVentas;
    private decimal TotalCompras;
    private decimal Ganancia => TotalVentas - TotalCompras;
    private int NumVentas;

    private Dictionary<string, decimal> comprasEmpleados = new();
    private decimal MaxEmpleado;
    private List<TopProductoDto> TopProductos = new();

    // ── Métricas de estado actual (no dependen de la fecha) ────────
    private int TotalProductos;
    private int TotalCategorias;
    private List<Pulperia.Models.Producto> ProductosBajoStock = new();

    // ── Rango de fechas ───────────────────────────────────────────
    private DateTime _inicio = DateTime.MinValue;
    private DateTime _fin = DateTime.MaxValue;

    private string PeriodoTexto =>
        (_inicio == DateTime.MinValue && _fin == DateTime.MaxValue)
            ? "Todos los períodos"
            : $"{_inicio:dd MMM yyyy} — {_fin:dd MMM yyyy}";

    private bool EnRango(DateTime f) =>
        (_inicio == DateTime.MinValue || f.Date >= _inicio.Date) &&
        (_fin == DateTime.MaxValue || f.Date <= _fin.Date);

    protected override async Task OnInitializedAsync()
    {
        db = dbContextFactory.CreateDbContext();

        var empleados = await emp.GetAllAsync();
        nombrePorEmpleado = empleados
            .GroupBy(e => e.Id.ToString())
            .ToDictionary(g => g.Key, g => $"{g.First().Nombre} {g.First().Apellido}");

        Productos = await db.Producto
            .Include(e => e.Categoria)
            .AsNoTracking()
            .ToListAsync();

        nombrePorProducto = Productos.ToDictionary(p => p.Id, p => p.Nombre);

        ventas = await db.Venta
            .Include(v => v.DetalleVentas)
            .AsNoTracking()
            .ToListAsync();

        compras = await db.CompraInventario
            .Include(c => c.DetalleCompras)
            .AsNoTracking()
            .ToListAsync();

        // Estado actual (independiente del período).
        TotalProductos = Productos.Count;
        TotalCategorias = await db.Categoria.CountAsync();
        ProductosBajoStock = Productos
            .Where(e => e.StockActual <= e.StockMinimo)
            .OrderBy(e => e.StockActual)
            .ToList();

        Recalcular();
    }

    private void OnRangeChanged((DateTime Inicio, DateTime Fin) rango)
    {
        (_inicio, _fin) = rango;
        Recalcular();
        StateHasChanged();
    }

    private void Recalcular()
    {
        var ventasRango = ventas.Where(v => EnRango(v.Fecha)).ToList();

        TotalVentas = ventasRango.Sum(v => v.Total);
        NumVentas = ventasRango.Count;

        TotalCompras = compras
            .Where(c => EnRango(c.Fecha))
            .SelectMany(c => c.DetalleCompras)
            .Sum(d => d.Cantidad * d.PrecioUnitario);

        TopProductos = ventasRango
            .SelectMany(v => v.DetalleVentas)
            .GroupBy(d => d.ProductoId)
            .Select(g => new TopProductoDto
            {
                Nombre = nombrePorProducto.TryGetValue(g.Key, out var n) ? n : $"#{g.Key}",
                TotalVendido = g.Sum(d => d.Cantidad)
            })
            .Where(t => t.TotalVendido > 0)
            .OrderByDescending(t => t.TotalVendido)
            .Take(5)
            .ToList();

        comprasEmpleados = ventasRango
            .Where(v => !string.IsNullOrEmpty(v.ClienteId))
            .GroupBy(v => v.ClienteId!)
            .Where(g => nombrePorEmpleado.ContainsKey(g.Key))
            .ToDictionary(
                g => nombrePorEmpleado[g.Key],
                g => g.Sum(v => v.MontoRecibido));

        MaxEmpleado = comprasEmpleados.Any() ? comprasEmpleados.Values.Max() : 0;
    }

    public class TopProductoDto
    {
        public string Nombre { get; set; }
        public int TotalVendido { get; set; }
    }
}
