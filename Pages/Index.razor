@page "/"
@using Microsoft.EntityFrameworkCore
@using Pulperia.Models
@inject EmpleadoService emp;
@inject IDbContextFactory<PulperiaDbContext> dbContextFactory

<PageTitle>Dashboard</PageTitle>
<UserValidator>
<div class="dashboard-wrapper">

    <!-- HEADER -->
    <div class="dash-header">
        <div>
            <h2 class="dash-title">Dashboard</h2>
            <p class="dash-subtitle">Estadísticas generales de la pulpería</p>
        </div>
        <div class="dash-date">
            <i class="bi bi-calendar3"></i>
            @DateTime.Now.ToString("dd MMM yyyy")
        </div>
    </div>

    <!-- CARDS SUPERIORES -->
    <div class="row g-3 mb-4">

        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-icon" style="background: rgba(255,170,67,0.12); color: #ffaa43;">
                    <i class="bi bi-box-seam-fill"></i>
                </div>
                <p class="stat-label">Productos</p>
                <h3 class="stat-value" style="color: #ffaa43;">@TotalProductos</h3>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-icon" style="background: rgba(139,92,246,0.12); color: #a78bfa;">
                    <i class="bi bi-tag-fill"></i>
                </div>
                <p class="stat-label">Categorías</p>
                <h3 class="stat-value" style="color: #a78bfa;">@TotalCategorias</h3>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-icon" style="background: rgba(34,197,94,0.12); color: #4ade80;">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <p class="stat-label">Total Ventas</p>
                <h3 class="stat-value" style="color: #4ade80;">₡@TotalVentas.ToString("N0")</h3>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-icon" style="background: rgba(248,113,113,0.12); color: #f87171;">
                    <i class="bi bi-cart-dash-fill"></i>
                </div>
                <p class="stat-label">Total Compras</p>
                <h3 class="stat-value" style="color: #f87171;">₡@TotalCompras.ToString("N0")</h3>
            </div>
        </div>

    </div>

    <!-- SEGUNDA FILA: TABLAS -->
    <div class="row g-3 mb-4">

        <!-- BAJO STOCK -->
        <div class="col-lg-6">
            <div class="dash-card h-100">
                <div class="dash-card-header">
                    <span class="dash-card-dot" style="background:#f87171;"></span>
                    <h6 class="dash-card-title">Productos con bajo stock</h6>
                </div>

                <div class="dash-card-body">
                    @if (ProductosBajoStock.Any())
                    {
                        <table class="dash-table">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th>Stock</th>
                                    <th>Mínimo</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in ProductosBajoStock)
                                {
                                    <tr>
                                        <td>@item.Nombre</td>
                                        <td><span class="badge-danger">@item.StockActual</span></td>
                                        <td class="text-muted-soft">@item.StockMinimo</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="bi bi-check-circle"></i>
                            <span>Todo el stock está bien</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- TOP PRODUCTOS -->
        <div class="col-lg-6">
            <div class="dash-card h-100">
                <div class="dash-card-header">
                    <span class="dash-card-dot" style="background:#ffaa43;"></span>
                    <h6 class="dash-card-title">Productos más vendidos</h6>
                </div>

                <div class="dash-card-body">
                    @if (TopProductos.Any())
                    {
                        <table class="dash-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Producto</th>
                                    <th>Vendidos</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{int rank = 1;}
                                @foreach (var item in TopProductos)
                                {
                                    <tr>
                                        <td class="rank-cell">@(rank++)</td>
                                        <td>@item.Nombre</td>
                                        <td><span class="badge-accent">@item.TotalVendido</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="bi bi-bar-chart"></i>
                            <span>Sin ventas registradas</span>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>

    <!-- BARRAS EMPLEADOS -->
    <div class="row g-3">
        <div class="col-12">
            <div class="dash-card">
                <div class="dash-card-header">
                    <span class="dash-card-dot" style="background:#4ade80;"></span>
                    <h6 class="dash-card-title">Ventas por empleado</h6>
                </div>

                <div class="dash-card-body">
                    @if (comprasEmpleados.Any())
                    {
                        @foreach (var item in comprasEmpleados.OrderByDescending(e => e.Value))
                        {
                            var porcentaje = TotalVentas > 0 ? (item.Value / TotalVentas) * 100 : 0;

                            <div class="emp-row">
                                <div class="emp-info">
                                    <span class="emp-name">@item.Key</span>
                                    <span class="emp-amount">₡@item.Value.ToString("N2")</span>
                                </div>
                                <div class="emp-bar-track">
                                    <div class="emp-bar-fill" style="width: @porcentaje%"></div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="bi bi-people"></i>
                            <span>Sin ventas a empleados</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

</div>
</UserValidator>

<style>
    :root {
        --accent:       #ffaa43;
        --accent-glow:  rgba(255, 170, 67, 0.12);
        --bg:           #0f1117;
        --surface:      #181c27;
        --surface-2:    #1e2333;
        --border:       rgba(255,255,255,0.06);
        --text:         rgba(255,255,255,0.85);
        --text-muted:   rgba(255,255,255,0.4);
    }

    /* Layout */
    .dashboard-wrapper {
        padding: 2rem;
        background-color: var(--bg);
        min-height: 100vh;
        color: var(--text);
    }

    /* Header */
    .dash-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 2rem;
    }

    .dash-title {
        font-size: 1.6rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        color: var(--text);
        margin-bottom: 0.15rem;
    }

    .dash-subtitle {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin: 0;
    }

    .dash-date {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.8rem;
        color: var(--text-muted);
        background: var(--surface);
        border: 1px solid var(--border);
        padding: 0.4rem 0.85rem;
        border-radius: 20px;
    }

    /* Stat cards */
    .stat-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 1.25rem;
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .stat-card:hover {
        transform: translateY(-3px);
        border-color: rgba(255,255,255,0.12);
    }

    .stat-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 10px;
        font-size: 1.05rem;
        margin-bottom: 0.85rem;
    }

    .stat-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
        margin-bottom: 0.25rem;
    }

    .stat-value {
        font-size: 1.55rem;
        font-weight: 800;
        margin: 0;
        letter-spacing: -0.02em;
    }

    /* Dash card contenedor */
    .dash-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        overflow: hidden;
        transition: transform 0.2s ease;
    }

    .dash-card:hover {
        transform: translateY(-2px);
    }

    .dash-card-header {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--border);
    }

    .dash-card-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .dash-card-title {
        font-size: 0.875rem;
        font-weight: 700;
        margin: 0;
        color: var(--text);
        letter-spacing: 0.01em;
    }

    .dash-card-body {
        padding: 1.25rem;
    }

    /* Tabla */
    .dash-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
    }

    .dash-table thead tr {
        border-bottom: 1px solid var(--border);
    }

    .dash-table th {
        padding: 0.5rem 0.75rem;
        color: var(--text-muted);
        font-weight: 600;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.07em;
    }

    .dash-table td {
        padding: 0.65rem 0.75rem;
        color: var(--text);
        border-bottom: 1px solid var(--border);
    }

    .dash-table tbody tr:last-child td {
        border-bottom: none;
    }

    .dash-table tbody tr:hover td {
        background: rgba(255,255,255,0.03);
    }

    .rank-cell {
        color: var(--text-muted);
        font-size: 0.75rem;
        font-weight: 700;
        width: 30px;
    }

    .text-muted-soft {
        color: var(--text-muted);
    }

    /* Badges */
    .badge-danger {
        display: inline-block;
        padding: 0.2rem 0.6rem;
        background: rgba(248,113,113,0.15);
        color: #f87171;
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 700;
    }

    .badge-accent {
        display: inline-block;
        padding: 0.2rem 0.6rem;
        background: var(--accent-glow);
        color: var(--accent);
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 700;
    }

    /* Empty state */
    .empty-state {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text-muted);
        font-size: 0.85rem;
        padding: 0.5rem 0;
    }

    /* Barras empleados */
    .emp-row {
        margin-bottom: 1.1rem;
    }

    .emp-row:last-child {
        margin-bottom: 0;
    }

    .emp-info {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.4rem;
    }

    .emp-name {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--text);
    }

    .emp-amount {
        font-size: 0.875rem;
        font-weight: 700;
        color: var(--accent);
    }

    .emp-bar-track {
        height: 6px;
        background: var(--surface-2);
        border-radius: 99px;
        overflow: hidden;
    }

    .emp-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--accent), #ffcc80);
        border-radius: 99px;
        transition: width 0.6s ease;
    }

    /* Responsive */
    @@media (max-width: 767.98px) {
        .dashboard-wrapper {
            padding: 1rem;
        }

        .dash-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.75rem;
        }
    }
</style>

@code {

    private PulperiaDbContext db;

    private List<Pulperia.Models.Empleado> empleados = new();
    private List<Pulperia.Models.Producto> Productos = new();

    private Dictionary<string, decimal> comprasEmpleados = new();

    private decimal TotalVentas;
    private decimal TotalCompras;

    private int TotalProductos;
    private int TotalCategorias;

    private List<Pulperia.Models.Producto> ProductosBajoStock = new();

    private List<Venta> ventas = new();

    private List<TopProductoDto> TopProductos = new();

    protected override async Task OnInitializedAsync()
    {
        db = dbContextFactory.CreateDbContext();

        empleados = await emp.GetAllAsync();

        Productos = await db.Producto
            .Include(e => e.DetalleCompras)
            .Include(e => e.DetalleVentas)
            .Include(e => e.Categoria)
            .ToListAsync();

        ventas = await db.Venta.ToListAsync();

        foreach (var e in empleados)
        {
            var ventasPorEmpleado = ventas.Where(emp => emp.ClienteId == e.Id.ToString()).ToList();

            if (ventasPorEmpleado.Any())
            {
                var montoVendido = ventasPorEmpleado.Sum(e => e.MontoRecibido);
                comprasEmpleados.Add($"{e.Nombre} {e.Apellido}", montoVendido);
            }
        }

        TotalProductos = Productos.Count();

        TotalCategorias = await db.Categoria.CountAsync();

        TotalVentas = await db.Venta
            .SumAsync(e => (decimal?)e.Total) ?? 0;

        TotalCompras = await db.DetalleCompra
            .SumAsync(e => (decimal?)(e.Cantidad * e.PrecioUnitario)) ?? 0;

        ProductosBajoStock = Productos
            .Where(e => e.StockActual <= e.StockMinimo)
            .OrderBy(e => e.StockActual)
            .ToList();

        TopProductos = Productos
            .Select(e => new TopProductoDto
            {
                Nombre = e.Nombre,
                TotalVendido = e.DetalleVentas.Sum(v => v.Cantidad)
            })
            .OrderByDescending(e => e.TotalVendido)
            .Take(5)
            .ToList();
    }

    public class TopProductoDto
    {
        public string Nombre { get; set; }
        public int TotalVendido { get; set; }
    }
}
