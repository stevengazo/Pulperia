@page "/"
@using Microsoft.EntityFrameworkCore
@using Pulperia.Models
@inject EmpleadoService emp;

@inject IDbContextFactory<PulperiaDbContext> dbContextFactory

<PageTitle>Dashboard</PageTitle>

<div class="container-fluid py-4 bg-dark text-light min-vh-100">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Dashboard</h2>
            <p class="text-secondary mb-0">
                Estadísticas generales de la pulpería
            </p>
        </div>
    </div>

    <!-- CARDS -->
    <div class="row g-4 mb-4">

        <div class="col-md-3">
            <div class="card border-0 shadow-lg bg-dark-card h-100">
                <div class="card-body">
                    <p class="text-secondary mb-2">
                        Productos
                    </p>

                    <h2 class="fw-bold text-info">
                        @TotalProductos
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-lg bg-dark-card h-100">
                <div class="card-body">
                    <p class="text-secondary mb-2">
                        Categorías
                    </p>

                    <h2 class="fw-bold text-warning">
                        @TotalCategorias
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-lg bg-dark-card h-100">
                <div class="card-body">
                    <p class="text-secondary mb-2">
                        Ventas
                    </p>

                    <h2 class="fw-bold text-success">
                        ₡@TotalVentas.ToString("N2")
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-lg bg-dark-card h-100">
                <div class="card-body">
                    <p class="text-secondary mb-2">
                        Compras
                    </p>

                    <h2 class="fw-bold text-danger">
                        ₡@TotalCompras.ToString("N2")
                    </h2>
                </div>
            </div>
        </div>

    </div>

    <!-- SEGUNDA FILA -->
    <div class="row g-4">

        <!-- PRODUCTOS BAJO STOCK -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-lg bg-dark-card h-100">
                <div class="card-header border-0 bg-transparent">
                    <h5 class="fw-bold mb-0">
                        Productos con bajo stock
                    </h5>
                </div>

                <div class="card-body">

                    @if (ProductosBajoStock.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-dark table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th>Stock</th>
                                        <th>Mínimo</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in ProductosBajoStock)
                                    {
                                        <tr>
                                            <td>@item.Nombre</td>

                                            <td>
                                                <span class="badge bg-danger">
                                                    @item.StockActual
                                                </span>
                                            </td>

                                            <td>@item.StockMinimo</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-secondary">
                            No hay productos con bajo stock.
                        </div>
                    }

                </div>
            </div>
        </div>

        <!-- PRODUCTOS MÁS VENDIDOS -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-lg bg-dark-card h-100">
                <div class="card-header border-0 bg-transparent">
                    <h5 class="fw-bold mb-0">
                        Productos más vendidos
                    </h5>
                </div>

                <div class="card-body">

                    @if (TopProductos.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-dark table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th>Vendidos</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in TopProductos)
                                    {
                                        <tr>
                                            <td>@item.Nombre</td>

                                            <td>
                                                <span class="badge bg-success">
                                                    @item.TotalVendido
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-secondary">
                            No hay ventas registradas.
                        </div>
                    }

                </div>
            </div>
        </div>

    </div>

    <!-- VISUAL EMPLEADOS -->
    <div class="row g-4 mt-1">

        <div class="col-12">
            <div class="card border-0 shadow-lg bg-dark-card">
                
                <div class="card-header border-0 bg-transparent">
                    <h5 class="fw-bold mb-0">
                        Ventas realizadas a empleados
                    </h5>
                </div>

                <div class="card-body">

                    @if (comprasEmpleados.Any())
                    {
                        @foreach (var item in comprasEmpleados.OrderByDescending(e => e.Value))
                        {
                            var porcentaje = TotalVentas > 0
                            ? (item.Value / TotalVentas) * 100
                            : 0;

                            <div class="mb-4">

                                <div class="d-flex justify-content-between mb-2">
                                    <span class="fw-semibold">
                                        @item.Key
                                    </span>

                                    <span class="text-success fw-bold">
                                        ₡@item.Value.ToString("N2")
                                    </span>
                                </div>

                                <div class="progress custom-progress">
                                    <div class="progress-bar bg-success"
                                         role="progressbar"
                                         style="width: @porcentaje%">
                                    </div>
                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-secondary">
                            No hay ventas registradas para empleados.
                        </div>
                    }

                </div>

            </div>
        </div>

    </div>

</div>

<style>
    body {
        background-color: #0f1115;
    }

    .bg-dark-card {
        background-color: #1a1d24;
        border-radius: 18px;
    }

    .table {
        margin-bottom: 0;
    }

    .card {
        transition: .2s ease-in-out;
    }

    .card:hover {
        transform: translateY(-3px);
    }

    .custom-progress {
        height: 14px;
        background-color: #2b3038;
        border-radius: 20px;
        overflow: hidden;
    }

    .progress-bar {
        border-radius: 20px;
    }
</style>

@code {

    private PulperiaDbContext db;

    private List<Pulperia.Models.Empleado> empleados = new();
    private List<Pulperia.Models.Producto> Productos = new();

    private Dictionary<string, decimal> comprasEmpleados = new();

    private decimal TotalVentas;
    private decimal TotalCompras;

    private int TotalProductos;
    private int TotalCategorias;

    private List<Pulperia.Models.Producto> ProductosBajoStock = new();

    private List<Venta> ventas = new();

    private List<TopProductoDto> TopProductos = new();

    protected override async Task OnInitializedAsync()
    {
        db = dbContextFactory.CreateDbContext();

        empleados = await emp.GetAllAsync();

        Productos = await db.Producto
            .Include(e => e.DetalleCompras)
            .Include(e => e.DetalleVentas)
            .Include(e => e.Categoria)
            .ToListAsync();

        ventas = await db.Venta.ToListAsync();

        foreach (var e in empleados)
        {
            var ventasPorEmpleado = ventas.Where(emp => emp.ClienteId == e.Id.ToString()).ToList();

            if (ventasPorEmpleado.Any())
            {
                var montoVendido = ventasPorEmpleado.Sum(e => e.MontoRecibido);

                comprasEmpleados.Add($"{e.Nombre} {e.Apellido}", montoVendido);
            }
        }

        TotalProductos = Productos.Count();

        TotalCategorias = await db.Categoria.CountAsync();

        TotalVentas = await db.Venta
            .SumAsync(e => (decimal?)e.Total) ?? 0;

        TotalCompras = await db.DetalleCompra
            .SumAsync(e => (decimal?)(e.Cantidad * e.PrecioUnitario)) ?? 0;

        ProductosBajoStock = Productos
            .Where(e => e.StockActual <= e.StockMinimo)
            .OrderBy(e => e.StockActual)
            .ToList();

        TopProductos = Productos
            .Select(e => new TopProductoDto
            {
                Nombre = e.Nombre,
                TotalVendido = e.DetalleVentas.Sum(v => v.Cantidad)
            })
            .OrderByDescending(e => e.TotalVendido)
            .Take(5)
            .ToList();
    }

    public class TopProductoDto
    {
        public string Nombre { get; set; }

        public int TotalVendido { get; set; }
    }

}