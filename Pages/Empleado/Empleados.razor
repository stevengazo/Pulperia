@page "/empleados"

@inject EmpleadoService emp

<style>

    .employees-page {
        min-height: 100vh;
        padding: 2rem;
        font-family: 'Inter', system-ui, sans-serif;
    }

    .employees-container {
        max-width: 1200px;
        margin: auto;
    }

    .employees-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .employees-title h2 {
        color: #f5f7fa;
        margin: 0;
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: -0.04em;
    }

    .employees-title p {
        margin: 6px 0 0;
        color: #707887;
        font-size: .92rem;
    }

    .employees-card {
        background: #11151b;
        border: 1px solid #1b1f27;
        border-radius: 28px;
        overflow: hidden;
        box-shadow: 0 24px 60px rgba(0,0,0,.35);
    }

    .table-modern thead {
        background: #0f1318;
    }

    .table-modern thead th {
        border: none;
        color: #7e8796;
        font-size: .72rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        padding: 20px 18px;
    }

    .table-modern tbody tr {
        border-top: 1px solid #1a1f27;
        transition: background .15s ease;
    }

    .table-modern tbody tr:hover {
        background: rgba(255,170,67,.03);
    }

    .table-modern tbody td {
        border: none;
        padding: 20px 18px;
        color: #d7dde7;
        vertical-align: middle;
    }

    .employee-avatar {
        width: 52px;
        height: 52px;
        border-radius: 16px;
        overflow: hidden;
        flex-shrink: 0;

        background: rgba(255,170,67,.12);
        border: 1px solid rgba(255,170,67,.18);

        display: flex;
        align-items: center;
        justify-content: center;
    }

    .employee-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .employee-avatar i {
        color: #ffaa43;
        font-size: 1rem;
    }

    .employee-name {
        color: #f5f7fa;
        font-weight: 700;
        font-size: .95rem;
    }

    .employee-id {
        color: #707887;
        font-size: .82rem;
        font-family: monospace;
        margin-top: 4px;
    }

    .badge-modern {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,170,67,.12);
        color: #ffaa43;
        border: 1px solid rgba(255,170,67,.18);
        padding: 8px 14px;
        border-radius: 999px;
        font-size: .8rem;
        font-weight: 700;
    }

    .actions {
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    .btn-action {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        border: 1px solid #232936;
        background: #151922;
        color: #7e8796;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: .15s ease;
    }

    .btn-action:hover {
        background: rgba(255,170,67,.08);
        border-color: rgba(255,170,67,.18);
        color: #ffaa43;
    }

    .search-box {
        width: 320px;
        background: #11151b;
        border: 1px solid #1b1f27;
        border-radius: 12px;
        padding: 10px 14px;
        color: #f5f7fa;
        outline: none;
        transition: .15s ease;
    }

    .search-box:focus {
        border-color: rgba(255,170,67,.35);
        box-shadow: 0 0 0 3px rgba(255,170,67,.08);
    }

    .empty-state {
        padding: 4rem;
        text-align: center;
        color: #707887;

        display: flex;
        flex-direction: column;
        gap: 1rem;
        align-items: center;
        justify-content: center;
    }

    .empty-state i {
        font-size: 2rem;
        color: #ffaa43;
    }

    @@media (max-width: 768px) {

        .employees-page {
            padding: 1rem;
        }

        .employees-header {
            align-items: stretch;
        }

        .search-box {
            width: 100%;
        }

    }

</style>

<div class="employees-page">

    <div class="employees-container">

        <div class="employees-header">

            <div class="employees-title">
                <h2>Empleados</h2>
                <p>Administración y listado de empleados registrados</p>
            </div>

            <div class="d-flex gap-3 align-items-center flex-wrap">

                <input class="search-box"
                       placeholder="Buscar por nombre o apellido..."
                       @bind="searchText"
                       @bind:event="oninput" />

                <div class="badge-modern">
                    <i class="fa-solid fa-users"></i>
                    @filtered.Count empleado@(filtered.Count != 1 ? "s" : "")
                </div>

            </div>

        </div>

        <div class="employees-card">

            <div class="table-responsive">

                <table class="table table-modern align-middle">

                    <thead>
                        <tr>
                            <th class="ps-4">Empleado</th>
                            <th>Apellido</th>
                            <th class="text-center pe-4">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (!filtered.Any())
                        {
                            <tr>
                                <td colspan="3">

                                    <div class="empty-state">
                                        <i class="fa-solid fa-users-slash"></i>
                                        <div>No hay empleados que coincidan</div>
                                    </div>

                                </td>
                            </tr>
                        }

                        @foreach (var i in filtered)
                        {
                            <tr>

                                <td class="ps-4">

                                    <div class="d-flex align-items-center gap-3">

                                        <div class="employee-avatar">

                                            @if (!string.IsNullOrWhiteSpace(i.Photo))
                                            {
                                                <img src="@i.Photo"
                                                     alt="@i.Nombre" />
                                            }
                                            else
                                            {
                                                <i class="fa-solid fa-user"></i>
                                            }

                                        </div>

                                        <div>

                                            <div class="employee-name">
                                                @i.Nombre
                                            </div>

                                            <div class="employee-id">
                                                EMP-@i.Id
                                            </div>

                                        </div>

                                    </div>

                                </td>

                                <td>
                                    @i.Apellido
                                </td>

                                <td class="text-center pe-4">

                                    <div class="actions">

                                        <a class="btn-action"
                                           href="/empleado/@i.Id">

                                            <i class="fa-solid fa-eye"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@code {

    private List<Pulperia.Models.Empleado> empleados = new();

    private string searchText = string.Empty;

    private List<Pulperia.Models.Empleado> filtered =>
        string.IsNullOrWhiteSpace(searchText)
            ? empleados
            : empleados.Where(e =>
                (e.Nombre?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)
                || (e.Apellido?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)
            ).ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            empleados = await emp.GetAllAsync();

            empleados = empleados
                .Where(e => e.Activo)
                .OrderBy(e => e.Nombre)
                .ToList();
        }
        catch (Exception e)
        {
            Console.WriteLine(e.Message);
        }
    }
}