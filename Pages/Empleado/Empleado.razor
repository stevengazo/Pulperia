@page "/empleado/{id}"

@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop

@inject EmpleadoService emp
@inject IDbContextFactory<PulperiaDbContext> DbFactory
@inject IJSRuntime JS
@inject ILogger<Empleado> Logger

<PageTitle>Empleado</PageTitle>


<UserValidator>
    <div class="employee-page">

        <div class="container-max">

            @if (isLoading)
            {
                <div class="loading">
                    Cargando...
                </div>
            }
            else if (empleado is null)
            {
                <div class="empty">
                    Empleado no encontrado
                </div>
            }
            else
            {
                <div class="invoice">

                    <!-- HEADER -->
                    <div class="invoice-header">

                        <div class="employee-info">

                            <div class="employee-photo">

                                @if (!string.IsNullOrWhiteSpace(empleado.Photo))
                                {
                                    <img src="@empleado.Photo" alt="@empleado.Nombre" />
                                }
                                else
                                {
                                    <i class="fa-solid fa-user"></i>
                                }

                            </div>

                            <div class="invoice-title">
                                <h2>
                                    @empleado.Nombre @empleado.Apellido
                                </h2>

                                <div class="muted">
                                    Historial de ventas del empleado
                                </div>
                            </div>

                        </div>

                        <div class="emp-badge">
                            ID: @empleado.Id
                        </div>

                    </div>

                    <!-- STATS -->
                    <div class="stats-grid">

                        <div class="stat-card">
                            <div class="stat-label">
                                Ventas
                            </div>

                            <div class="stat-value">
                                @FilteredVentas.Count
                            </div>
                        </div>

                        <div class="stat-card">
                            <div class="stat-label">
                                Total Vendido
                            </div>

                            <div class="stat-value">
                             @SumVentas(FilteredVentas)
                            </div>
                        </div>

                    </div>

                    <!-- FILTERS -->
                    <div class="filters">

                        <DateRangePicker OnRangeChanged="OnRangeChanged" />

                        <button class="btn-export" @onclick="ExportCsv">
                            <i class="fa-solid fa-file-csv"></i>
                        </button>

                    </div>

                    @if (!FilteredVentas.Any())
                    {
                        <div class="empty">
                            No hay ventas registradas
                        </div>
                    }
                    else
                    {
                        <div class="table-wrap">

                            <table>

                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Fecha</th>
                                        <th>Total</th>
                                        <th>Acción</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var v in FilteredVentas)
                                    {
                                        <tr>

                                            <td class="id-cell">
                                                #@v.Id
                                            </td>

                                            <td style="color:#707887;">
                                                @v.Fecha.ToString("dd MMM yyyy, hh:mm tt")
                                            </td>

                                            <td class="total">
                                                ₡@v.Total.ToString("N2")
                                            </td>

                                            <td>
                                                <GenerarTicket Venta="v" Empleado="empleado" />
                                                <a class="link" href="/venta/@v.Id">

                                                    Ver recibo →

                                                </a>
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }

                </div>
            }

        </div>

    </div>

</UserValidator>


@code {

    [Parameter]
    public string id { get; set; } = string.Empty;

    private List<Venta> Ventas = new();

    private Pulperia.Models.Empleado? empleado;

    private bool isLoading = true;

    private PulperiaDbContext? db;

    private DateTime? fechaInicio = null;
    private DateTime? fechaFin = null;

    private void OnRangeChanged((DateTime Inicio, DateTime Fin) rango)
    {
        fechaInicio = rango.Inicio;
        fechaFin = rango.Fin;
    }

    private List<Venta> FilteredVentas =>
        Ventas
            .Where(v =>
                (!fechaInicio.HasValue || v.Fecha.Date >= fechaInicio.Value.Date) &&
                (!fechaFin.HasValue || v.Fecha.Date <= fechaFin.Value.Date)
            )
            .OrderByDescending(v => v.Fecha)
            .ToList();

    private string SumVentas(List<Pulperia.Models.Venta> ventas)
    {
        var total = ventas.Sum(v => v.Total);
        return $"₡{total:N2}";
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            db = DbFactory.CreateDbContext();

            empleado = await emp.GetByIdAsync(id);

            if (empleado != null)
            {
                Ventas = await db.Venta
                    .Include(v => v.DetalleVentas)
                        .ThenInclude(d => d.Producto)
                    .Where(v => v.ClienteId == empleado.Id.ToString())
                    .OrderByDescending(v => v.Fecha)
                    .ToListAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error cargando las ventas del empleado {EmpleadoId}.", id);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ExportCsv()
    {
        try
        {
            var sb = new System.Text.StringBuilder();

            sb.AppendLine("Id,Fecha,Total");

            foreach (var venta in FilteredVentas)
            {
                sb.AppendLine(
                    $"{venta.Id},{venta.Fecha:yyyy-MM-dd HH:mm},{venta.Total}"
                );
            }

            var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());

            var base64 = Convert.ToBase64String(bytes);

            await JS.InvokeVoidAsync(
                "downloadBase64File",
                base64,
                $"ventas-empleado-{empleado?.Id}.csv",
                "text/csv"
            );
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error exportando el CSV de ventas del empleado {EmpleadoId}.", empleado?.Id);
        }
    }

    public void Dispose()
    {
        db?.Dispose();
    }
}