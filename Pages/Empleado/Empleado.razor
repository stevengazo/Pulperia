@page "/empleado/{id}"

@inject EmpleadoService emp
@inject IDbContextFactory<PulperiaDbContext> DbFactory

<PageTitle>Empleado</PageTitle>

<style>
    .employee-page {
        min-height: 100vh;
        padding: 2rem;
        color: #f5f7fa;
        font-family: 'Inter', system-ui, sans-serif;
    }

    .container-max {
        max-width: 1000px;
        margin: auto;
    }

    .invoice {
        background: #181c27;
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 18px;
        padding: 2rem;
        box-shadow: 0 24px 60px rgba(0,0,0,.35);
    }

    .invoice-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        border-bottom: 1px solid rgba(255,255,255,0.06);
        padding-bottom: 1.25rem;
        margin-bottom: 1.5rem;
    }

    .invoice-title h2 {
        margin: 0;
        font-size: 1.6rem;
        font-weight: 800;
        letter-spacing: -0.03em;
    }

    .muted {
        color: #707887;
        font-size: .85rem;
        margin-top: 4px;
    }

    .emp-badge {
        padding: 6px 14px;
        border-radius: 999px;
        background: rgba(255,170,67,.1);
        border: 1px solid rgba(255,170,67,.2);
        color: #ffaa43;
        font-size: .75rem;
        font-weight: 700;
        letter-spacing: 0.04em;
    }

    .loading, .empty {
        text-align: center;
        color: #707887;
        padding: 3rem;
    }

    /* TABLE */
    .table-wrap {
        overflow-x: auto;
        margin-top: 1rem;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        background: #0f1117;
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 12px;
        overflow: hidden;
    }

    thead {
        background: #181c27;
    }

    th {
        padding: 14px 16px;
        text-align: left;
        font-size: .72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: #7e8796;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    td {
        padding: 14px 16px;
        font-size: .9rem;
        color: #c7cfdb;
        border-bottom: 1px solid rgba(255,255,255,0.04);
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    tbody tr:hover td {
        background: rgba(255,255,255,.02);
    }

    .total {
        color: #ffaa43;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
    }

    .link {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: #ffaa43;
        text-decoration: none;
        font-weight: 600;
        font-size: .85rem;
        transition: opacity .15s;
    }

    .link:hover {
        opacity: .75;
    }

    .id-cell {
        color: #707887;
        font-size: .82rem;
        font-variant-numeric: tabular-nums;
    }

    @@media print {
        body { background: white !important; color: black !important; }
        .employee-page { background: white !important; padding: 0; }
        table { border: none !important; }
        .link { display: none; }
    }
</style>

<div class="employee-page">
    <div class="container-max">

        @if (isLoading)
        {
            <div class="loading">Cargando...</div>
        }
        else if (empleado is null)
        {
            <div class="empty">Empleado no encontrado</div>
        }
        else
        {
            <div class="invoice">

                <div class="invoice-header">
                    <div class="invoice-title">
                        <h2>@empleado.Nombre @empleado.Apellido</h2>
                        <div class="muted">Historial de ventas del empleado</div>
                    </div>

                    <div class="emp-badge">ID: @empleado.Id</div>
                </div>

                @if (!Ventas.Any())
                {
                    <div class="empty">No hay ventas registradas</div>
                }
                else
                {
                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Fecha</th>
                                    <th>Total</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var v in Ventas)
                                {
                                    <tr>
                                        <td class="id-cell">#@v.Id</td>
                                        <td style="color:#707887;">@v.Fecha.ToString("dd MMM yyyy, hh:mm tt")</td>
                                        <td class="total">₡@v.Total.ToString("N2")</td>
                                        <td>
                                            <a class="link" href="/venta/@v.Id">
                                                Ver recibo →
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </div>
        }

    </div>
</div>

@code {

    [Parameter]
    public string id { get; set; } = string.Empty;

    private List<Venta> Ventas = new();
    private Pulperia.Models.Empleado? empleado;
    private bool isLoading = true;
    private PulperiaDbContext? db;

    protected override async Task OnInitializedAsync()
    {
        db = DbFactory.CreateDbContext();

        empleado = await emp.GetByIdAsync(id);

        if (empleado != null)
        {
            Ventas = await Task.Run(() =>
                db.Venta
                    .Include(v => v.DetalleVentas)
                    .ThenInclude(d => d.Producto)
                    .Where(v => v.ClienteId == empleado.Id.ToString())
                    .OrderByDescending(v => v.Fecha)
                    .ToList()
            );
        }

        isLoading = false;
    }
}
