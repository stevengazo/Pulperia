@page "/empleado/{id}"

@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop

@inject EmpleadoService emp
@inject IDbContextFactory<PulperiaDbContext> DbFactory
@inject IJSRuntime JS

<PageTitle>Empleado</PageTitle>

<style>
    .employee-page {
        min-height: 100vh;
        padding: 2rem;
        color: #f5f7fa;
        font-family: 'Inter', system-ui, sans-serif;
    }

    .container-max {
        max-width: 1200px;
        margin: auto;
    }

    .invoice {
        background: #181c27;
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 22px;
        padding: 2rem;
        box-shadow: 0 24px 60px rgba(0, 0, 0, .35);
    }

    .invoice-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        padding-bottom: 1.5rem;
        margin-bottom: 1.5rem;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .employee-info {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .employee-photo {
        width: 72px;
        height: 72px;
        border-radius: 20px;
        overflow: hidden;
        flex-shrink: 0;

        background: rgba(255, 170, 67, .08);
        border: 1px solid rgba(255, 170, 67, .18);

        display: flex;
        align-items: center;
        justify-content: center;
    }

    .employee-photo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .employee-photo i {
        font-size: 1.4rem;
        color: #ffaa43;
    }

    .invoice-title h2 {
        margin: 0;
        font-size: 1.7rem;
        font-weight: 800;
        letter-spacing: -0.03em;
    }

    .muted {
        color: #707887;
        font-size: .88rem;
        margin-top: 4px;
    }

    .emp-badge {
        padding: 8px 16px;
        border-radius: 999px;
        background: rgba(255, 170, 67, .1);
        border: 1px solid rgba(255, 170, 67, .2);
        color: #ffaa43;
        font-size: .75rem;
        font-weight: 700;
        letter-spacing: 0.04em;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem;
        margin-bottom: 1.8rem;
    }

    .stat-card {
        background: #0f1117;
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 16px;
        padding: 1rem;
    }

    .stat-label {
        color: #707887;
        font-size: .82rem;
        margin-bottom: .5rem;
    }

    .stat-value {
        color: #ffaa43;
        font-size: 1.5rem;
        font-weight: 800;
    }

    .filters {
        display: flex;
        gap: 1rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        align-items: end;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: .5rem;
    }

    .filter-group label {
        font-size: .82rem;
        color: #7e8796;
    }

    .filter-input {
        background: #0f1117;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        color: white;
        padding: 10px 14px;
        outline: none;
        min-width: 180px;
    }

    .filter-input:focus {
        border-color: rgba(255, 170, 67, .3);
        box-shadow: 0 0 0 3px rgba(255, 170, 67, .08);
    }

    .btn-export {
        background: #ffaa43;
        color: black;
        border: none;
        border-radius: 12px;
        padding: 11px 18px;
        font-weight: 700;
        cursor: pointer;
        transition: .15s;
        height: fit-content;
    }

    .btn-export:hover {
        opacity: .9;
    }

    .loading,
    .empty {
        text-align: center;
        color: #707887;
        padding: 3rem;
    }

    .table-wrap {
        overflow-x: auto;
        margin-top: 1rem;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        background: #0f1117;
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 12px;
        overflow: hidden;
    }

    thead {
        background: #181c27;
    }

    th {
        padding: 14px 16px;
        text-align: left;
        font-size: .72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: #7e8796;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    td {
        padding: 14px 16px;
        font-size: .9rem;
        color: #c7cfdb;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    tbody tr:hover td {
        background: rgba(255, 255, 255, .02);
    }

    .total {
        color: #ffaa43;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
    }

    .link {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: #ffaa43;
        text-decoration: none;
        font-weight: 600;
        font-size: .85rem;
    }

    .link:hover {
        opacity: .75;
    }

    .id-cell {
        color: #707887;
        font-size: .82rem;
        font-variant-numeric: tabular-nums;
    }

    @@media (max-width: 768px) {

        .employee-page {
            padding: 1rem;
        }

        .invoice {
            padding: 1.2rem;
        }

        .filters {
            flex-direction: column;
            align-items: stretch;
        }

        .filter-input {
            min-width: 100%;
        }

    }
</style>

  
<UserValidator>
    <div class="employee-page">

        <div class="container-max">

            @if (isLoading)
            {
                <div class="loading">
                    Cargando...
                </div>
            }
            else if (empleado is null)
            {
                <div class="empty">
                    Empleado no encontrado
                </div>
            }
            else
            {
                <div class="invoice">

                    <!-- HEADER -->
                    <div class="invoice-header">

                        <div class="employee-info">

                            <div class="employee-photo">

                                @if (!string.IsNullOrWhiteSpace(empleado.Photo))
                                {
                                    <img src="@empleado.Photo" alt="@empleado.Nombre" />
                                }
                                else
                                {
                                    <i class="fa-solid fa-user"></i>
                                }

                            </div>

                            <div class="invoice-title">
                                <h2>
                                    @empleado.Nombre @empleado.Apellido
                                </h2>

                                <div class="muted">
                                    Historial de ventas del empleado
                                </div>
                            </div>

                        </div>

                        <div class="emp-badge">
                            ID: @empleado.Id
                        </div>

                    </div>

                    <!-- STATS -->
                    <div class="stats-grid">

                        <div class="stat-card">
                            <div class="stat-label">
                                Ventas
                            </div>

                            <div class="stat-value">
                                @FilteredVentas.Count
                            </div>
                        </div>

                        <div class="stat-card">
                            <div class="stat-label">
                                Total Vendido
                            </div>

                            <div class="stat-value">
                             @SumVentas(FilteredVentas)
                            </div>
                        </div>

                    </div>

                    <!-- FILTERS -->
                    <div class="filters">

                        <DateRangePicker OnRangeChanged="OnRangeChanged" />

                        <button class="btn-export" @onclick="ExportCsv">
                            <i class="fa-solid fa-file-csv"></i>
                        </button>

                    </div>

                    @if (!FilteredVentas.Any())
                    {
                        <div class="empty">
                            No hay ventas registradas
                        </div>
                    }
                    else
                    {
                        <div class="table-wrap">

                            <table>

                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Fecha</th>
                                        <th>Total</th>
                                        <th>Acción</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var v in FilteredVentas)
                                    {
                                        <tr>

                                            <td class="id-cell">
                                                #@v.Id
                                            </td>

                                            <td style="color:#707887;">
                                                @v.Fecha.ToString("dd MMM yyyy, hh:mm tt")
                                            </td>

                                            <td class="total">
                                                ₡@v.Total.ToString("N2")
                                            </td>

                                            <td>
                                                <GenerarTicket Venta="v" Empleado="empleado" />
                                                <a class="link" href="/venta/@v.Id">

                                                    Ver recibo →

                                                </a>
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }

                </div>
            }

        </div>

    </div>

</UserValidator>


@code {

    [Parameter]
    public string id { get; set; } = string.Empty;

    private List<Venta> Ventas = new();

    private Pulperia.Models.Empleado? empleado;

    private bool isLoading = true;

    private PulperiaDbContext? db;

    private DateTime? fechaInicio = null;
    private DateTime? fechaFin = null;

    private void OnRangeChanged((DateTime Inicio, DateTime Fin) rango)
    {
        fechaInicio = rango.Inicio;
        fechaFin = rango.Fin;
    }

    private List<Venta> FilteredVentas =>
        Ventas
            .Where(v =>
                (!fechaInicio.HasValue || v.Fecha.Date >= fechaInicio.Value.Date) &&
                (!fechaFin.HasValue || v.Fecha.Date <= fechaFin.Value.Date)
            )
            .OrderByDescending(v => v.Fecha)
            .ToList();

    private string SumVentas(List<Pulperia.Models.Venta> ventas)
    {
        var total = ventas.Sum(v => v.Total);
        return $"₡{total:N2}";
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            db = DbFactory.CreateDbContext();

            empleado = await emp.GetByIdAsync(id);

            if (empleado != null)
            {
                Ventas = await db.Venta
                    .Include(v => v.DetalleVentas)
                        .ThenInclude(d => d.Producto)
                    .Where(v => v.ClienteId == empleado.Id.ToString())
                    .OrderByDescending(v => v.Fecha)
                    .ToListAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando ventas: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ExportCsv()
    {
        try
        {
            var sb = new System.Text.StringBuilder();

            sb.AppendLine("Id,Fecha,Total");

            foreach (var venta in FilteredVentas)
            {
                sb.AppendLine(
                    $"{venta.Id},{venta.Fecha:yyyy-MM-dd HH:mm},{venta.Total}"
                );
            }

            var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());

            var base64 = Convert.ToBase64String(bytes);

            await JS.InvokeVoidAsync(
                "downloadBase64File",
                base64,
                $"ventas-empleado-{empleado?.Id}.csv",
                "text/csv"
            );
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error exportando CSV: {ex.Message}");
        }
    }

    public void Dispose()
    {
        db?.Dispose();
    }
}