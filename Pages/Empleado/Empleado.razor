@page "/empleado/{id}"

@inject EmpleadoService emp
@inject IDbContextFactory<PulperiaDbContext> DbFactory

<PageTitle>Empleado</PageTitle>

<style>
    .employee-page {
        min-height: 100vh;
        background: #0b0d11;
        padding: 2rem;
        color: #f5f7fa;
        font-family: 'Inter', system-ui, sans-serif;
    }

    .container-max {
        max-width: 1000px;
        margin: auto;
    }

    .invoice {
        background: #11151b;
        border: 1px solid #1b1f27;
        border-radius: 18px;
        padding: 2rem;
        box-shadow: 0 24px 60px rgba(0,0,0,.35);
    }

    .invoice-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        border-bottom: 1px solid #1b1f27;
        padding-bottom: 1rem;
        margin-bottom: 1.5rem;
    }

    .invoice-title h2 {
        margin: 0;
        font-size: 1.6rem;
    }

    .muted {
        color: #707887;
        font-size: .85rem;
    }

    .badge {
        padding: 6px 12px;
        border-radius: 999px;
        background: rgba(124,107,255,.12);
        border: 1px solid rgba(124,107,255,.18);
        color: #c9c3ff;
        font-size: .75rem;
    }

    .loading, .empty {
        text-align: center;
        color: #707887;
        padding: 3rem;
    }

    /* TABLE */
    .table-wrap {
        overflow-x: auto;
        margin-top: 1rem;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        background: #0f1318;
        border: 1px solid #1b1f27;
        border-radius: 12px;
        overflow: hidden;
    }

    thead {
        background: #11151b;
        color: #cbd5e1;
    }

    th, td {
        padding: 12px;
        text-align: left;
        font-size: .9rem;
    }

    tbody tr {
        border-top: 1px solid #1b1f27;
        color: #f5f7fa;
    }

    tbody tr:hover {
        background: rgba(124,107,255,.05);
    }

    .total {
        color: #7c6bff;
        font-weight: 700;
    }

    .link {
        color: #7c6bff;
        text-decoration: none;
        font-weight: 600;
    }

    .link:hover {
        text-decoration: underline;
    }

    @@media print {
        body {
            background: white !important;
            color: black !important;
        }

        .employee-page {
            background: white !important;
            padding: 0;
        }

        table {
            border: none !important;
        }

        .link {
            display: none;
        }
    }
</style>

<div class="employee-page">
    <div class="container-max">

        @if (isLoading)
        {
            <div class="loading">Cargando...</div>
        }
        else if (empleado is null)
        {
            <div class="empty">Empleado no encontrado</div>
        }
        else
        {
            <!-- HEADER -->
            <div class="invoice">

                <div class="invoice-header">
                    <div class="invoice-title">
                        <h2>@empleado.Nombre @empleado.Apellido</h2>
                        <div class="muted">Historial de ventas del empleado</div>
                    </div>

                    <div class="badge">
                        ID: @empleado.Id
                    </div>
                </div>

                <!-- TABLE -->
                @if (!Ventas.Any())
                {
                    <div class="empty">No hay ventas registradas</div>
                }
                else
                {
                    <div class="table-wrap">

                        <table>

                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Fecha</th>
                                    <th>Total</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var v in Ventas)
                                {
                                    <tr>
                                        <td>#@v.Id</td>
                                        <td style="color:#707887;">@v.Fecha</td>
                                        <td class="total">₡@v.Total</td>
                                        <td>
                                            <a class="link" href="/venta/@v.Id">
                                                Ver recibo →
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>

                    </div>
                }

            </div>
        }

    </div>
</div>

@code {

    [Parameter]
    public string id { get; set; } = string.Empty;

    private List<Venta> Ventas = new();
    private Pulperia.Models.Empleado? empleado;
    private bool isLoading = true;
    private PulperiaDbContext? db;

    protected override async Task OnInitializedAsync()
    {
        db = DbFactory.CreateDbContext();

        empleado = await emp.GetByIdAsync(id);

        if (empleado != null)
        {
            Ventas = await Task.Run(() =>
                db.Venta
                    .Include(v => v.DetalleVentas)
                    .ThenInclude(d => d.Producto)
                    .Where(v => v.ClienteId == empleado.Id.ToString())
                    .OrderByDescending(v => v.Fecha)
                    .ToList()
            );
        }

        isLoading = false;
    }
}