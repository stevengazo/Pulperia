@page "/inventario"
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<PulperiaDbContext> DbFactory
@inject NavigationManager Nav

<AddCompraInventario @ref="modalCompra" OnSaved="ActualizarDatos" />

<div class="container-fluid py-4 bg-dark min-vh-100">

    @* Cabecera *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-white fw-bold mb-0">📦 Control de Inventario</h2>
            <p class="text-white-50 small mb-0">
                Gestione sus productos y niveles de existencias
            </p>
        </div>

        <button class="btn btn-primary d-flex align-items-center gap-2 shadow"
                @onclick="AbrirModalNuevo">

            <i class="bi bi-plus-lg"></i>
            Registrar Compra
        </button>
    </div>

    @* Tarjetas *@
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card bg-dark text-white border-secondary h-100 shadow-sm">

                <div class="card-body d-flex align-items-center gap-3">

                    <div class="stats-icon bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-box-seam fs-3"></i>
                    </div>

                    <div>
                        <h6 class="text-white-50 small mb-0">
                            Total Productos
                        </h6>

                        <h3 class="mb-0 fw-bold">
                            @detalleCompras.Count
                        </h3>
                    </div>

                </div>

            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-dark text-white border-warning border-opacity-25 h-100 shadow-sm">

                <div class="card-body d-flex align-items-center gap-3">

                    <div class="stats-icon bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-exclamation-triangle fs-3"></i>
                    </div>

                    <div>
                        <h6 class="text-white-50 small mb-0">
                            Stock Bajo
                        </h6>

                        <h3 class="mb-0 fw-bold text-warning">
                            @detalleCompras.Count(x => x.Producto.StockActual <= x.Producto.StockMinimo && x.Producto.StockActual > 0)
                        </h3>
                    </div>

                </div>

            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-dark text-white border-danger border-opacity-25 h-100 shadow-sm">

                <div class="card-body d-flex align-items-center gap-3">

                    <div class="stats-icon bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-x-octagon fs-3"></i>
                    </div>

                    <div>
                        <h6 class="text-white-50 small mb-0">
                            Agotados
                        </h6>

                        <h3 class="mb-0 fw-bold text-danger">
                            @detalleCompras.Count(x => x.Producto.StockActual <= 0)
                        </h3>
                    </div>

                </div>

            </div>
        </div>

    </div>

    @* Tabla *@
    <div class="card bg-dark text-white border-secondary shadow">

        <div class="card-header border-secondary bg-transparent py-3">

            <div class="row g-2">

                <div class="col-md-8">

                    <div class="input-group">

                        <span class="input-group-text bg-dark border-secondary text-white-50">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               class="form-control bg-dark text-white border-secondary"
                               placeholder="Buscar por nombre, SKU o proveedor..."
                               @bind="filtro"
                               @bind:event="oninput" />

                    </div>

                </div>

                <div class="col-md-4">

                    <select class="form-select bg-dark text-white border-secondary">

                        <option value="">Todas las categorías</option>
                        <option value="Abarrotes">Abarrotes</option>
                        <option value="Lacteos">Lácteos</option>
                        <option value="Bebidas">Bebidas</option>

                    </select>

                </div>

            </div>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-dark table-hover align-middle mb-0">

                    <thead class="text-white-50 small border-secondary">

                        <tr>
                            <th class="ps-4">Proveedor</th>
                            <th>Fecha</th>
                            <th>Producto</th>
                            <th class="text-center">Cantidad</th>
                            <th class="text-end">Costo</th>
                            <th class="text-end">Venta</th>
                            <th class="text-center pe-4">Estado</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach(var i in detalleCompras.Where(x =>
                       string.IsNullOrWhiteSpace(filtro)
                       || x.Producto.Nombre.Contains(filtro, StringComparison.OrdinalIgnoreCase)
                       || x.CompraInventario.Proveedor.Nombre.Contains(filtro, StringComparison.OrdinalIgnoreCase)
                       || x.Producto.Id.ToString().Contains(filtro)
                       ))
                        {
                            <tr>

                                <td class="ps-4 fw-semibold text-info">
                                    @i.CompraInventario.Proveedor.Nombre
                                </td>

                                <td class="text-white-50">
                                    @i.CompraInventario.Fecha.ToString("dd/MM/yyyy")
                                </td>

                                <td>

                                    <div class="fw-semibold text-white">
                                        @i.Producto.Nombre
                                    </div>

                                    <small class="text-white-50">
                                        SKU: @i.Producto.Id
                                    </small>

                                </td>

                                <td class="text-center fw-semibold">
                                    @i.Cantidad
                                </td>

                                <td class="text-end text-warning fw-semibold">
                                    ₡@i.PrecioUnitario.ToString("N2")
                                </td>

                                <td class="text-end text-success fw-bold">
                                    ₡@i.Producto.PrecioVenta.ToString("N2")
                                </td>

                                <td class="text-center pe-4">

                                    @if(i.Producto.StockActual <= 0)
                                    {
                                        <span class="badge bg-danger">
                                            Agotado
                                        </span>
                                    }
                                    else if(i.Producto.StockActual <= i.Producto.StockMinimo)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Bajo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            Disponible
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<style>

    .stats-icon {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
    }

    .card {
        border-radius: 18px;
        overflow: hidden;
    }

    .table {
        margin-bottom: 0;
    }

    .table thead th {
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .6px;
        font-size: .75rem;
        color: rgba(255,255,255,.65);
        border-top: none;
        border-bottom: 1px solid rgba(255,255,255,.08);
        background: rgba(255,255,255,.02);
        padding-top: 16px;
        padding-bottom: 16px;
    }

    .table tbody tr {
        border-color: rgba(255,255,255,.05);
        transition: all .15s ease-in-out;
    }

    .table tbody tr:hover {
        background: rgba(255,255,255,.03);
    }

    .table tbody td {
        padding-top: 16px;
        padding-bottom: 16px;
        vertical-align: middle;
    }

    .form-control,
    .form-select,
    .input-group-text {
        min-height: 46px;
    }

    .form-control:focus,
    .form-select:focus {
        box-shadow: none;
        border-color: #0d6efd;
    }

    .btn {
        border-radius: 12px;
    }

    .badge {
        padding: 8px 12px;
        font-size: .72rem;
        font-weight: 600;
        border-radius: 10px;
    }

</style>

@code {

    private string filtro = "";

    // Referencia al componente modal
    private AddCompraInventario modalCompra;

    private PulperiaDbContext db;
    private List<DetalleCompra> detalleCompras = new();

    protected override async Task OnInitializedAsync()
    {
        db = DbFactory.CreateDbContext();
        try
        {
            detalleCompras = await db.DetalleCompra
                .Include(e => e.Producto)
                .Include(e => e.CompraInventario)
                .ThenInclude(e => e.Proveedor)
                .ToListAsync();
        }
        catch(Exception f)
        {
            Console.WriteLine(f.Message);
        }
    }

    private void AbrirModalNuevo()
    {
        modalCompra.Show();
    }

    private async Task ActualizarDatos()
    {
        detalleCompras = await db.DetalleCompra
            .Include(e => e.Producto)
            .Include(e => e.CompraInventario)
            .ThenInclude(e => e.Proveedor)
            .ToListAsync();

        StateHasChanged();
    }

}