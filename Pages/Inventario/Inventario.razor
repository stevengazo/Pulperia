@page "/inventario"
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<PulperiaDbContext> DbFactory
@inject NavigationManager Nav


<UserValidator>
    <AddCompraInventario @ref="modalCompra" OnSaved="ActualizarDatos" />



    <div class="inv-root">

        <div class="inv-head">
            <div>
                <h2>Control de Inventario</h2>
                <p>Gestione sus productos y niveles de existencias</p>
            </div>
            <button class="btn-compra" @onclick="AbrirModalNuevo">
                <i class="bi bi-plus-lg"></i>
                Registrar Compra
            </button>
        </div>

        <div class="stats-grid">

            <div class="stat-card">
                <div class="stat-icon icon-orange">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <div class="stat-label">Total Registros</div>
                    <div class="stat-value">@detalleCompras.Count</div>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon icon-yellow">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
                <div>
                    <div class="stat-label">Stock Bajo</div>
                    <div class="stat-value yellow">
                        @detalleCompras.Count(x => x.Producto.StockActual <= x.Producto.StockMinimo &&
                            x.Producto.StockActual > 0)
                    </div>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon icon-red">
                    <i class="bi bi-x-octagon"></i>
                </div>
                <div>
                    <div class="stat-label">Agotados</div>
                    <div class="stat-value red">
                        @detalleCompras.Count(x => x.Producto.StockActual <= 0)
                    </div>
                </div>
            </div>

        </div>

        <div class="inv-card">

            <div class="inv-toolbar">
                <div class="search-wrap">
                    <i class="bi bi-search search-icon"></i>
                    <input class="inv-input" placeholder="Buscar por nombre, SKU o proveedor..." @bind="filtro"
                           @bind:event="oninput" />
                </div>

                <select class="inv-input">
                    <option value="">Todas las categorías</option>
                    <option value="Abarrotes">Abarrotes</option>
                    <option value="Lacteos">Lácteos</option>
                    <option value="Bebidas">Bebidas</option>
                </select>
            </div>

            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>Proveedor</th>
                            <th>Fecha</th>
                            <th>Producto</th>
                            <th class="c">Cantidad</th>
                            <th class="r">Costo Unit.</th>
                            <th class="r">Precio Venta</th>
                            <th class="c">Ganancia</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in detalleCompras.Where(x =>
                            string.IsNullOrWhiteSpace(filtro)
                            || x.Producto.Nombre.Contains(filtro, StringComparison.OrdinalIgnoreCase)
                            || x.CompraInventario.Proveedor.Nombre.Contains(filtro, StringComparison.OrdinalIgnoreCase)
                            || x.Producto.Id.ToString().Contains(filtro)))
                        {
                            var ganancia = i.Producto.PrecioVenta - i.PrecioUnitario;

                            <tr>
                                <td class="td-proveedor">
                                    @i.CompraInventario?.Proveedor?.Nombre
                                </td>

                                <td class="td-fecha">
                                    @i.CompraInventario.Fecha.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    <div class="td-nombre">@i.Producto.Nombre</div>
                                    <div class="td-sku">SKU: @i.Producto.Id</div>
                                </td>

                                <td class="td-ctr">@i.Cantidad</td>

                                <td class="td-r costo">₡@i.PrecioUnitario.ToString("N2")</td>

                                <td class="td-r venta">₡@i.Producto.PrecioVenta.ToString("N2")</td>

                                <td class="ganancia @(ganancia < 0 ? "neg" : "")">
                                    ₡@ganancia.ToString("N2")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>

    </div>
</UserValidator>



@code {

    private string filtro = "";
    private AddCompraInventario modalCompra;
    private PulperiaDbContext db;
    private List<DetalleCompra> detalleCompras = new();

    protected override async Task OnInitializedAsync()
    {
        db = DbFactory.CreateDbContext();
        try
        {
            detalleCompras = await db.DetalleCompra
                .Include(e => e.Producto)
                .Include(e => e.CompraInventario)
                .ThenInclude(e => e.Proveedor)
                .ToListAsync();
        }
        catch (Exception f)
        {
            Console.WriteLine(f.Message);
        }
    }

    private void AbrirModalNuevo() => modalCompra.Show();

    private async Task ActualizarDatos()
    {
        detalleCompras = await db.DetalleCompra
            .Include(e => e.Producto)
            .Include(e => e.CompraInventario)
            .ThenInclude(e => e.Proveedor)
            .ToListAsync();

        StateHasChanged();
    }
}
