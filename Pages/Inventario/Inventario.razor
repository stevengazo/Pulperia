@page "/inventario"
@using Pulperia.Components.CompraInventario
@inject NavigationManager Nav

@* 1. Agregamos la referencia al componente modal y el evento de refresco *@
<AddCompraInventario @ref="modalCompra" OnSaved="ActualizarDatos" />

<div class="container-fluid py-4 bg-dark min-vh-100">

    @* Cabecera *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-white fw-bold mb-0">📦 Control de Inventario</h2>
            <p class="text-white-50 small mb-0">Gestione sus productos y niveles de existencias</p>
        </div>
        @* 2. El botón ahora llama a AbrirModalNuevo *@
        <button class="btn btn-primary d-flex align-items-center gap-2 shadow" @onclick="AbrirModalNuevo">
            <i class="bi bi-plus-lg"></i> Registrar Compra
        </button>
    </div>

    @* Tarjetas de Estado *@
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card bg-dark text-white border-secondary h-100 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stats-icon bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-box-seam fs-3"></i>
                    </div>
                    <div>
                        <h6 class="text-white-50 small mb-0">Total Productos</h6>
                        <h3 class="mb-0 fw-bold">154</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-dark text-white border-warning border-opacity-25 h-100 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stats-icon bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-exclamation-triangle fs-3"></i>
                    </div>
                    <div>
                        <h6 class="text-white-50 small mb-0">Stock Bajo</h6>
                        <h3 class="mb-0 fw-bold text-warning">12</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-dark text-white border-danger border-opacity-25 h-100 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stats-icon bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-x-octagon fs-3"></i>
                    </div>
                    <div>
                        <h6 class="text-white-50 small mb-0">Agotados</h6>
                        <h3 class="mb-0 fw-bold text-danger">3</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Filtros y Tabla *@
    <div class="card bg-dark text-white border-secondary shadow">
        <div class="card-header border-secondary bg-transparent py-3">
            <div class="row g-2">
                <div class="col-md-8">
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-secondary text-white-50"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control bg-dark text-white border-secondary" 
                               placeholder="Buscar por nombre, SKU o categoría..." @bind="filtro" @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-4">
                    <select class="form-select bg-dark text-white border-secondary">
                        <option value="">Todas las categorías</option>
                        <option value="Abarrotes">Abarrotes</option>
                        <option value="Lacteos">Lácteos</option>
                        <option value="Bebidas">Bebidas</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="text-white-50 small border-secondary">
                        <tr>
                            <th class="ps-4">SKU</th>
                            <th>Producto</th>
                            <th>Categoría</th>
                            <th class="text-end">Precio Venta</th>
                            <th class="text-center">Stock</th>
                            <th class="text-center pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* Aquí iría el renderizado de tus productos *@
                        <tr>
                            <td class="ps-4 text-white-50">PROD-001</td>
                            <td class="fw-bold">Leche Entera 1L</td>
                            <td><span class="badge bg-secondary">Lácteos</span></td>
                            <td class="text-end">₡950.00</td>
                            <td class="text-center"><span class="badge bg-success">45</span></td>
                            <td class="text-center pe-4">
                                <button class="btn btn-sm btn-outline-light"><i class="bi bi-pencil"></i></button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .stats-icon {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
    }

    .table thead th {
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-top: none;
        background-color: rgba(0,0,0,0.2);
    }

    .table tbody tr {
        border-color: rgba(255,255,255,0.05);
    }

    .btn-group .btn:hover {
        background-color: rgba(255,255,255,0.1);
    }
</style>

@code {
    private string filtro = "";
    
    // Referencia al componente modal
    private AddCompraInventario modalCompra;

    private void AbrirModalNuevo() 
    {
        // 3. Llamamos al método Show() del componente hijo
        modalCompra.Show();
    }

    private async Task ActualizarDatos()
    {
        // 4. Esta lógica se ejecuta cuando el modal guarda con éxito
        // Aquí deberías volver a cargar la lista de productos de la DB
        Console.WriteLine("La compra se guardó, refrescando inventario...");
        StateHasChanged();
    }
}