@page "/login"

@inject AppSessionService Session
@inject NavigationManager NavigationManager

<div class="login">

    <div class="card">

        <div class="title">Pulpería</div>

        <div class="subtitle">
            Accede al sistema administrativo
        </div>

        <div class="input-group">
            <label class="label">Correo electrónico</label>
            <input @bind="email" placeholder="correo@empresa.com" />
        </div>

        <div class="input-group">
            <label class="label">Contraseña</label>
            <input @bind="password"
                   type="password"
                   placeholder="••••••••" />
        </div>

        <label class="remember">
            <input type="checkbox" @bind="keepLoggedIn" />
            Mantener la sesión abierta
        </label>

        <button @onclick="Login" disabled="@isLoading">
            @(isLoading ? "Ingresando..." : "Ingresar al sistema")
        </button>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="error">@error</div>
        }

        <div class="footer">
            Sistema de gestión
        </div>

    </div>

</div>

@code {

    string email = "";
    string password = "";
    string? error;
    bool isLoading;
    bool keepLoggedIn;

    private async Task Login()
    {
        error = null;

        if (string.IsNullOrWhiteSpace(email) ||
            string.IsNullOrWhiteSpace(password))
        {
            error = "Email y contraseña son obligatorios";
            return;
        }

        isLoading = true;

        try
        {
            var ok = await Session.LoginAsync(email, password, keepLoggedIn);

            if (ok)
            {
                NavigationManager.NavigateTo("/", true);
            }
            else
            {
                error = "Credenciales inválidas";
            }
        }
        catch
        {
            error = "No se pudo conectar con el servidor. Intenta de nuevo.";
        }
        finally
        {
            isLoading = false;
        }
    }
}