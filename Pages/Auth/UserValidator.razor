@inject IDbContextFactory<PulperiaDbContext> DbContextFactory
@inject AppSessionService Session

@if (!Session.IsInitialized)
{
    <div class="auth-loading">
        <div class="spinner"></div>
        <p>Verificando sesión...</p>
    </div>
}
else if (Session.CurrentUser == null)
{
    <div class="auth-required">
        <h3>Sesión requerida</h3>

        <p>
            Debes iniciar sesión para acceder a este contenido.
        </p>

        <a href="/login" class="login-btn">
            Ir a login
        </a>
    </div>
}
else
{
    @ChildContent
}

@code {

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
     protected override async Task OnInitializedAsync()
    {
        await Session.TryRestoreSessionAsync();
    }

    protected override void OnParametersSet()
    {
        ValidateProps();
    }

    private void ValidateProps()
    {
        if (ChildContent is null)
        {
            throw new ArgumentException(
                "Este componente requiere ChildContent."
            );
        }

        if (DbContextFactory == null)
        {
            throw new Exception(
                "DbContextFactory no fue inyectado correctamente."
            );
        }

        if (Session == null)
        {
            throw new Exception(
                "AppSessionService no fue inyectado correctamente."
            );
        }
    }
}