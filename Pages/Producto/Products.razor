@page "/productos"

@inject NavigationManager Nav

<div class="container-fluid py-4">

    <!-- MODAL COMPONENT -->
    <AddProduct @ref="addProductModal" OnSaved="RecargarProductos" />

    <!-- CABECERA -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-white fw-bold mb-0">🍎 Catálogo de Productos</h2>
            <p class="text-white-50 small mb-0">Administre los precios y detalles de sus artículos</p>
        </div>

        <button class="btn btn-primary d-flex align-items-center gap-2 shadow"
                @onclick="AbrirModal">
            <i class="bi bi-plus-circle"></i> Nuevo Producto
        </button>
    </div>

    <!-- BARRA DE HERRAMIENTAS -->
    <div class="card bg-dark border-secondary mb-4 shadow-sm">
        <div class="card-body p-3">
            <div class="row g-3">

                <div class="col-md-6">
                    <input class="form-control bg-dark text-white border-secondary"
                           placeholder="Buscar producto..."
                           @bind="filtro" @bind:event="oninput" />
                </div>

                <div class="col-md-3">
                    <select class="form-select bg-dark text-white border-secondary">
                        <option value="">Todas las categorías</option>
                    </select>
                </div>

            </div>
        </div>
    </div>

    <!-- TABLA -->
    <div class="card bg-dark text-white border-secondary shadow">
        <div class="card-body p-0">

            <table class="table table-dark table-hover align-middle mb-0">
                <thead class="text-white-50 small border-bottom border-secondary">
                    <tr>
                        <th class="ps-4">Código</th>
                        <th>Descripción</th>
                        <th>Categoría</th>
                        <th class="text-end">Costo</th>
                        <th class="text-end">Venta</th>
                        <th class="text-center">Stock</th>
                        <th class="text-center pe-4">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    <!-- aquí tus productos -->
                </tbody>

            </table>

        </div>
    </div>

</div>

@code {
    private string filtro = "";

    private AddProduct addProductModal;

    private void AbrirModal()
    {
        addProductModal.Show();
    }

    private void RecargarProductos()
    {
        // aquí luego recargas lista desde DB
    }
}