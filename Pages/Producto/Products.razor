@page "/productos"
@using Microsoft.EntityFrameworkCore
@inject PulperiaDbContext db
@inject NavigationManager Nav

<style>
    .pg-root {

        min-height: 100vh;
        padding: 2rem 2.5rem;
        font-family: 'DM Sans', system-ui, sans-serif;
    }

    .pg-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        margin-bottom: 2rem;
    }

    .pg-head h1 {
        font-size: 20px;
        font-weight: 600;
        color: #e2e2e6;
        margin: 0 0 2px;
        letter-spacing: -0.01em;
    }

    .pg-head p {
        font-size: 12px;
        color: #45454f;
        margin: 0;
        letter-spacing: 0.02em;
    }

    .btn-new {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: #7c6bff;
        color: #fff;
        font-size: 12px;
        font-weight: 500;
        padding: 8px 16px;
        border-radius: 7px;
        border: none;
        cursor: pointer;
        letter-spacing: 0.02em;
        transition: opacity 0.15s;
    }

    .btn-new:hover { opacity: 0.85; }

    .pg-toolbar {
        display: grid;
        grid-template-columns: 1fr 200px;
        gap: 10px;
        margin-bottom: 1.25rem;
    }

    .pg-input {
        background: #111114;
        border: 0.5px solid #1e1e23;
        border-radius: 7px;
        color: #e2e2e6;
        font-size: 13px;
        padding: 9px 14px;
        outline: none;
        transition: border-color 0.15s;
        width: 100%;
        box-sizing: border-box;
    }

    .pg-input:focus { border-color: #2e2e38; }
    .pg-input::placeholder { color: #35353f; }

    .pg-table-wrap {
        background: #0e0e11;
        border: 0.5px solid #1a1a1f;
        border-radius: 10px;
        overflow: hidden;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    thead tr {
        border-bottom: 0.5px solid #1a1a1f;
    }

    thead th {
        padding: 11px 16px;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: #3a3a46;
        text-align: left;
        white-space: nowrap;
    }

    thead th.num { text-align: right; }
    thead th.ctr { text-align: center; }

    tbody tr {
        border-bottom: 0.5px solid #131316;
        transition: background 0.1s;
    }

    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background: #111115; }

    tbody td {
        padding: 12px 16px;
        color: #b0b0be;
    }

    .td-name {
        color: #e2e2e6;
        font-weight: 500;
    }

    .td-pres {
        color: #55555f;
        font-size: 11px;
    }

    .td-badge {
        display: inline-block;
        background: #16161a;
        border: 0.5px solid #222228;
        border-radius: 4px;
        padding: 3px 8px;
        font-size: 11px;
        color: #60606c;
    }

    .td-num {
        text-align: right;
        font-variant-numeric: tabular-nums;
        font-size: 12px;
    }

    .td-ctr { text-align: center; }

    .stock-ok {
        color: #4caf88;
        font-weight: 500;
    }

    .stock-low {
        color: #e2734a;
        font-weight: 500;
    }

    .stock-dot {
        display: inline-block;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        margin-right: 6px;
        vertical-align: middle;
    }

    .dot-ok { background: #4caf88; }
    .dot-low { background: #e2734a; }

    .actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

    .btn-icon {
        background: none;
        border: 0.5px solid #1e1e23;
        border-radius: 5px;
        color: #45454f;
        cursor: pointer;
        width: 28px;
        height: 28px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        transition: border-color 0.15s, color 0.15s;
    }

    .btn-icon:hover {
        border-color: #7c6bff;
        color: #7c6bff;
    }

    .pg-empty {
        text-align: center;
        padding: 3rem;
        color: #2e2e38;
        font-size: 13px;
    }

    .pg-count {
        font-size: 11px;
        color: #2e2e38;
        padding: 10px 16px;
        border-top: 0.5px solid #1a1a1f;
        letter-spacing: 0.03em;
    }
</style>

<div class="pg-root">

    <AddProduct @ref="addProductModal" OnSaved="RecargarProductos" />

    <div class="pg-head">
        <div>
            <h1>Catálogo de productos</h1>
            <p>@productosFiltrados.Count resultado@(productosFiltrados.Count != 1 ? "s" : "")</p>
        </div>
        <button class="btn-new" @onclick="AbrirModal">
            <i class="bi bi-plus-lg"></i> Nuevo producto
        </button>
    </div>

    <div class="pg-toolbar">
        <input class="pg-input" placeholder="Buscar por nombre o presentación..."
               @bind="filtro" @bind:event="oninput" />
        <select class="pg-input" @bind="categoriaFiltro">
            <option value="">Todas las categorías</option>
            @foreach (var c in Categorias)
            {
                <option value="@c.Id">@c.Nombre</option>
            }
        </select>
    </div>

    <div class="pg-table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Categoría</th>
                    <th class="num">Unidades Compradas</th>
                    <th class="num">Costo Total</th>
                    <th class="num">Unidades Vendidas</th>
                    <th class="num">Ventas Total</th>
                    <th class="ctr">Stock</th>
                    <th class="ctr">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!productosFiltrados.Any())
                {
                    <tr>
                        <td colspan="6" class="pg-empty">Sin resultados</td>
                    </tr>
                }
                @foreach (var p in productosFiltrados)
                {
                    <tr>
                        <td>
                            <div class="td-name">@p.Nombre</div>
                            <div class="td-pres">@p.Presentacion</div>
                        </td>
                        <td>
                            <span class="td-badge">@p.Categoria?.Nombre</span>
                        </td>
                        <td class="td-ctr">
                            @p.DetalleCompras.Sum(d=>d.Cantidad).ToString()
                        </td>
                        <td class="td-num">
                            ₡@GetCompraCosto(p.DetalleCompras.ToList())
                        </td>
                        <td class="td-ctr">
                            @p.DetalleVentas.Sum(d=>d.Cantidad).ToString()
                        </td>
                        <td class="td-num">
                            ₡@GetVentas(p.DetalleVentas.ToList())
                        </td>


         
                        <td class="td-ctr">
                            <span class="@(p.StockActual <= p.StockMinimo ? "stock-low" : "stock-ok")">
                                <span class="stock-dot @(p.StockActual <= p.StockMinimo ? "dot-low" : "dot-ok")"></span>
                                @p.StockActual
                            </span>
                        </td>
                        <td class="td-ctr">
                            <div class="actions">
                                <button class="btn-icon" title="Editar" >
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                                <button class="btn-icon" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>                  
                }
            </tbody>
        </table>
        <div class="pg-count">Mostrando @productosFiltrados.Count de @productos.Count productos</div>
    </div>
</div>

@code {
    private string filtro = "";
    private string _categoriaFiltro = "";
    private string categoriaFiltro 
    { 
        get => _categoriaFiltro; 
        set { _categoriaFiltro = value; InvokeAsync(StateHasChanged); } 
    }

    private AddProduct addProductModal;
    private List<Producto> productos = new();
    private List<Categoria> Categorias = new();

    private List<Producto> productosFiltrados => productos
        .Where(p =>
            (string.IsNullOrEmpty(filtro) ||
             p.Nombre.Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
             (p.Presentacion ?? "").Contains(filtro, StringComparison.OrdinalIgnoreCase))
            &&
            (string.IsNullOrEmpty(categoriaFiltro) ||
             p.CategoriaId.ToString() == categoriaFiltro)
        ).ToList();

    // Métodos de cálculo corregidos para devolver string formateado o decimal
    private string GetVentas(List<DetalleVenta> ventas)
    {
        return ventas.Sum(v => v.Cantidad * v.PrecioUnitarioHistorico).ToString("N2");
    }

    private string GetCompraCosto(List<DetalleCompra> detalles)
    {
        return detalles.Sum(d => d.Cantidad * d.PrecioUnitario).ToString("N2");
    }

    protected override void OnInitialized() => CargarDatos();

    private void CargarDatos()
    {
        productos = db.Producto
            .Include(e => e.Categoria)
            .Include(e => e.DetalleVentas)
            .Include(e => e.DetalleCompras)
            .AsNoTracking() // Mejora rendimiento para listas
            .ToList();
        Categorias = db.Categoria.ToList();
    }

    private void AbrirModal() => addProductModal.Show();

    private void RecargarProductos() => CargarDatos();

    private async Task Eliminar(int id)
    {
        // En un sistema real, mejor usar un Modal de confirmación
        var p = await db.Producto.FindAsync(id);
        if (p is not null)
        {
            db.Producto.Remove(p);
            await db.SaveChangesAsync();
            CargarDatos();
        }
    }
}