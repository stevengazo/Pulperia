@page "/producto/edit/{id:int}"

@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@inject LogService LogService
@inject IDbContextFactory<PulperiaDbContext> dbContextFactory
@inject AppSessionService Session
@inject NavigationManager Nav

<PageTitle>Editar Producto</PageTitle>

@if (isLoading)
{
    <div class="loading-container">
        <div class="loading-card">
            Cargando producto...
        </div>
    </div>
}
else if (producto is null)
{
    <div class="loading-container">
        <div class="loading-card">
            Producto no encontrado
        </div>
    </div>
}
else
{
    <div class="page-wrapper">

        <div class="form-container">

            <div class="header">

                <div>
                    <h2>Editar Producto</h2>
                    <p>
                        Actualiza la información general del producto
                    </p>
                </div>

                <a href="/productos" class="back-btn">
                    Volver
                </a>

            </div>

            <!-- WARNING -->
            <div class="warning-box">

                <div class="warning-icon">
                    ⚠
                </div>

                <div class="warning-content">

                    <h4>Advertencia de Inventario y Auditoría</h4>

                    <ul>

                        <li>
                            La modificación manual del
                            <strong>stock</strong>
                            solo debe realizarse
                            <strong>en ajusten necesarios.</strong>.
                        </li>

                        <li>
                            El
                            <strong>costo de compra</strong>
                            se actualiza automáticamente según las compras
                            registradas en el sistema.
                        </li>

                        <li>
                            Todos los cambios realizados sobre este producto
                            generan un
                            <strong>registro de auditoría</strong>.
                        </li>

                    </ul>

                </div>

            </div>

            <EditForm Model="@producto" OnValidSubmit="Save">

                <DataAnnotationsValidator />

                <ValidationSummary />

                <div class="grid">

                    <div class="field">

                        <label>Nombre</label>

                        <InputText class="input" @bind-Value="producto.Nombre" />

                    </div>

                    <div class="field">

                        <label>Precio Costo</label>

                        <InputNumber class="input" @bind-Value="producto.PrecioCosto" />

                    </div>

                    <div class="field">

                        <label>Precio Venta</label>

                        <InputNumber class="input" @bind-Value="producto.PrecioVenta" />

                    </div>

                    <div class="field">

                        <label>Stock Mínimo</label>

                        <InputNumber class="input" @bind-Value="producto.StockMinimo" />

                    </div>

                    <div class="field">

                        <label>Presentación</label>

                        <InputText class="input" @bind-Value="producto.Presentacion" />

                    </div>

                    <div class="field">

                        <label>Stock Actual</label>

                        <InputNumber class="input stock-warning" @bind-Value="producto.StockActual" />

                        <small class="field-warning">
                            Evita modificar el stock manualmente.
                        </small>

                    </div>

                </div>

                <div class="actions">

                    <button type="submit" class="save-btn" disabled="@isSaving">

                        @if (isSaving)
                        {
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <span>Guardar Cambios</span>
                        }

                    </button>

                </div>

            </EditForm>

        </div>

    </div>
}

@code {

    [Parameter]
    public int id { get; set; }

    private PulperiaDbContext? db;
    private Producto? producto;

    private bool isLoading = true;
    private bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        db = dbContextFactory.CreateDbContext();

        producto = await db.Producto
            .FirstOrDefaultAsync(x => x.Id == id);

        isLoading = false;
    }

    private async Task Save()
    {
        if (producto is null || db is null)
            return;

        try
        {
            isSaving = true;

            // 🔴 estado anterior (si ya existe en DB)
            var anterior = await db.Producto
                .AsNoTracking()
                .FirstOrDefaultAsync(p => p.Id == producto.Id);

            db.Producto.Update(producto);

            await db.SaveChangesAsync();

            // 🟢 log después de guardar
            await LogService.RegistrarAsync(
                tabla: "Productos",
                accion: "UPDATE",
                registroId: producto.Id.ToString(),
                   usuario: Session != null ? Session?.CurrentUser?.Email : "Sistema",
                anterior: anterior,
                nuevo: new
                {
                    producto.Id,
                    producto.Nombre,
                    producto.PrecioCosto,
                    producto.PrecioVenta,
                    producto.Presentacion,
                    producto.StockActual,
                    producto.StockMinimo,
                }
            );

            Nav.NavigateTo($"/producto/{producto.Id}");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }
}

<style>
    .page-wrapper {
        min-height: 90vh;
        padding: 2rem;
        color: #f5f7fa;
        font-family: 'Inter', system-ui, sans-serif;
    }

    .form-container {
        max-width: 850px;
        margin: auto;
        background: #11151b;
        border: 1px solid #1b1f27;
        border-radius: 18px;
        padding: 2rem;
        box-shadow: 0 24px 60px rgba(0, 0, 0, .35);
    }

    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .header h2 {
        margin: 0;
        font-size: 1.7rem;
    }

    .header p {
        color: #707887;
        margin-top: 4px;
    }

    .back-btn {
        text-decoration: none;
        color: #ffaa43;
        border: 1px solid rgba(255, 170, 67, .25);
        padding: 10px 14px;
        border-radius: 10px;
        transition: .15s ease;
    }

    .back-btn:hover {
        background: rgba(255, 170, 67, .08);
    }

    .warning-box {
        display: flex;
        gap: 1rem;
        align-items: flex-start;
        background: rgba(255, 170, 67, .08);
        border: 1px solid rgba(255, 170, 67, .18);
        border-radius: 16px;
        padding: 1rem 1.2rem;
        margin-bottom: 2rem;
    }

    .warning-icon {
        font-size: 1.4rem;
        color: #ffaa43;
        line-height: 1;
    }

    .warning-content h4 {
        margin: 0 0 .7rem;
        color: #ffaa43;
        font-size: 1rem;
    }

    .warning-content ul {
        margin: 0;
        padding-left: 1rem;
        color: #d3d7df;
    }

    .warning-content li {
        margin-bottom: .55rem;
        line-height: 1.5;
        font-size: .92rem;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.2rem;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: .5rem;
    }

    .field label {
        font-size: .85rem;
        color: #9098a8;
    }

    .input {
        width: 100%;
        background: #0f1318;
        border: 1px solid #1b1f27;
        border-radius: 12px;
        padding: 12px 14px;
        color: white;
        outline: none;
        transition: .15s ease;
    }

    .input:focus {
        border-color: #ffaa43;
        box-shadow: 0 0 0 3px rgba(255, 170, 67, .08);
    }

    .stock-warning {
        border-color: rgba(255, 170, 67, .25);
    }

    .field-warning {
        color: #ffaa43;
        font-size: .75rem;
    }

    .actions {
        margin-top: 2rem;
        display: flex;
        justify-content: flex-end;
    }

    .save-btn {
        background: #ffaa43;
        color: black;
        border: none;
        padding: 12px 18px;
        border-radius: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: .15s ease;
    }

    .save-btn:hover {
        opacity: .92;
    }

    .save-btn:disabled {
        opacity: .7;
        cursor: not-allowed;
    }

    .loading-container {
        min-height: 100vh;
        background: #0b0d11;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #9098a8;
    }

    .loading-card {
        background: #11151b;
        border: 1px solid #1b1f27;
        padding: 2rem;
        border-radius: 18px;
    }

    ::deep .validation-message {
        color: #ff6b6b;
        font-size: .8rem;
    }
</style>