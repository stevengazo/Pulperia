@page "/producto/edit/{id:int}"

@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@inject LogService LogService
@inject IDbContextFactory<PulperiaDbContext> dbContextFactory
@inject AppSessionService Session
@inject NavigationManager Nav
@inject ILogger<EditProduct> Logger


<UserValidator>


<PageTitle>Editar Producto</PageTitle>

@if (isLoading)
{
    <div class="loading-container">
        <div class="loading-card">
            Cargando producto...
        </div>
    </div>
}
else if (producto is null)
{
    <div class="loading-container">
        <div class="loading-card">
            Producto no encontrado
        </div>
    </div>
}
else
{
    <div class="page-wrapper">

        <div class="form-container">

            <div class="header">

                <div>
                    <h2>Editar Producto</h2>
                    <p>
                        Actualiza la información general del producto
                    </p>
                </div>

                <a href="/productos" class="back-btn">
                    Volver
                </a>

            </div>

            <!-- WARNING -->
            <div class="warning-box">

                <div class="warning-icon">
                    ⚠
                </div>

                <div class="warning-content">

                    <h4>Advertencia de Inventario y Auditoría</h4>

                    <ul>

                        <li>
                            La modificación manual del
                            <strong>stock</strong>
                            solo debe realizarse
                            <strong>en ajusten necesarios.</strong>.
                        </li>

                        <li>
                            El
                            <strong>costo de compra</strong>
                            se actualiza automáticamente según las compras
                            registradas en el sistema.
                        </li>

                        <li>
                            Todos los cambios realizados sobre este producto
                            generan un
                            <strong>registro de auditoría</strong>.
                        </li>

                    </ul>

                </div>

            </div>

            <EditForm Model="@producto" OnValidSubmit="Save">

                <DataAnnotationsValidator />

                <ValidationSummary />

                <div class="grid">

                    <div class="field">

                        <label>Nombre</label>

                        <InputText class="input" @bind-Value="producto.Nombre" />

                    </div>

                    <div class="field">

                        <label>Precio Costo</label>

                        <InputNumber class="input" @bind-Value="producto.PrecioCosto" />

                    </div>

                    <div class="field">

                        <label>Precio Venta</label>

                        <InputNumber class="input" @bind-Value="producto.PrecioVenta" />

                    </div>

                    <div class="field">

                        <label>Stock Mínimo</label>

                        <InputNumber class="input" @bind-Value="producto.StockMinimo" />

                    </div>

                    <div class="field">

                        <label>Presentación</label>

                        <InputText class="input" @bind-Value="producto.Presentacion" />

                    </div>

                    <div class="field">

                        <label>Stock Actual</label>

                        <InputNumber class="input stock-warning" @bind-Value="producto.StockActual" />

                        <small class="field-warning">
                            Evita modificar el stock manualmente.
                        </small>

                    </div>

                </div>

                <div class="actions">

                    <button type="submit" class="save-btn" disabled="@isSaving">

                        @if (isSaving)
                        {
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <span>Guardar Cambios</span>
                        }

                    </button>

                </div>

            </EditForm>

        </div>

    </div>
}

</UserValidator>

@code {

    [Parameter]
    public int id { get; set; }

    private PulperiaDbContext? db;
    private Producto? producto;

    private bool isLoading = true;
    private bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        db = dbContextFactory.CreateDbContext();

        producto = await db.Producto
            .FirstOrDefaultAsync(x => x.Id == id);

        isLoading = false;
    }

    private async Task Save()
    {
        if (producto is null || db is null)
            return;

        try
        {
            isSaving = true;

            // 🔴 estado anterior (si ya existe en DB)
            var anterior = await db.Producto
                .AsNoTracking()
                .FirstOrDefaultAsync(p => p.Id == producto.Id);

            db.Producto.Update(producto);

            await db.SaveChangesAsync();

            // 🟢 log después de guardar
            await LogService.RegistrarAsync(
                tabla: "Productos",
                accion: "UPDATE",
                registroId: producto.Id.ToString(),
                   usuario: Session != null ? Session?.CurrentUser?.Email : "Sistema",
                anterior: anterior,
                nuevo: new
                {
                    producto.Id,
                    producto.Nombre,
                    producto.PrecioCosto,
                    producto.PrecioVenta,
                    producto.Presentacion,
                    producto.StockActual,
                    producto.StockMinimo,
                }
            );

            Nav.NavigateTo($"/producto/{producto.Id}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al actualizar el producto {ProductoId}.", producto?.Id);
        }
        finally
        {
            isSaving = false;
        }
    }
}