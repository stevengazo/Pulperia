@page "/producto/{id:int}"
@inject PulperiaDbContext db
@inject NavigationManager Nav


  
<UserValidator>
    <div class="view-container">
        <div class="view-header mb-4">
            <button @onclick='() => Nav.NavigateTo("/productos")' class="btn-back">
                <i class="bi bi-arrow-left"></i> Volver a la lista
            </button>
        </div>

        @if (producto == null)
        {
            <div class="loading-state">
                <div class="spinner"></div>
                <span>Cargando detalles del producto...</span>
            </div>
        }
        else
        {
            <div class="product-detail-card">
                <div class="detail-header">
                    <div class="title-group">
                        <span class="category-tag">Producto</span>
                        <h2 class="product-name">@producto.Nombre</h2>
                    </div>
                    <button @onclick='() => Nav.NavigateTo($"/producto/editar/{id}")' class="btn-edit">
                        <i class="bi bi-pencil-square"></i> Editar
                    </button>
                </div>

                <div class="detail-body">
                    <section class="info-section">
                        <label>Presentación</label>
                        <p>@(string.IsNullOrEmpty(producto.Presentacion) ? "Sin descripción" : producto.Presentacion)</p>
                    </section>

                    <div class="info-grid">
                        <div class="info-item">
                            <label>Precio Costo</label>
                            <div class="value cost">@producto.PrecioCosto.ToString("C")</div>
                        </div>
                        <div class="info-item">
                            <label>Precio Venta</label>
                            <div class="value price">@producto.PrecioVenta.ToString("C")</div>
                        </div>
                        <div class="info-item">
                            <label>Stock Actual</label>
                            <div class="value @(producto.StockActual <= producto.StockMinimo ? "text-danger" : "")">
                                @producto.StockActual unidades
                            </div>
                        </div>
                        <div class="info-item">
                            <label>Stock Mínimo</label>
                            <div class="value">@producto.StockMinimo unidades</div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

  
</UserValidator>

@code {
    [Parameter] public int id { get; set; }
    private Producto? producto;

    protected override async Task OnInitializedAsync()
    {
        // Pequeño retraso artificial para apreciar el estado de carga si es local (opcional)
        // await Task.Delay(300);
        producto = await db.Producto.FindAsync(id);
    }
}