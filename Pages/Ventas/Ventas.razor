@page "/ventas"
@inject IDbContextFactory<PulperiaDbContext> DbFactory
@inject EmpleadoService empleadoService
@inject NavigationManager Nav

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-white fw-bold mb-0">📊 Historial de Ventas</h2>
        <button class="btn btn-primary btn-lg shadow" @onclick='() => Nav.NavigateTo("nueva-venta")'>
            <i class="bi bi-plus-circle-fill me-2"></i> Nueva Venta
        </button>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card bg-dark text-white border-start border-4 border-info shadow-sm">
                <div class="card-body">
                    <h6 class="text-white-50 small mb-1">Ventas de Hoy</h6>
                    <h3 class="mb-0">@VentasHoy.ToString("C0")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark text-white border-start border-4 border-success shadow-sm">
                <div class="card-body">
                    <h6 class="text-white-50 small mb-1">Cobrado (Efectivo/SINPE)</h6>
                    <h3 class="mb-0">@Cobrado.ToString("C0")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark text-white border-start border-4 border-danger shadow-sm">
                <div class="card-body">
                    <h6 class="text-white-50 small mb-1">Pendiente (Fiados)</h6>
                    <h3 class="mb-0 text-danger">@Fiados.ToString("C0")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark text-white border-start border-4 border-warning shadow-sm">
                <div class="card-body">
                    <h6 class="text-white-50 small mb-1">Transacciones</h6>
                    <h3 class="mb-0">@Transacciones</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card bg-dark text-white border-secondary shadow">
        <div class="card-header border-secondary bg-transparent py-3">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-secondary text-white-50">
                            <i class="bi bi-filter"></i>
                        </span>
                        <input type="text" class="form-control bg-transparent text-white border-secondary"
                               placeholder="Buscar por folio o empleado..." @bind="filtro" @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-6 text-md-end mt-2 mt-md-0">
                    <div class="btn-group border border-secondary rounded">
                        <button class="btn btn-sm @(filtroEstado == "Todas" ? "btn-secondary" : "btn-outline-secondary")"
                                @onclick='() => filtroEstado = "Todas"'>Todas</button>
                        <button class="btn btn-sm @(filtroEstado == "Fiado" ? "btn-danger" : "btn-outline-secondary") text-danger"
                                @onclick='() => filtroEstado = "Fiado"'>Fiados</button>
                        <button class="btn btn-sm @(filtroEstado == "Hoy" ? "btn-secondary" : "btn-outline-secondary")"
                                @onclick='() => filtroEstado = "Hoy"'>Hoy</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="text-white-50 small">
                        <tr>
                            <th class="ps-4">Folio</th>
                            <th>Fecha/Hora</th>
                            <th>Empleado</th>
                            <th>Método</th>
                            <th class="text-end">Total</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var venta in VentasFiltradas)
                        {
                            var empleado = empleados.FirstOrDefault(e => e.Id.ToString() == venta.ClienteId);
                            <tr>
                                <td class="ps-4 fw-bold">#@venta.Id.ToString("D5")</td>
                                <td>
                                    <div class="small">@venta.Fecha.ToShortDateString()</div>
                                    <div class="text-white-50" style="font-size:0.75rem">@venta.Fecha.ToShortTimeString()</div>
                                </td>
                                <td class="small">
                                    @if (empleado != null)
                                    {
                                        <span>@empleado.Nombre @empleado.Apellido</span>
                                    }
                                    else
                                    {
                                        <span class="text-white-50">—</span>
                                    }
                                </td>
                                <td>
                                    @switch (venta.MetodoPago)
                                    {
                                        case "Efectivo": <span>💵 Efectivo</span> break;
                                        case "SINPE":    <span class="text-info">📱 SINPE</span> break;
                                        case "Fiado":    <span class="text-danger">📋 Fiado</span> break;
                                        case "Tarjeta":  <span class="text-warning">💳 Tarjeta</span> break;
                                        default:         <span>@venta.MetodoPago</span> break;
                                    }
                                </td>
                                <td class="text-end fw-bold">@venta.Total.ToString("C0")</td>
                                <td class="text-center">
                                    @if (venta.MetodoPago == "Fiado")
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger">Pendiente</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success">Pagado</span>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <button class="btn btn-sm btn-outline-light border-secondary">
                                      <i class="fa-solid fa-eye"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-light border-secondary">
                                        <i class="fa-solid fa-print"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private PulperiaDbContext db = default!;
    private List<Venta> ventas = new();
    private List<Empleado> empleados = new();
    private string filtro = "";
    private string filtroEstado = "Todas";

    private decimal VentasHoy => ventas
        .Where(v => v.Fecha.Date == DateTime.Today)
        .Sum(v => v.Total);

    private decimal Cobrado => ventas
        .Where(v => v.Fecha.Date == DateTime.Today && v.MetodoPago != "Fiado")
        .Sum(v => v.Total);

    private decimal Fiados => ventas
        .Where(v => v.Fecha.Date == DateTime.Today && v.MetodoPago == "Fiado")
        .Sum(v => v.Total);

    private int Transacciones => ventas
        .Count(v => v.Fecha.Date == DateTime.Today);

    private IEnumerable<Venta> VentasFiltradas => ventas.Where(v =>
        (string.IsNullOrEmpty(filtro) ||
            v.Id.ToString().Contains(filtro) ||
            empleados.Any(e => e.Id.ToString() == v.ClienteId &&
                ($"{e.Nombre} {e.Apellido}").Contains(filtro, StringComparison.OrdinalIgnoreCase))) &&
        filtroEstado switch
        {
            "Fiado" => v.MetodoPago == "Fiado",
            "Hoy"   => v.Fecha.Date == DateTime.Today,
            _       => true
        });

    protected override async Task OnInitializedAsync()
    {
        db = DbFactory.CreateDbContext();
        ventas = db.Venta.OrderByDescending(v => v.Fecha).ToList();
        empleados = await empleadoService.GetAllAsync();
    }
}