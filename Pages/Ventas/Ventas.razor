@page "/ventas"
@inject IDbContextFactory<PulperiaDbContext> DbFactory
@inject EmpleadoService empleadoService
@inject NavigationManager Nav

<style>
    .sales-root {
        min-height: 100vh;
        padding: 2rem 2.5rem;

        font-family: 'Inter', system-ui, sans-serif;
    }

    .sales-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
    }

    .sales-title h2 {
        margin: 0;
        font-size: 2rem;
        font-weight: 700;
        color: #f5f7fa;
        letter-spacing: -0.04em;
    }

    .sales-title p {
        margin: 6px 0 0;
        color: #707887;
        font-size: .92rem;
    }

    .btn-sale {
        border: none;
        background: #ffaa43;
        color: #0f1117;
        padding: 12px 18px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: .9rem;
        font-weight: 700;
        transition: .2s ease;
        box-shadow: 0 10px 25px rgba(255, 170, 67, .25);
    }

    .btn-sale:hover {
        transform: translateY(-2px);
        background: #ffc266;
        box-shadow: 0 14px 30px rgba(255, 170, 67, .35);
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .stat-card {
        background: #181c27;
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 22px;
        padding: 1.4rem;
        box-shadow: 0 20px 40px rgba(0, 0, 0, .35);
        transition: .2s ease;
    }

    .stat-card:hover {
        transform: translateY(-3px);
    }

    .stat-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
    }

    .stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }

    .icon-orange {
        background: rgba(255, 170, 67, .12);
        color: #ffaa43;
    }

    .icon-green {
        background: rgba(34, 197, 94, .12);
        color: #4ade80;
    }

    .icon-red {
        background: rgba(239, 68, 68, .12);
        color: #f87171;
    }

    .icon-yellow {
        background: rgba(250, 204, 21, .12);
        color: #facc15;
    }

    .stat-label {
        color: #707887;
        font-size: .84rem;
        margin-bottom: 6px;
    }

    .stat-value {
        color: #f5f7fa;
        font-size: 1.7rem;
        font-weight: 700;
        letter-spacing: -0.04em;
    }

    .sales-card {
        background: #181c27;
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0, 0, 0, .35);
    }

    .sales-toolbar {
        padding: 1.4rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .sales-search {
        background: #0f1117;
        border: 1px solid rgba(255, 255, 255, 0.07);
        border-radius: 14px;
        overflow: hidden;
        transition: .2s ease;
    }

    .sales-search:focus-within {
        border-color: #ffaa43;
        box-shadow: 0 0 0 4px rgba(255, 170, 67, .1);
    }

    .sales-search .input-group-text {
        background: transparent;
        border: none;
        color: #707887;
    }

    .sales-search .form-control {
        background: transparent;
        border: none;
        color: #f5f7fa;
        box-shadow: none;
    }

    .sales-search .form-control::placeholder {
        color: #5f6775;
    }

    .filter-group {
        display: flex;
        gap: 10px;
        justify-content: end;
        flex-wrap: wrap;
    }

    .filter-btn {
        border: 1px solid rgba(255, 255, 255, 0.07);
        background: #1e2333;
        color: #9099a8;
        padding: 10px 16px;
        border-radius: 12px;
        font-size: .85rem;
        font-weight: 600;
        transition: .18s ease;
    }

    .filter-btn:hover {
        border-color: #ffaa43;
        color: #ffaa43;
    }

    .filter-active {
        background: rgba(255, 170, 67, .12);
        color: #ffaa43;
        border-color: #ffaa43;
    }

    .table {
        margin: 0;
    }

    .table thead {
        background: #0f1117;
    }

    .table thead th {
        border: none;
        color: #7e8796;
        font-size: .72rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        padding: 18px 16px;
    }

    .table tbody tr {
        border-top: 1px solid rgba(255, 255, 255, 0.04);
        transition: .15s ease;
    }

    .table tbody tr:hover {
        background: rgba(255, 255, 255, .02);
    }

    .table tbody td {
        border: none;
        padding: 18px 16px;
        color: #d7dde7;
        vertical-align: middle;
    }

    .folio {
        color: #f5f7fa;
        font-weight: 700;
    }

    .date-main {
        color: #f5f7fa;
        font-size: .9rem;
    }

    .date-sub {
        color: #6b7280;
        font-size: .75rem;
    }

    .employee-name {
        color: #f5f7fa;
        font-weight: 500;
    }

    .payment-tag {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        border-radius: 999px;
        font-size: .82rem;
        font-weight: 600;
    }

    .pay-cash {
        background: rgba(34, 197, 94, .12);
        color: #4ade80;
    }

    .pay-sinpe {
        background: rgba(59, 130, 246, .12);
        color: #60a5fa;
    }

    .pay-credit {
        background: rgba(239, 68, 68, .12);
        color: #f87171;
    }

    .pay-card {
        background: rgba(250, 204, 21, .12);
        color: #facc15;
    }

    .total {
        font-weight: 700;
        color: #ffaa43;
        font-variant-numeric: tabular-nums;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 14px;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 700;
    }

    .status-paid {
        background: rgba(34, 197, 94, .12);
        color: #4ade80;
    }

    .status-pending {
        background: rgba(239, 68, 68, .12);
        color: #f87171;
    }

    .action-buttons {
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    .btn-action {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.07);
        background: #1e2333;
        color: #7e8796;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: .18s ease;
    }

    .btn-action:hover {
        transform: translateY(-2px);
    }

    .btn-view:hover {
        color: #ffaa43;
        border-color: #ffaa43;
        background: rgba(255, 170, 67, .12);
    }

    .btn-print:hover {
        color: #60a5fa;
        border-color: #60a5fa;
        background: rgba(59, 130, 246, .12);
    }
</style>

<div class="sales-root">

    <div class="sales-head">
        <div class="sales-title">
            <h2>Historial de Ventas</h2>
            <p>@ventas.Count ventas registradas</p>
        </div>

        <button class="btn-sale" @onclick='() => Nav.NavigateTo("nueva-venta")'>
            <i class="fa-solid fa-plus"></i>
            Nueva Venta
        </button>
    </div>

    <div class="stats-grid">

        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-icon icon-orange">
                    <i class="fa-solid fa-chart-line"></i>
                </div>
            </div>
            <div class="stat-label">Ventas de Hoy</div>
            <div class="stat-value">@VentasHoy.ToString("C0")</div>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-icon icon-green">
                    <i class="fa-solid fa-wallet"></i>
                </div>
            </div>
            <div class="stat-label">Cobrado</div>
            <div class="stat-value">@Cobrado.ToString("C0")</div>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-icon icon-red">
                    <i class="fa-solid fa-file-invoice-dollar"></i>
                </div>
            </div>
            <div class="stat-label">Fiados</div>
            <div class="stat-value">@Fiados.ToString("C0")</div>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-icon icon-yellow">
                    <i class="fa-solid fa-receipt"></i>
                </div>
            </div>
            <div class="stat-label">Transacciones</div>
            <div class="stat-value">@Transacciones</div>
        </div>

    </div>

    <div class="sales-card">

        <div class="sales-toolbar">
            <div class="row g-3 align-items-center">

                <div class="col-md-6">
                    <div class="input-group sales-search">
                        <span class="input-group-text">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>
                        <input type="text" class="form-control" placeholder="Buscar por folio o empleado..."
                               @bind="filtro" @bind:event="oninput" />
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="filter-group">
                        <button class="filter-btn @(filtroEstado == "Todas" ? "filter-active" : "")"
                                @onclick='() => filtroEstado = "Todas"'>Todas</button>

                        <button class="filter-btn @(filtroEstado == "Fiado" ? "filter-active" : "")"
                                @onclick='() => filtroEstado = "Fiado"'>Fiados</button>

                        <button class="filter-btn @(filtroEstado == "Hoy" ? "filter-active" : "")"
                                @onclick='() => filtroEstado = "Hoy"'>Hoy</button>
                    </div>
                </div>

            </div>
        </div>

        <div class="table-responsive">
            <table class="table align-middle">

                <thead>
                    <tr>
                        <th class="ps-4">Folio</th>
                        <th>Fecha/Hora</th>
                        <th>Empleado</th>
                        <th>Método</th>
                        <th class="text-end">Total</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center pe-4">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var venta in VentasFiltradas)
                    {
                        var empleado = empleados.FirstOrDefault(e => e.Id.ToString() == venta.ClienteId);

                        <tr>
                            <td class="ps-4">
                                <span class="folio">#@venta.Id.ToString("D5")</span>
                            </td>

                            <td>
                                <div class="date-main">@venta.Fecha.ToShortDateString()</div>
                                <div class="date-sub">@venta.Fecha.ToShortTimeString()</div>
                            </td>

                            <td>
                                @if (empleado != null)
                                {
                                    <span class="employee-name">@empleado.Nombre @empleado.Apellido</span>
                                }
                                else
                                {
                                    <span class="text-secondary">—</span>
                                }
                            </td>

                            <td>
                                @switch (venta.MetodoPago)
                                {
                                    case "Efectivo":
                                        <span class="payment-tag pay-cash">
                                            <i class="fa-solid fa-money-bill-wave"></i> Efectivo
                                        </span>
                                        break;
                                    case "SINPE":
                                        <span class="payment-tag pay-sinpe">
                                            <i class="fa-solid fa-mobile-screen"></i> SINPE
                                        </span>
                                        break;
                                    case "Fiado":
                                        <span class="payment-tag pay-credit">
                                            <i class="fa-solid fa-file-invoice"></i> Fiado
                                        </span>
                                        break;
                                    case "Tarjeta":
                                        <span class="payment-tag pay-card">
                                            <i class="fa-solid fa-credit-card"></i> Tarjeta
                                        </span>
                                        break;
                                    default:
                                        <span class="payment-tag">@venta.MetodoPago</span>
                                        break;
                                }
                            </td>

                            <td class="text-end total">@venta.Total.ToString("C0")</td>

                            <td class="text-center">
                                @if (venta.Pagado == false )
                                {
                                    <button class="status-badge status-pending border-0"
                                            @onclick="() => MarcarComoPagado(venta)">
                                        Marcar Pagado
                                    </button>
                                }
                                else
                                {
                                    <span class="status-badge status-paid">Pagado</span>
                                }
                            </td>

                            <td class="text-center pe-4">
                                <div class="action-buttons">
                                    <a class="btn-action btn-view" href="/venta/@venta.Id">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    <button class="btn-action btn-print">
                                        <i class="fa-solid fa-print"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

    </div>

</div>

@code {

    private PulperiaDbContext db = default!;
    private List<Pulperia.Models.Venta> ventas = new();
    private List<Empleado> empleados = new();
    private string filtro = "";
    private string filtroEstado = "Todas";

    private decimal VentasHoy => ventas
        .Where(v => v.Fecha.Date == DateTime.Today)
        .Sum(v => v.Total);

    private decimal Cobrado => ventas
        .Where(v => v.Fecha.Date == DateTime.Today && v.MetodoPago != "Fiado")
        .Sum(v => v.Total);

    private decimal Fiados => ventas
        .Where(v => v.Fecha.Date == DateTime.Today && v.MetodoPago == "Fiado")
        .Sum(v => v.Total);

    private int Transacciones => ventas
        .Count(v => v.Fecha.Date == DateTime.Today);

    private IEnumerable<Pulperia.Models.Venta> VentasFiltradas => ventas.Where(v =>
        (string.IsNullOrEmpty(filtro) ||
            v.Id.ToString().Contains(filtro) ||
            empleados.Any(e => e.Id.ToString() == v.ClienteId &&
                ($"{e.Nombre} {e.Apellido}")
                .Contains(filtro, StringComparison.OrdinalIgnoreCase))) &&
        filtroEstado switch
        {
            "Fiado" => v.MetodoPago == "Fiado",
            "Hoy" => v.Fecha.Date == DateTime.Today,
            _ => true
        });


    protected override async Task OnInitializedAsync()
    {
        db = DbFactory.CreateDbContext();
        ventas = db.Venta.OrderByDescending(v => v.Fecha).ToList();
        empleados = await empleadoService.GetAllAsync();
    }
    private async Task MarcarComoPagado(Pulperia.Models.Venta venta)
    {
        venta.Pagado = true;
        db.Venta.Update(venta);
        await db.SaveChangesAsync();

        StateHasChanged();
    }
}
