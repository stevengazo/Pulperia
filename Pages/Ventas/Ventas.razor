@page "/ventas"
@inject NavigationManager Nav

<div class="container-fluid py-4">
    
    @* Encabezado Dinámico *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-white fw-bold mb-0">📊 Historial de Ventas</h2>
        <button class="btn btn-primary btn-lg shadow" @onclick='() => Nav.NavigateTo("nueva-venta")'>
            <i class="bi bi-plus-circle-fill me-2"></i> Nueva Venta
        </button>
    </div>

    @* Tarjetas de Resumen Rápido *@
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card bg-dark text-white border-start border-4 border-info shadow-sm">
                <div class="card-body">
                    <h6 class="text-white-50 small mb-1">Ventas de Hoy</h6>
                    <h3 class="mb-0">₡45,200</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark text-white border-start border-4 border-success shadow-sm">
                <div class="card-body">
                    <h6 class="text-white-50 small mb-1">Cobrado (Efectivo/SINPE)</h6>
                    <h3 class="mb-0">₡38,000</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark text-white border-start border-4 border-danger shadow-sm">
                <div class="card-body">
                    <h6 class="text-white-50 small mb-1">Pendiente (Fiados)</h6>
                    <h3 class="mb-0 text-danger">₡7,200</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark text-white border-start border-4 border-warning shadow-sm">
                <div class="card-body">
                    <h6 class="text-white-50 small mb-1">Transacciones</h6>
                    <h3 class="mb-0">24</h3>
                </div>
            </div>
        </div>
    </div>

    @* Filtros y Tabla *@
    <div class="card bg-dark text-white border-secondary shadow">
        <div class="card-header border-secondary bg-transparent py-3">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-secondary text-white-50">
                            <i class="bi bi-filter"></i>
                        </span>
                        <input type="text" class="form-control bg-transparent text-white border-secondary" 
                               placeholder="Buscar por cliente o folio..." @bind="filtro" @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-6 text-md-end mt-2 mt-md-0">
                    <div class="btn-group border border-secondary rounded">
                        <button class="btn btn-sm btn-outline-secondary active">Todas</button>
                        <button class="btn btn-sm btn-outline-secondary text-danger">Fiados</button>
                        <button class="btn btn-sm btn-outline-secondary">Hoy</button>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="text-white-50 small">
                        <tr>
                            <th class="ps-4">Folio</th>
                            <th>Fecha/Hora</th>
                            <th>Cliente</th>
                            <th>Método</th>
                            <th class="text-end">Total</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var venta in VentasRegistradas.Where(v => string.IsNullOrEmpty(filtro) || v.Cliente.Contains(filtro, StringComparison.OrdinalIgnoreCase)))
                        {
                            <tr>
                                <td class="ps-4 fw-bold">#@venta.Id.ToString("D5")</td>
                                <td>
                                    <div class="small">@venta.Fecha.ToShortDateString()</div>
                                    <div class="text-white-50 x-small" style="font-size: 0.75rem;">@venta.Fecha.ToShortTimeString()</div>
                                </td>
                                <td>@(string.IsNullOrEmpty(venta.Cliente) ? "Cliente General" : venta.Cliente)</td>
                                <td>
                                    @switch (venta.Metodo)
                                    {
                                        case "Efectivo": <span>💵 Efectivo</span> break;
                                        case "SINPE": <span class="text-info">📱 SINPE</span> break;
                                        case "Fiado": <span class="text-danger">📋 Fiado</span> break;
                                        default: <span>@venta.Metodo</span> break;
                                    }
                                </td>
                                <td class="text-end fw-bold">@venta.Total.ToString("C0")</td>
                                <td class="text-center">
                                    @if (venta.Metodo == "Fiado")
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger">Pendiente</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success">Pagado</span>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <button class="btn btn-sm btn-outline-light border-secondary">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-light border-secondary">
                                        <i class="bi bi-printer"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private string filtro = "";

    // Simulación de datos (En producción vendrían de un Service/DB)
    private List<VentaHistorial> VentasRegistradas = new()
    {
        new VentaHistorial { Id = 1240, Fecha = DateTime.Now.AddMinutes(-45), Cliente = "Juan Portero", Metodo = "Efectivo", Total = 12500 },
        new VentaHistorial { Id = 1239, Fecha = DateTime.Now.AddHours(-2), Cliente = "María López", Metodo = "SINPE", Total = 3200 },
        new VentaHistorial { Id = 1238, Fecha = DateTime.Now.AddDays(-1), Cliente = "Don Carlos", Metodo = "Fiado", Total = 7200 },
        new VentaHistorial { Id = 1237, Fecha = DateTime.Now.AddDays(-1), Cliente = "", Metodo = "Efectivo", Total = 4500 }
    };

    public class VentaHistorial
    {
        public int Id { get; set; }
        public DateTime Fecha { get; set; }
        public string Cliente { get; set; } = "";
        public string Metodo { get; set; } = "";
        public decimal Total { get; set; }
    }
}