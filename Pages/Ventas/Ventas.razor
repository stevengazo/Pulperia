@page "/ventas"
@inject IDbContextFactory<PulperiaDbContext> DbFactory
@inject EmpleadoService empleadoService
@inject AppSessionService Session
@inject NavigationManager Nav
@inject LogService LogService
@using ClosedXML.Excel
@inject IJSRuntime JS


<UserValidator>
    <div class="sales-root">

        <div class="sales-head">
            <div class="sales-title">
                <h2>Historial de Ventas</h2>
                <p>@ventas.Count ventas registradas</p>
            </div>

            <div class="d-flex gap-2">
                <button class="btn-export" @onclick="ExportarExcel">
                    <i class="fa-solid fa-file-excel"></i>
                    Exportar Excel
                </button>
                <button class="btn-sale" @onclick='() => Nav.NavigateTo("nueva-venta")'>
                    <i class="fa-solid fa-plus"></i>
                    Nueva Venta
                </button>
            </div>
        </div>

        <div class="stats-grid">

            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-icon icon-orange">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>
                </div>
                <div class="stat-label">Ventas de Hoy</div>
                <div class="stat-value">@VentasHoy.ToString("C0")</div>
            </div>

            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-icon icon-green">
                        <i class="fa-solid fa-wallet"></i>
                    </div>
                </div>
                <div class="stat-label">Cobrado</div>
                <div class="stat-value">@Cobrado.ToString("C0")</div>
            </div>

            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-icon icon-red">
                        <i class="fa-solid fa-file-invoice-dollar"></i>
                    </div>
                </div>
                <div class="stat-label">Fiados</div>
                <div class="stat-value">@Fiados.ToString("C0")</div>
            </div>

            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-icon icon-yellow">
                        <i class="fa-solid fa-receipt"></i>
                    </div>
                </div>
                <div class="stat-label">Transacciones</div>
                <div class="stat-value">@Transacciones</div>
            </div>

        </div>

        <div class="sales-card">

            <div class="sales-toolbar">
                <div class="row g-3 align-items-center">

                    <div class="col-md-6">
                        <div class="input-group sales-search">
                            <span class="input-group-text">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </span>
                            <input type="text" class="form-control" placeholder="Buscar por folio o empleado..."
                                   value="@filtro" @oninput="OnFiltroChanged" />
                            <DateRangePicker OnRangeChanged="OnRangeChanged" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="filter-group">
                            <button class="filter-btn @(filtroEstado == "Todas" ? "filter-active" : "")"
                                    @onclick='() => CambiarFiltro("Todas")'>Todas</button>

                            <button class="filter-btn @(filtroEstado == "Fiado" ? "filter-active" : "")"
                                    @onclick='() => CambiarFiltro("Fiado")'>Fiados</button>

                            <button class="filter-btn @(filtroEstado == "Hoy" ? "filter-active" : "")"
                                    @onclick='() => CambiarFiltro("Hoy")'>Hoy</button>
                        </div>
                    </div>

                </div>
            </div>

            <div class="table-responsive">
                <table class="table align-middle">

                    <thead>
                        <tr>
                            <th class="ps-4">Folio</th>
                            <th>Fecha/Hora</th>
                            <th>Empleado</th>
                            <th>Método</th>
                            <th class="text-end">Total</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center pe-4">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var venta in VentasPaginadas)
                        {
                            var empleado = empleados.FirstOrDefault(e => e.Id.ToString() == venta.ClienteId);

                            <tr>
                                <td class="ps-4">
                                    <span class="folio">#@venta.Id.ToString("D5")</span>
                                </td>

                                <td>
                                    <div class="date-main">@venta.Fecha.ToShortDateString()</div>
                                    <div class="date-sub">@venta.Fecha.ToShortTimeString()</div>
                                </td>

                                <td>
                                    @if (empleado != null)
                                    {
                                        <span class="employee-name">@empleado.Nombre @empleado.Apellido</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">—</span>
                                    }
                                </td>

                                <td>
                                    @switch (venta.MetodoPago)
                                    {
                                        case "Efectivo":
                                            <span class="payment-tag pay-cash">
                                                <i class="fa-solid fa-money-bill-wave"></i> Efectivo
                                            </span>
                                            break;
                                        case "SINPE":
                                            <span class="payment-tag pay-sinpe">
                                                <i class="fa-solid fa-mobile-screen"></i> SINPE
                                            </span>
                                            break;
                                        case "Fiado":
                                            <span class="payment-tag pay-credit">
                                                <i class="fa-solid fa-file-invoice"></i> Fiado
                                            </span>
                                            break;
                                        case "Tarjeta":
                                            <span class="payment-tag pay-card">
                                                <i class="fa-solid fa-credit-card"></i> Tarjeta
                                            </span>
                                            break;
                                        default:
                                            <span class="payment-tag">@venta.MetodoPago</span>
                                            break;
                                    }
                                </td>

                                <td class="text-end total">@venta.Total.ToString("C0")</td>

                                <td class="text-center">
                                    @if (venta.Pagado == false)
                                    {
                                        <button class="status-badge status-pending border-0"
                                                @onclick="() => MarcarComoPagado(venta)">
                                            Marcar Pagado
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-paid">Pagado</span>
                                    }
                                </td>

                                <td class="text-center pe-4">
                                    <div class="action-buttons">
                                        <a class="btn-action btn-view" href="/venta/@venta.Id">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                                      <a class="btn-action btn-view" href="/venta/editar/@venta.Id">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                        </a>
                                        <button class="btn-action btn-print">
                                            <i class="fa-solid fa-print"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

         
            <div class="pagination-bar">

                <span class="pagination-info">
                    Mostrando @PrimerRegistro–@UltimoRegistro de @TotalFiltradas ventas
                </span>

                <div class="pagination-controls">

                    <button class="page-btn" @onclick="PrimeraPagina" disabled="@(paginaActual == 1)">
                        <i class="fa-solid fa-angles-left"></i>
                    </button>
                    <button class="page-btn" @onclick="PaginaAnterior" disabled="@(paginaActual == 1)">
                        <i class="fa-solid fa-angle-left"></i>
                    </button>

                    @for (int i = PaginaInicio; i <= PaginaFin; i++)
                    {
                        var p = i;
                        <button class="page-btn @(p == paginaActual ? "page-active" : "")" @onclick="() => IrAPagina(p)">
                            @p
                        </button>
                    }

                    <button class="page-btn" @onclick="PaginaSiguiente" disabled="@(paginaActual == TotalPaginas)">
                        <i class="fa-solid fa-angle-right"></i>
                    </button>
                    <button class="page-btn" @onclick="UltimaPagina" disabled="@(paginaActual == TotalPaginas)">
                        <i class="fa-solid fa-angles-right"></i>
                    </button>

                </div>

                <div class="page-size-selector">
                    <span>Filas:</span>
                    <select @onchange="CambiarTamañoPagina">
                        <option value="10" selected="@(tamañoPagina == 10)">10</option>
                        <option value="25" selected="@(tamañoPagina == 25)">25</option>
                        <option value="50" selected="@(tamañoPagina == 50)">50</option>
                        <option value="100" selected="@(tamañoPagina == 100)">100</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
</UserValidator>



@code {

    private PulperiaDbContext db = default!;
    private List<Pulperia.Models.Venta> ventas = new();
    private List<Empleado> empleados = new();
    private string filtro = "";
    private string filtroEstado = "Todas";

    private DateTime _inicio = DateTime.MinValue;
    private DateTime _fin = DateTime.MaxValue;

    private void OnRangeChanged((DateTime Inicio, DateTime Fin) rango)
    {
        (_inicio, _fin) = rango;
        ResetPagina();
    }

    // ── Paginación ────────────────────────────────────────────
    private int paginaActual = 1;
    private int tamañoPagina = 50;

    private int TotalFiltradas => VentasFiltradas.Count();
    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(TotalFiltradas / (double)tamañoPagina));
    private int PrimerRegistro => TotalFiltradas == 0 ? 0 : (paginaActual - 1) * tamañoPagina + 1;
    private int UltimoRegistro => Math.Min(paginaActual * tamañoPagina, TotalFiltradas);

    private int PaginaInicio => Math.Max(1, Math.Min(paginaActual - 2, TotalPaginas - 4));
    private int PaginaFin => Math.Min(TotalPaginas, PaginaInicio + 4);

    private IEnumerable<Pulperia.Models.Venta> VentasPaginadas =>
        VentasFiltradas
            .Skip((paginaActual - 1) * tamañoPagina)
            .Take(tamañoPagina);

    // ── Stats ─────────────────────────────────────────────────
    private decimal VentasHoy => ventas.Where(v => v.Fecha.Date == DateTime.Today).Sum(v => v.Total);
    private decimal Cobrado => ventas.Where(v => v.Fecha.Date == DateTime.Today && v.MetodoPago != "Fiado").Sum(v =>
v.Total);
    private decimal Fiados => ventas.Where(v => v.Fecha.Date == DateTime.Today && v.MetodoPago == "Fiado").Sum(v =>
v.Total);
    private int Transacciones => ventas.Count(v => v.Fecha.Date == DateTime.Today);

    // ── Filtros ───────────────────────────────────────────────
    private IEnumerable<Pulperia.Models.Venta> VentasFiltradas => ventas.Where(v =>
        (string.IsNullOrEmpty(filtro) ||
            v.Id.ToString().Contains(filtro) ||
            empleados.Any(e => e.Id.ToString() == v.ClienteId &&
                $"{e.Nombre} {e.Apellido}".Contains(filtro, StringComparison.OrdinalIgnoreCase))) &&
        filtroEstado switch
        {
            "Fiado" => v.MetodoPago == "Fiado",
            _ => true
        } &&
        (_inicio == DateTime.MinValue || v.Fecha.Date >= _inicio) &&
        (_fin == DateTime.MaxValue || v.Fecha.Date <= _fin));

    // ── Init ──────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        db = DbFactory.CreateDbContext();
        ventas = db.Venta.OrderByDescending(v => v.Fecha).ToList();
        empleados = await empleadoService.GetAllAsync();
    }

    // ── Acciones de paginación ────────────────────────────────
    private void IrAPagina(int p) => paginaActual = Math.Clamp(p, 1, TotalPaginas);
    private void PrimeraPagina() => paginaActual = 1;
    private void UltimaPagina() => paginaActual = TotalPaginas;
    private void PaginaAnterior() => paginaActual = Math.Max(1, paginaActual - 1);
    private void PaginaSiguiente() => paginaActual = Math.Min(TotalPaginas, paginaActual + 1);
    private void ResetPagina() => paginaActual = 1;

    private void OnFiltroChanged(ChangeEventArgs e)
    {
        filtro = e.Value?.ToString() ?? "";
        ResetPagina();
    }

    private void CambiarFiltro(string estado)
    {
        filtroEstado = estado;
        ResetPagina();
    }

    private void CambiarTamañoPagina(ChangeEventArgs e)
    {
        tamañoPagina = int.Parse(e.Value!.ToString()!);
        ResetPagina();
    }

    // ── Marcar pagado ─────────────────────────────────────────
    private async Task MarcarComoPagado(Pulperia.Models.Venta venta)
    {
        var anterior = new { venta.Id, venta.Pagado };

        venta.Pagado = true;
        db.Venta.Update(venta);
        await db.SaveChangesAsync();

        await LogService.RegistrarAsync(
            tabla: "Ventas",
            accion: "UPDATE",
            registroId: venta.Id.ToString(),
            usuario: Session?.CurrentUser?.Email ?? "Sistema",
            anterior: anterior,
            nuevo: new { venta.Id, venta.Pagado }
        );

        StateHasChanged();
    }

    // ── Exportar Excel ────────────────────────────────────────
    private async Task ExportarExcel()
    {
        await LogService.RegistrarAsync(
            tabla: "Ventas",
            accion: "EXPORT_EXCEL",
            registroId: "ALL",
            usuario: Session?.CurrentUser?.Email ?? "Sistema",
            anterior: new { FiltrosAplicados = VentasFiltradas.Count() }
        );

        using var wb = new XLWorkbook();

        // ── Hoja 1: Detalle ───────────────────────────────────────
        var ws = wb.Worksheets.Add("Ventas");

        var headers = new[] { "Folio", "Fecha", "Hora", "Empleado", "Método de Pago", "Total", "Estado" };
        for (int i = 0; i < headers.Length; i++)
            ws.Cell(1, i + 1).Value = headers[i];

        int row = 2;
        foreach (var venta in VentasFiltradas)
        {
            var empleado = empleados.FirstOrDefault(e => e.Id.ToString() == venta.ClienteId);
            ws.Cell(row, 1).Value = $"#{venta.Id:D5}";
            ws.Cell(row, 2).Value = venta.Fecha.ToShortDateString();
            ws.Cell(row, 3).Value = venta.Fecha.ToShortTimeString();
            ws.Cell(row, 4).Value = empleado != null ? $"{empleado.Nombre} {empleado.Apellido}" : "—";
            ws.Cell(row, 5).Value = venta.MetodoPago;
            ws.Cell(row, 6).Value = venta.Total;
            ws.Cell(row, 6).Style.NumberFormat.Format = "#,##0.00";
            ws.Cell(row, 7).Value = venta.Pagado ? "Pagado" : "Pendiente";
            row++;
        }

        var tablaRango = ws.Range(1, 1, row - 1, 7);
        var tabla = tablaRango.CreateTable("TblVentas");
        tabla.Theme = XLTableTheme.TableStyleMedium2;
        tabla.ShowTotalsRow = true;
        tabla.Field("Total").TotalsRowFunction = XLTotalsRowFunction.Sum;
        tabla.Field("Total").Column.Cells().Style.NumberFormat.Format = "#,##0.00";

        for (int i = 1; i <= 7; i++)
        {
            var cell = ws.Cell(1, i);
            cell.Style.Fill.BackgroundColor = XLColor.FromHtml("#ffaa43");
            cell.Style.Font.FontColor = XLColor.Black;
            cell.Style.Font.Bold = true;
            cell.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
        }

        ws.Columns().AdjustToContents();

        // ── Hoja 2: Resumen ───────────────────────────────────────
        var wsR = wb.Worksheets.Add("Resumen");

        void EstiloEncabezado(IXLCell c)
        {
            c.Style.Font.Bold = true;
            c.Style.Fill.BackgroundColor = XLColor.FromHtml("#ffaa43");
            c.Style.Font.FontColor = XLColor.Black;
            c.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
        }

        void EstiloSubtotal(IXLCell c)
        {
            c.Style.Font.Bold = true;
            c.Style.Fill.BackgroundColor = XLColor.FromHtml("#1a1a1a");
            c.Style.Font.FontColor = XLColor.White;
        }

        void EscribirTablaEstado(string titulo, IEnumerable<Pulperia.Models.Venta> ventasFiltradas, ref int rr)
        {
            wsR.Cell(rr, 1).Value = titulo;
            wsR.Cell(rr, 1).Style.Font.Bold = true;
            wsR.Cell(rr, 1).Style.Font.FontSize = 13;
            rr++;

            wsR.Cell(rr, 1).Value = "Folio";
            wsR.Cell(rr, 2).Value = "Empleado";
            wsR.Cell(rr, 3).Value = "Método de Pago";
            wsR.Cell(rr, 4).Value = "Total";
            EstiloEncabezado(wsR.Cell(rr, 1));
            EstiloEncabezado(wsR.Cell(rr, 2));
            EstiloEncabezado(wsR.Cell(rr, 3));
            EstiloEncabezado(wsR.Cell(rr, 4));
            rr++;

            foreach (var venta in ventasFiltradas)
            {
                var empleado = empleados.FirstOrDefault(e => e.Id.ToString() == venta.ClienteId);
                wsR.Cell(rr, 1).Value = $"#{venta.Id:D5}";
                wsR.Cell(rr, 1).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
                wsR.Cell(rr, 2).Value = empleado != null ? $"{empleado.Nombre} {empleado.Apellido}" : "—";
                wsR.Cell(rr, 3).Value = venta.MetodoPago;
                wsR.Cell(rr, 3).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
                wsR.Cell(rr, 4).Value = venta.Total;
                wsR.Cell(rr, 4).Style.NumberFormat.Format = "#,##0.00";
                rr++;
            }

            EstiloSubtotal(wsR.Cell(rr, 1)); wsR.Cell(rr, 1).Value = "TOTAL";
            EstiloSubtotal(wsR.Cell(rr, 2)); wsR.Cell(rr, 2).Value = $"{ventasFiltradas.Count()} ventas";
            EstiloSubtotal(wsR.Cell(rr, 3)); wsR.Cell(rr, 3).Value = "";
            EstiloSubtotal(wsR.Cell(rr, 4)); wsR.Cell(rr, 4).Value = ventasFiltradas.Sum(v => v.Total);
            wsR.Cell(rr, 4).Style.NumberFormat.Format = "#,##0.00";
            rr += 3;
        }

        int r = 1;

        var pendientes = VentasFiltradas.Where(v => !v.Pagado).OrderBy(v => v.Id);
        var pagadas = VentasFiltradas.Where(v => v.Pagado).OrderBy(v => v.Id);

        EscribirTablaEstado("Pendientes de Pago", pendientes, ref r);
        EscribirTablaEstado("Pagado", pagadas, ref r);

        wsR.Columns().AdjustToContents();

        // ── Descarga ──────────────────────────────────────────────
        using var stream = new MemoryStream();
        wb.SaveAs(stream);
        var base64 = Convert.ToBase64String(stream.ToArray());
        var fileName = $"ventas_{DateTime.Today:yyyy-MM-dd}.xlsx";

        await JS.InvokeVoidAsync("downloadBase64File", base64, fileName,
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }
}