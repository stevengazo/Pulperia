@page "/venta/editar/{id:int}"

@inject IDbContextFactory<PulperiaDbContext> DbContextFactory
@inject EmpleadoService emp
@inject LogService LogService
@inject IDbContextFactory<PulperiaDbContext> dbContextFactory
@inject AppSessionService Session
@inject NavigationManager Nav

@using Microsoft.EntityFrameworkCore

<div class="sale-page">

    <div class="sale-header">

        <div class="header-left">

            <button class="back-btn" @onclick='() => Nav.NavigateTo("/ventas")'>
                <i class="fa-solid fa-arrow-left"></i>
            </button>

            <div>
                <div class="page-title">Editar Venta</div>
                <div class="page-subtitle">Modificar productos y cobro</div>
            </div>

        </div>

        <div class="folio-badge">
            Folio #@Id.ToString("D6")
        </div>

    </div>

    @if (cargando)
    {
        <div class="loading-state">
            <i class="fa-solid fa-spinner fa-spin"></i>
            <span>Cargando venta...</span>
        </div>
    }
    else if (venta == null)
    {
        <div class="alert-modern alert-danger">
            <i class="bi bi-exclamation-triangle-fill"></i>
            No se encontró la venta #@Id.
        </div>
    }
    else
    {
        <div class="sale-grid">

            @* ================= LEFT ================= *@
            <div class="sale-left">

                <div class="card-modern">

                    <div class="add-product-grid">

                        <select class="input-modern" @bind="productoSeleccionadoId">

                            <option value="0">Seleccione producto...</option>

                            @foreach (var p in productos)
                            {
                                <option value="@p.Id">
                                    @p.Nombre — @p.Presentacion (Stock: @p.StockActual)
                                </option>
                            }

                        </select>

                        <input type="number" min="1" class="input-modern text-center" @bind="cantidad" />

                        <button class="btn-add" @onclick="AgregarAlCarrito" disabled="@(productoSeleccionadoId == 0)">
                            <i class="fa-solid fa-plus"></i>
                        </button>

                    </div>

                    @if (errorMsg != "")
                    {
                        <div class="alert-modern alert-danger">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            @errorMsg
                        </div>
                    }

                    <div class="table-wrapper">

                        <table class="modern-table">

                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-end">Precio</th>
                                    <th class="text-center">Cantidad</th>
                                    <th class="text-end">Subtotal</th>
                                    <th></th>
                                </tr>
                            </thead>

                            <tbody>

                                @if (!carrito.Any())
                                {
                                    <tr>
                                        <td colspan="5">
                                            <div class="empty-cart">
                                                <i class="bi bi-cart-x"></i>
                                                <div>No hay productos agregados</div>
                                            </div>
                                        </td>
                                    </tr>
                                }

                                @foreach (var item in carrito)
                                {
                                    <tr>

                                        <td>
                                            <div class="product-cell">
                                                <div class="product-name">@item.Producto.Nombre</div>
                                                <div class="product-stock">Stock: @item.Producto.StockActual</div>
                                            </div>
                                        </td>

                                        <td class="text-end">
                                            @item.PrecioUnitarioHistorico.ToString("C0")
                                        </td>

                                        <td>
                                            <div class="qty-box">

                                                <button class="qty-btn" @onclick="() => CambiarCantidad(item, -1)">−</button>

                                                <div class="qty-value">@item.Cantidad</div>

                                                <button class="qty-btn" @onclick="() => CambiarCantidad(item, 1)"
                                                        disabled="@(item.Cantidad >= item.Producto.StockActual)">+</button>

                                            </div>
                                        </td>

                                        <td class="text-end fw-bold">
                                            @((item.PrecioUnitarioHistorico * item.Cantidad).ToString("C0"))
                                        </td>

                                        <td class="text-center">
                                            <button class="remove-btn" @onclick="() => carrito.Remove(item)">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

            @* ================= RIGHT ================= *@
            <div class="sale-right">

                <div class="card-modern sticky-card">

                    <div class="total-card">
                        <div class="total-label">Total</div>
                        <div class="total-value">@Total.ToString("C0")</div>
                    </div>

                    <div>
                        <label class="label-modern">Empleado</label>
                        <select class="input-modern" @bind="empleadoId">
                            <option value="0">Sin asignar</option>
                            @foreach (var e in empleados)
                            {
                                <option value="@e.Id">@e.Nombre @e.Apellido</option>
                            }
                        </select>
                    </div>

                    @* ── Toggle Pagado ── *@
                    <div>
                        <label class="label-modern">Estado de pago</label>
                        <button class="toggle-pagado @(pagado ? "pagado-on" : "pagado-off")"
                                @onclick="() => pagado = !pagado">
                            @if (pagado)
                            {
                                <i class="bi bi-check-circle-fill"></i>
                                <span>Pagado</span>
                            }
                            else
                            {
                                <i class="bi bi-x-circle-fill"></i>
                                <span>No pagado</span>
                            }
                        </button>
                    </div>

                    <div>
                        <label class="label-modern">Método de pago</label>
                        <select class="input-modern" @bind="metodoPago">
                            <option value="Efectivo">💵 Efectivo</option>
                            <option value="SINPE">📱 SINPE</option>
                            <option value="Tarjeta">💳 Tarjeta</option>
                            <option value="Fiado">📋 Fiado</option>
                        </select>
                    </div>

                    @if (metodoPago == "Efectivo")
                    {
                        <div>
                            <label class="label-modern">Monto recibido</label>
                            <input type="number" class="input-modern" @bind-value="pagoCon" @bind-value:event="oninput" />
                        </div>

                        <div class="change-box">
                            <span>Cambio</span>
                            <strong>@Cambio.ToString("C0")</strong>
                        </div>
                    }

                    <div class="checkout-box">

                        @if (guardando)
                        {
                            <div class="saving-text">Guardando cambios...</div>
                        }

                        <button class="checkout-btn" disabled="@(!carrito.Any() || guardando)" @onclick="Guardar">
                            <i class="bi bi-floppy-fill"></i>
                            Guardar Cambios
                        </button>

                    </div>

                </div>

            </div>

        </div>
    }

</div>

@code {

    [Parameter] public int Id { get; set; }

    private PulperiaDbContext db = default!;

    private Pulperia.Models.Venta? venta;

    private List<Empleado> empleados = new();
    private List<Producto> productos = new();
    private List<DetalleVenta> carrito = new();

    private List<DetalleVenta> detallesAntiguos = new();

    // Snapshot del estado original de la cabecera (para el log)
    private object? snapCabecera;

    private int productoSeleccionadoId = 0;
    private int cantidad = 1;

    private string metodoPago = "Efectivo";
    private decimal pagoCon;
    private string errorMsg = "";
    private string empleadoId = "";
    private bool pagado;
    private bool guardando = false;
    private bool cargando = true;

    private decimal Total =>
        carrito.Sum(i => i.PrecioUnitarioHistorico * i.Cantidad);

    private decimal Cambio =>
        pagoCon > Total ? pagoCon - Total : 0;

    protected override async Task OnInitializedAsync()
    {
        db = DbContextFactory.CreateDbContext();

        empleados = await emp.GetAllAsync();
        empleados = empleados.OrderBy(e => e.Nombre).ToList();

        productos = db.Producto
            .OrderBy(p => p.Nombre)
            .ToList();

        venta = db.Venta
            .Include(v => v.DetalleVentas)
                .ThenInclude(d => d.Producto)
            .FirstOrDefault(v => v.Id == Id);

        if (venta != null)
        {
            metodoPago  = venta.MetodoPago;
            pagoCon     = venta.MontoRecibido;
            empleadoId  = venta.ClienteId ?? "";
            pagado      = venta.Pagado;

            // Guardar snapshot de cabecera ANTES de cualquier edición
            snapCabecera = new
            {
                venta.Total,
                venta.MetodoPago,
                venta.MontoRecibido,
                venta.Cambio,
                venta.Pagado,
                ClienteId = venta.ClienteId
            };

            foreach (var d in venta.DetalleVentas)
            {
                var prod = productos.FirstOrDefault(p => p.Id == d.ProductoId)
                           ?? d.Producto;

                if (prod != null)
                    prod.StockActual += d.Cantidad;

                carrito.Add(new DetalleVenta
                {
                    Id         = d.Id,
                    ProductoId = d.ProductoId,
                    Producto   = prod!,
                    Cantidad   = d.Cantidad,
                    PrecioUnitarioHistorico = d.PrecioUnitarioHistorico,
                    CostoUnitarioHistorico  = d.CostoUnitarioHistorico
                });
            }

            // Copia de los detalles originales para el log de inventario
            detallesAntiguos = venta.DetalleVentas.ToList();

            productos = productos
                .Where(p => p.StockActual > 0)
                .ToList();
        }

        cargando = false;
    }

    void AgregarAlCarrito()
    {
        errorMsg = "";

        var producto = productos.FirstOrDefault(p => p.Id == productoSeleccionadoId);
        if (producto == null) return;

        var existente    = carrito.FirstOrDefault(c => c.ProductoId == producto.Id);
        int cantidadActual = existente?.Cantidad ?? 0;

        if (cantidadActual + cantidad > producto.StockActual)
        {
            errorMsg = $"Stock insuficiente. Disponible: {producto.StockActual - cantidadActual} unidad(es).";
            return;
        }

        if (existente != null)
        {
            existente.Cantidad += cantidad;
        }
        else
        {
            carrito.Add(new DetalleVenta
            {
                ProductoId = producto.Id,
                Producto   = producto,
                Cantidad   = cantidad,
                PrecioUnitarioHistorico = producto.PrecioVenta,
                CostoUnitarioHistorico  = producto.PrecioVenta
            });
        }

        productoSeleccionadoId = 0;
        cantidad = 1;
    }

    void CambiarCantidad(DetalleVenta item, int delta)
    {
        int nueva = item.Cantidad + delta;

        if (nueva <= 0)
        {
            carrito.Remove(item);
            return;
        }

        if (nueva > item.Producto.StockActual)
        {
            errorMsg = $"Stock máximo disponible: {item.Producto.StockActual} unidad(es).";
            return;
        }

        errorMsg = "";
        item.Cantidad = nueva;
    }

    async Task Guardar()
    {
        if (!carrito.Any() || venta == null) return;

        guardando = true;

        // 1. Restaurar stock original y eliminar detalles antiguos
        var detallesEnDb = db.DetalleVenta
            .Include(d => d.Producto)
            .Where(d => d.VentaId == Id)
            .ToList();

        foreach (var d in detallesEnDb)
        {
            var prod = db.Producto.Find(d.ProductoId);
            if (prod != null)
                prod.StockActual += d.Cantidad;

            db.DetalleVenta.Remove(d);
        }

        // 2. Actualizar cabecera con el nuevo estado (incluye el toggle de Pagado)
        var ventaDb = db.Venta.Find(Id);
        if (ventaDb != null)
        {
            ventaDb.Total         = Total;
            ventaDb.MetodoPago    = metodoPago;
            ventaDb.MontoRecibido = metodoPago == "Efectivo" ? pagoCon : Total;
            ventaDb.Cambio        = Cambio;
            ventaDb.Pagado        = pagado;                          // ← usa el toggle
            ventaDb.ClienteId     = string.IsNullOrWhiteSpace(empleadoId) ? null : empleadoId;
        }

        await db.SaveChangesAsync();

        // 3. Insertar nuevos detalles y descontar stock
        foreach (var item in carrito)
        {
            db.DetalleVenta.Add(new DetalleVenta
            {
                VentaId                 = Id,
                ProductoId              = item.ProductoId,
                Cantidad                = item.Cantidad,
                PrecioUnitarioHistorico = item.PrecioUnitarioHistorico,
                CostoUnitarioHistorico  = item.CostoUnitarioHistorico
            });

            var prod = db.Producto.Find(item.ProductoId);
            if (prod != null)
                prod.StockActual -= item.Cantidad;
        }

        await db.SaveChangesAsync();

        // 4. Log de auditoría de la cabecera de la venta
        //    Captura el estado anterior (snapshot tomado al cargar) y el nuevo
        var nuevaCabecera = new
        {
            Total,
            MetodoPago    = metodoPago,
            MontoRecibido = metodoPago == "Efectivo" ? pagoCon : Total,
            Cambio,
            Pagado        = pagado,
            ClienteId     = string.IsNullOrWhiteSpace(empleadoId) ? null : empleadoId
        };

        await LogService.RegistrarAsync(
            tabla:      "Venta",
            accion:     "Editar",
            registroId: Id.ToString(),
            usuario:    Session?.CurrentUser?.Email ?? "No indicado",
            anterior:   snapCabecera,
            nuevo:      nuevaCabecera);

        // 5. Log de cambios en detalles (productos del carrito)
        await LogService.RegistrarAsync(
            tabla:      "DetalleVenta",
            accion:     "Editar",
            registroId: Id.ToString(),
            usuario:    Session?.CurrentUser?.Email ?? "No indicado",
            anterior:   detallesAntiguos.Select(d => new
                        {
                            d.ProductoId,
                            NombreProducto          = d.Producto?.Nombre ?? d.ProductoId.ToString(),
                            d.Cantidad,
                            d.PrecioUnitarioHistorico
                        }),
            nuevo:      carrito.Select(d => new
                        {
                            d.ProductoId,
                            NombreProducto          = d.Producto?.Nombre ?? d.ProductoId.ToString(),
                            d.Cantidad,
                            d.PrecioUnitarioHistorico
                        }));

        // 6. Log de impacto en inventario (solo productos que cambiaron)
        var cambiosInventario = new List<object>();

        foreach (var item in carrito)
        {
            var anterior  = detallesAntiguos.FirstOrDefault(d => d.ProductoId == item.ProductoId);
            int cantAntes = anterior?.Cantidad ?? 0;

            if (cantAntes != item.Cantidad)
            {
                cambiosInventario.Add(new
                {
                    item.ProductoId,
                    NombreProducto = item.Producto.Nombre,
                    StockAntes     = cantAntes,
                    StockDespues   = item.Cantidad,
                    Diferencia     = item.Cantidad - cantAntes
                });
            }
        }

        // Productos eliminados del carrito
        foreach (var d in detallesAntiguos.Where(d => !carrito.Any(c => c.ProductoId == d.ProductoId)))
        {
            cambiosInventario.Add(new
            {
                d.ProductoId,
                NombreProducto = d.Producto?.Nombre ?? d.ProductoId.ToString(),
                StockAntes     = d.Cantidad,
                StockDespues   = 0,
                Diferencia     = -d.Cantidad
            });
        }

        if (cambiosInventario.Any())
        {
            await LogService.RegistrarAsync(
                tabla:      "Inventario",
                accion:     "ModificacionPorEdicionVenta",
                registroId: Id.ToString(),
                usuario:    Session?.CurrentUser?.Email ?? "No indicado",
                anterior:   null,
                nuevo:      cambiosInventario);
        }

        guardando = false;

        Nav.NavigateTo("/ventas");
    }
}
