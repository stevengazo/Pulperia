@page "/nueva-venta"

@inject IDbContextFactory<PulperiaDbContext> DbFactory
@inject EmpleadoService empleadoService
@inject AppSessionService Session
@inject NavigationManager Nav
@inject VentaService VentaService

@using Microsoft.EntityFrameworkCore

<div class="sale-page">

    <div class="sale-header">

        <div class="header-left">

            <button class="back-btn"
                    @onclick='() => Nav.NavigateTo("/ventas")'>

          <i class="fa-solid fa-arrow-left"></i>

            </button>

            <div>

                <div class="page-title">
                    Nueva Venta
                </div>

                <div class="page-subtitle">
                    Registro y cobro de productos
                </div>

            </div>

        </div>

        <div class="folio-badge">
            Folio: pendiente
        </div>

    </div>

    <div class="sale-grid">

        @* ================= LEFT ================= *@
        <div class="sale-left">

            <div class="card-modern">

                <div class="add-product-grid">

                    <select class="input-modern"
                            @bind="productoSeleccionadoId">

                        <option value="0">
                            Seleccione producto...
                        </option>

                        @foreach (var p in productos)
                        {
                            <option value="@p.Id">
                                @p.Nombre — @p.Presentacion (Stock: @p.StockActual)
                            </option>
                        }

                    </select>

                    <input type="number"
                           min="1"
                           class="input-modern text-center"
                           @bind="cantidad" />

                    <button class="btn-add"
                            @onclick="AgregarAlCarrito"
                            disabled="@(productoSeleccionadoId == 0)">

                        <i class="fa-solid fa-plus"></i>

                    </button>

                </div>

                @if (errorMsg != "")
                {
                    <div class="alert-modern">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        @errorMsg
                    </div>
                }

                <div class="table-wrapper">

                    <table class="modern-table">

                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th class="text-end">Precio</th>
                                <th class="text-center">Cantidad</th>
                                <th class="text-end">Subtotal</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (!carrito.Any())
                            {
                                <tr>
                                    <td colspan="5">

                                        <div class="empty-cart">

                                            <i class="bi bi-cart-x"></i>

                                            <div>
                                                No hay productos agregados
                                            </div>

                                        </div>

                                    </td>
                                </tr>
                            }

                            @foreach (var item in carrito)
                            {
                                <tr>

                                    <td>

                                        <div class="product-cell">

                                            <div class="product-name">
                                                @item.Producto.Nombre
                                            </div>

                                            <div class="product-stock">
                                                Stock: @item.Producto.StockActual
                                            </div>

                                        </div>

                                    </td>

                                    <td class="text-end">
                                        @item.PrecioUnitarioHistorico.ToString("C0")
                                    </td>

                                    <td>

                                        <div class="qty-box">

                                            <button class="qty-btn"
                                                    @onclick="() => CambiarCantidad(item, -1)">

                                                −

                                            </button>

                                            <div class="qty-value">
                                                @item.Cantidad
                                            </div>

                                            <button class="qty-btn"
                                                    @onclick="() => CambiarCantidad(item, 1)"
                                                    disabled="@(item.Cantidad >= item.Producto.StockActual)">

                                                +

                                            </button>

                                        </div>

                                    </td>

                                    <td class="text-end fw-bold">

                                        @((item.PrecioUnitarioHistorico * item.Cantidad).ToString("C0"))

                                    </td>

                                    <td class="text-center">

                                        <button class="remove-btn"
                                                @onclick="() => carrito.Remove(item)">

                                            <i class="bi bi-x-lg"></i>

                                        </button>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        @* ================= RIGHT ================= *@
        <div class="sale-right">

            <div class="card-modern sticky-card">

                <div class="total-card">

                    <div class="total-label">
                        Total
                    </div>

                    <div class="total-value">
                        @Total.ToString("C0")
                    </div>

                </div>

                <div>

                    <label class="label-modern">
                        Empleado
                    </label>

                    <select class="input-modern"
                            @bind="empleadoId">

                        <option value="0">
                            Sin asignar
                        </option>

                        @foreach (var e in empleados)
                        {
                            <option value="@e.Id">
                                @e.Nombre @e.Apellido
                            </option>
                        }

                    </select>

                </div>

                <div>

                    <label class="label-modern">
                        Método de pago
                    </label>

                    <select class="input-modern"
                            @bind="metodoPago">

                        <option value="Efectivo">
                            💵 Efectivo
                        </option>

                        <option value="SINPE">
                            📱 SINPE
                        </option>

                        <option value="Tarjeta">
                            💳 Tarjeta
                        </option>

                        <option value="Fiado">
                            📋 Fiado
                        </option>

                    </select>

                </div>

                @if (metodoPago == "Efectivo")
                {
                    <div>

                        <label class="label-modern">
                            Monto recibido
                        </label>

                        <input type="number"
                               class="input-modern"
                               @bind-value="pagoCon"
                               @bind-value:event="oninput" />

                    </div>

                    <div class="change-box">

                        <span>
                            Cambio
                        </span>

                        <strong>
                            @Cambio.ToString("C0")
                        </strong>

                    </div>
                }

                <div class="checkout-box">

                    @if (guardando)
                    {
                        <div class="saving-text">
                            Guardando venta...
                        </div>
                    }

                    <button class="checkout-btn"
                            disabled="@(!carrito.Any() || guardando)"
                            @onclick="Procesar">

                        <i class="bi bi-credit-card-2-front-fill"></i>

                        Cobrar Venta

                    </button>

                </div>

            </div>

        </div>

    </div>

</div>

@code {

    private List<Empleado> empleados = new();
    private List<Producto> productos = new();
    private List<DetalleVenta> carrito = new();

    private int productoSeleccionadoId = 0;
    private int cantidad = 1;

    private string metodoPago = "Efectivo";

    private decimal pagoCon;

    private string errorMsg = "";

    private string empleadoId = "";

    private bool guardando = false;

    private decimal Total =>
        carrito.Sum(i => i.PrecioUnitarioHistorico * i.Cantidad);

    private decimal Cambio =>
        pagoCon > Total ? pagoCon - Total : 0;

    protected override async Task OnInitializedAsync()
    {
        empleados = (await empleadoService.GetAllAsync())
            .OrderBy(e => e.Nombre)
            .ToList();

        // Contexto acotado a la carga: se crea y se libera aquí mismo, sin
        // mantenerlo vivo durante todo el ciclo del componente.
        await using var db = await DbFactory.CreateDbContextAsync();

        productos = await db.Producto
            .Where(p => p.StockActual > 0)
            .OrderBy(p => p.Nombre)
            .ToListAsync();
    }

    void AgregarAlCarrito()
    {
        errorMsg = "";

        var producto = productos
            .FirstOrDefault(p => p.Id == productoSeleccionadoId);

        if (producto == null)
            return;

        var existente = carrito
            .FirstOrDefault(c => c.ProductoId == producto.Id);

        int cantidadActual = existente?.Cantidad ?? 0;

        if (cantidadActual + cantidad > producto.StockActual)
        {
            errorMsg =
                $"Stock insuficiente. Disponible: {producto.StockActual - cantidadActual} unidad(es).";

            return;
        }

        if (existente != null)
        {
            existente.Cantidad += cantidad;
        }
        else
        {
            carrito.Add(new DetalleVenta
            {
                ProductoId = producto.Id,
                Producto = producto,
                Cantidad = cantidad,
                PrecioUnitarioHistorico = producto.PrecioVenta,
                CostoUnitarioHistorico = producto.PrecioCosto
            });
        }

        productoSeleccionadoId = 0;
        cantidad = 1;
    }

    void CambiarCantidad(DetalleVenta item, int delta)
    {
        int nueva = item.Cantidad + delta;

        if (nueva <= 0)
        {
            carrito.Remove(item);
            return;
        }

        if (nueva > item.Producto.StockActual)
        {
            errorMsg =
                $"Stock máximo disponible: {item.Producto.StockActual} unidad(es).";

            return;
        }

        errorMsg = "";

        item.Cantidad = nueva;
    }

    async Task Procesar()
    {
        if (!carrito.Any())
            return;

        guardando = true;
        errorMsg = "";

        try
        {
            var resultado = await VentaService.ProcesarAsync(
                carrito,
                metodoPago,
                pagoCon,
                string.IsNullOrWhiteSpace(empleadoId) ? null : empleadoId,
                Session?.CurrentUser?.Email ?? "No indicado");

            if (resultado.Exito)
                Nav.NavigateTo("/ventas");
            else
                errorMsg = resultado.Error ?? "No se pudo procesar la venta.";
        }
        finally
        {
            guardando = false;
        }
    }
}