@page "/nueva-venta"

@inject IDbContextFactory<PulperiaDbContext> DbFactory
@inject EmpleadoService empleadoService
@inject NavigationManager Nav

<div class="container-fluid px-4 py-3" style="max-width:1100px">

    <div class="d-flex align-items-center gap-3 mb-3">
        <button class="btn btn-sm btn-outline-secondary" @onclick='() => Nav.NavigateTo("/ventas")'>
           <i class="fa-solid fa-arrow-left-long"></i>
        </button>
        <h5 class="text-white mb-0">Nueva Venta</h5>
        <span class="badge bg-secondary ms-auto">Folio #@ventaId.ToString("D6")</span>
    </div>

    <div class="row g-3">

        <div class="col-lg-8">
            <div class="card bg-dark border-secondary">
                <div class="card-body p-3">

                    <div class="row g-2 mb-3">
                        <div class="col-9">
                            <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                    @bind="productoSeleccionadoId">
                                <option value="0">Seleccione producto...</option>
                                @foreach (var p in productos)
                                {
                                    <option value="@p.Id">@p.Nombre — @p.Presentacion (Stock: @p.StockActual)</option>
                                }
                            </select>
                        </div>
                        <div class="col-2">
                            <input type="number" min="1"
                                   class="form-control form-control-sm bg-dark text-white border-secondary text-center"
                                   @bind="cantidad" />
                        </div>
                        <div class="col-1">
                            <button class="btn btn-sm btn-success w-100" @onclick="AgregarAlCarrito"
                                    disabled="@(productoSeleccionadoId == 0)">
                                <i class="fa-solid fa-plus"></i>
                            </button>
                        </div>
                    </div>

                    @if (errorMsg != "")
                    {
                        <div class="alert alert-warning py-1 px-2 small mb-2">@errorMsg</div>
                    }

                    <div class="table-responsive" style="max-height:360px; overflow-y:auto;">
                        <table class="table table-dark table-sm table-hover align-middle mb-0">
                            <thead class="sticky-top" style="background:#212529">
                                <tr class="text-white-50 small">
                                    <th>Producto</th>
                                    <th class="text-end">Precio</th>
                                    <th class="text-center">Cant.</th>
                                    <th class="text-end">Subtotal</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!carrito.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-white-50 py-4 small">Sin productos</td>
                                    </tr>
                                }
                                @foreach (var item in carrito)
                                {
                                    <tr>
                                        <td class="small">@item.Producto.Nombre</td>
                                        <td class="text-end small">@item.PrecioUnitarioHistorico.ToString("C0")</td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-secondary px-2"
                                                        @onclick="() => CambiarCantidad(item, -1)">−</button>
                                                <span class="btn btn-dark disabled px-2">@item.Cantidad</span>
                                                <button class="btn btn-outline-secondary px-2"
                                                        @onclick="() => CambiarCantidad(item, 1)"
                                                        disabled="@(item.Cantidad >= item.Producto.StockActual)">+</button>
                                            </div>
                                        </td>
                                        <td class="text-end small fw-semibold">
                                            @((item.PrecioUnitarioHistorico * item.Cantidad).ToString("C0"))
                                        </td>
                                        <td class="text-center">
                                            <i class="bi bi-x text-danger" style="cursor:pointer"
                                               @onclick="() => carrito.Remove(item)"></i>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card bg-dark border-secondary h-100">
                <div class="card-body p-3 d-flex flex-column gap-3">

                    <div class="text-center py-2 rounded" style="background:#1a1a1a">
                        <div class="text-white-50 small mb-1">Total</div>
                        <div class="text-white fw-bold fs-3">@Total.ToString("C0")</div>
                    </div>

                    <div>
                        <label class="text-white-50 small mb-1">Empleado</label>
                        <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                @bind="empleadoId">
                            <option value="0">Sin asignar</option>
                            @foreach (var e in empleados)
                            {
                                <option value="@e.Id">@e.Nombre @e.Apellido</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="text-white-50 small mb-1">Método de pago</label>
                        <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                @bind="metodoPago">
                            <option value="Efectivo">💵 Efectivo</option>
                            <option value="SINPE">📱 SINPE</option>
                            <option value="Tarjeta">💳 Tarjeta</option>
                            <option value="Fiado">📋 Fiado</option>
                        </select>
                    </div>

                    @if (metodoPago == "Efectivo")
                    {
                        <div>
                            <label class="text-white-50 small mb-1">Recibido</label>
                            <input type="number" class="form-control form-control-sm bg-dark text-white border-secondary"
                                   @bind-value="pagoCon" @bind-value:event="oninput" />
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-white-50 small">Cambio</span>
                            <span class="text-info fw-bold">@Cambio.ToString("C0")</span>
                        </div>
                    }

                    <div class="mt-auto">
                        @if (guardando)
                        {
                            <div class="text-center text-white-50 small mb-2">Guardando...</div>
                        }
                        <button class="btn btn-primary btn-sm w-100" disabled="@(!carrito.Any() || guardando)"
                                @onclick="Procesar">
                            <i class="bi bi-printer me-1"></i> Cobrar
                        </button>
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>

@code {
    private PulperiaDbContext db = default!;
    private List<Empleado> empleados = new();
    private List<Producto> productos = new();
    private List<DetalleVenta> carrito = new();

    private int productoSeleccionadoId = 0;
    private int cantidad = 1;
    private string metodoPago = "Efectivo";
    private decimal pagoCon;
    private string errorMsg = "";
    private string empleadoId = "";
    private bool guardando = false;
    private int ventaId = 0;

    private decimal Total => carrito.Sum(i => i.PrecioUnitarioHistorico * i.Cantidad);
    private decimal Cambio => pagoCon > Total ? pagoCon - Total : 0;

    protected override async Task OnInitializedAsync()
    {
        db = DbFactory.CreateDbContext();
        empleados = await empleadoService.GetAllAsync();
        empleados = empleados.OrderBy(e => e.Nombre).ToList();
        productos = db.Producto
            .Where(p => p.StockActual > 0)
            .OrderBy(p => p.Nombre)
            .ToList();

        ventaId = db.Venta.Any() ? db.Venta.Max(v => v.Id) + 1 : 1;
    }

    void AgregarAlCarrito()
    {
        errorMsg = "";
        var producto = productos.FirstOrDefault(p => p.Id == productoSeleccionadoId);
        if (producto == null) return;

        // Cantidad ya en carrito para este producto
        var existente = carrito.FirstOrDefault(c => c.ProductoId == producto.Id);
        int cantidadActual = existente?.Cantidad ?? 0;

        if (cantidadActual + cantidad > producto.StockActual)
        {
            errorMsg = $"Stock insuficiente. Disponible: {producto.StockActual - cantidadActual} unidad(es).";
            return;
        }

        if (existente != null)
        {
            existente.Cantidad += cantidad;
        }
        else
        {
            carrito.Add(new DetalleVenta
            {
                ProductoId = producto.Id,
                Producto = producto,
                Cantidad = cantidad,
                PrecioUnitarioHistorico = producto.PrecioVenta * cantidad,
                CostoUnitarioHistorico = producto.PrecioVenta
            });
        }

        productoSeleccionadoId = 0;
        cantidad = 1;
    }

    void CambiarCantidad(DetalleVenta item, int delta)
    {
        int nueva = item.Cantidad + delta;

        if (nueva <= 0)
        {
            carrito.Remove(item);
            return;
        }

        if (nueva > item.Producto.StockActual)
        {
            errorMsg = $"Stock máximo disponible: {item.Producto.StockActual} unidad(es).";
            return;
        }

        errorMsg = "";
        item.Cantidad = nueva;
    }

    async Task Procesar()
    {
        if (!carrito.Any()) return;
        guardando = true;

        var venta = new Pulperia.Models.Venta
        {
            Fecha = DateTime.Now,
            Total = Total,
            MetodoPago = metodoPago,
            MontoRecibido = metodoPago == "Efectivo" ? pagoCon : Total,
            Cambio = Cambio,
            Notas = "",
            Pagado =  metodoPago == "Fiado" ? false : true ,
            ClienteId = empleadoId == "" ? null : empleadoId.ToString()
        };

        db.Venta.Add(venta);
        await db.SaveChangesAsync();

        foreach (var item in carrito)
        {
            item.VentaId = venta.Id;
            db.DetalleVenta.Add(item);

            var prod = db.Producto.Find(item.ProductoId);
            if (prod != null)
                prod.StockActual -= item.Cantidad;
        }

        await db.SaveChangesAsync();
        guardando = false;
        Nav.NavigateTo("/ventas");
    }
}
