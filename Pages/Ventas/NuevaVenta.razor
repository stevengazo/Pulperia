@page "/nueva-venta"

@inject IDbContextFactory<PulperiaDbContext> DbFactory
@inject EmpleadoService empleadoService
@inject NavigationManager Nav

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <button class="btn btn-outline-secondary btn-sm mb-2" @onclick='() => Nav.NavigateTo("/ventas")'>
                <i class="bi bi-arrow-left"></i> Volver a la lista
            </button>
            <h3 class="text-white mb-0">🛒 Registro de Venta Directa</h3>
        </div>
        <div class="text-end">
            <div class="text-white-50 small">Vendedor: Administrador</div>
            <div class="badge bg-primary">Folio: #@ventaId.ToString("D6")</div>
        </div>
    </div>

    <div class="row g-4">
        @* PANEL DE PRODUCTOS *@
        <div class="col-lg-8">
            <div class="card bg-dark text-white border-secondary shadow-lg">
                <div class="card-body p-4">
                    <div class="row g-3 mb-4">
                        <div class="col-md-9">
                            <label class="form-label text-white-50">Escanear o buscar producto</label>
                            <select class="form-select bg-dark text-white border-secondary"
                                    @bind="productoSeleccionadoId">
                                <option value="0">-- Seleccione un producto --</option>
                                @foreach (var p in productos)
                                {
                                    <option value="@p.Id">@p.Nombre / @p.Presentacion</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-white-50">Cant.</label>
                            <input type="number" min="1"
                                   class="form-control form-control-lg bg-dark text-white border-secondary text-center"
                                   @bind="cantidad" />
                        </div>
                    </div>

                    <button class="btn btn-outline-success mb-3" @onclick="AgregarAlCarrito"
                            disabled="@(productoSeleccionadoId == 0)">
                        <i class="bi bi-plus-circle me-1"></i> Agregar
                    </button>

                    @if (errorMsg != "")
                    {
                        <div class="alert alert-warning py-1 px-3">@errorMsg</div>
                    }

                    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-dark table-hover align-middle">
                            <thead class="sticky-top bg-dark border-bottom border-secondary">
                                <tr class="text-white-50">
                                    <th>Descripción</th>
                                    <th class="text-end">Precio</th>
                                    <th class="text-center">Cant.</th>
                                    <th class="text-end">Subtotal</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in carrito)
                                {
                                    <tr>
                                        <td>@item.Producto.Nombre</td>
                                        <td class="text-end">@item.PrecioUnitarioHistorico.ToString("C0")</td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-secondary"
                                                        @onclick="() => CambiarCantidad(item, -1)">-</button>
                                                <span class="btn btn-dark disabled">@item.Cantidad</span>
                                                <button class="btn btn-outline-secondary"
                                                        @onclick="() => CambiarCantidad(item, 1)">+</button>
                                            </div>
                                        </td>
                                        <td class="text-end fw-bold">
                                            @((item.PrecioUnitarioHistorico * item.Cantidad).ToString("C0"))
                                        </td>
                                        <td class="text-center">
                                            <i class="bi bi-x-circle btn text-danger"
                                               @onclick="() => carrito.Remove(item)"></i>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        @* PANEL DE PAGO *@
        <div class="col-lg-4">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-success text-white text-center py-3">
                    <span class="d-block small">TOTAL A COBRAR</span>
                    <h2 class="mb-0 fw-bold">@Total.ToString("C0")</h2>
                </div>
                <div class="card-body bg-dark text-white border border-top-0 border-secondary rounded-bottom">

                    <div class="mb-3">
                        <label class="small text-white-50">Método de pago</label>
                        <select class="form-select bg-dark text-white border-secondary" @bind="metodoPago">
                            <option value="Efectivo">💵 Efectivo</option>
                            <option value="SINPE">📱 SINPE / Transferencia</option>
                            <option value="Tarjeta">💳 Tarjeta</option>
                            <option value="Fiado">📋 Cuenta por Cobrar</option>
                        </select>
                    </div>

                    @if (metodoPago == "Efectivo")
                    {
                        <div class="mb-3">
                            <label class="small text-white-50">Pagó con:</label>
                            <input type="number" class="form-control form-control-lg bg-dark text-white border-info"
                                   @bind-value="pagoCon" @bind-value:event="oninput" />
                        </div>
                        <div class="d-flex justify-content-between mb-4">
                            <span class="text-white-50">Cambio:</span>
                            <span class="h4 text-info fw-bold">@Cambio.ToString("C0")</span>
                        </div>
                    }

                    @if (guardando)
                    {
                        <div class="text-center text-white-50 mb-2">Guardando...</div>
                    }

                    <button class="btn btn-primary w-100 py-3 fw-bold"
                            disabled="@(!carrito.Any() || guardando)"
                            @onclick="Procesar">
                        <i class="bi bi-printer me-2"></i> COBRAR E IMPRIMIR
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private PulperiaDbContext db = default!;
    private List<Empleado> empleados = new();
    private List<Producto> productos = new();
    private List<DetalleVenta> carrito = new();

    private int productoSeleccionadoId = 0;
    private int cantidad = 1;
    private string metodoPago = "Efectivo";
    private decimal pagoCon;
    private string errorMsg = "";
    private bool guardando = false;
    private int ventaId = 0;

    private decimal Total => carrito.Sum(i => i.PrecioUnitarioHistorico * i.Cantidad);
    private decimal Cambio => pagoCon > Total ? pagoCon - Total : 0;

    protected override async Task OnInitializedAsync()
    {
        db = DbFactory.CreateDbContext();
        empleados = await empleadoService.GetAllAsync();
        empleados = empleados.OrderBy(e => e.Nombre).ToList();
        productos = db.Producto
            .Where(p => p.StockActual > 0)
            .OrderBy(p => p.Nombre)
            .ToList();

        // Calcular próximo folio
        ventaId = db.Venta.Any() ? db.Venta.Max(v => v.Id) + 1 : 1;
    }

    void AgregarAlCarrito()
    {
        errorMsg = "";
        var producto = productos.FirstOrDefault(p => p.Id == productoSeleccionadoId);
        if (producto == null) return;

        var existente = carrito.FirstOrDefault(c => c.ProductoId == producto.Id);
        if (existente != null)
        {
            existente.Cantidad += cantidad;
        }
        else
        {
            carrito.Add(new DetalleVenta
            {
                ProductoId = producto.Id,
                Producto = producto,
                Cantidad = cantidad,
                PrecioUnitarioHistorico = producto.PrecioVenta
            });
        }

        productoSeleccionadoId = 0;
        cantidad = 1;
    }

    void CambiarCantidad(DetalleVenta item, int delta)
    {
        item.Cantidad += delta;
        if (item.Cantidad <= 0)
            carrito.Remove(item);
    }

    async Task Procesar()
    {
        if (!carrito.Any()) return;
        guardando = true;

        var venta = new Venta
        {
            Fecha = DateTime.Now,
            Total = Total,
            MetodoPago = metodoPago,
            MontoRecibido = metodoPago == "Efectivo" ? pagoCon : Total,
            Cambio = Cambio,
            Notas = ""
        };

        db.Venta.Add(venta);
        await db.SaveChangesAsync(); // Para obtener el Id generado

        foreach (var item in carrito)
        {
            item.VentaId = venta.Id;
            db.DetalleVenta.Add(item);

            // Descontar stock
            var prod = db.Producto.Find(item.ProductoId);
            if (prod != null)
                prod.StockActual -= item.Cantidad;
        }

        await db.SaveChangesAsync();
        guardando = false;
        Nav.NavigateTo("/ventas");
    }
}