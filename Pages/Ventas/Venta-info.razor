@page "/venta/{id:int}"

@inject IDbContextFactory<PulperiaDbContext> DbContextFactory
@inject EmpleadoService emp
@inject IJSRuntime JS

<UserValidator>
    <div class="page">

        @if (isLoading)
        {
            <p>Cargando...</p>
        }
        else if (venta is null)
        {
            <p>No se encontró la venta</p>
        }
        else
        {
            <div class="actions">
                <GenerarTicket  Venta="@venta" Empleado="@empleado" />
            </div>

            <div class="receipt">

                <!-- HEADER -->
                <div class="header">
                    <div class="title">RECIBO DE VENTA</div>
                    <div class="muted">ID Venta #@venta.Id</div>
                    <div class="muted">@venta.Fecha</div>
                </div>

                <!-- INFO -->
                <div class="info">
                    <div><b>Método de pago:</b> @venta.MetodoPago</div>

                    @if (empleado != null)
                    {
                        <div><b>Empleado:</b> <a href="/empleado/@empleado.Id"> @empleado.Nombre @empleado.Apellido </a></div>
                    }
                </div>

                <!-- ITEMS -->
                @foreach (var item in venta.DetalleVentas)
                {
                    <div class="item">

                        <div class="line">
                            <div class="name">@item.Producto.Nombre</div>
                            <div>₡@item.CostoUnitarioHistorico</div>
                            <div>₡@(item.PrecioUnitarioHistorico * item.Cantidad)</div>
                        </div>

                        <div class="line muted">
                            <div>@item.Producto.Presentacion</div>
                            <div>Cant: @item.Cantidad</div>
                        </div>

                    </div>
                }

                <!-- TOTAL -->
                <div class="total">
                    <div>TOTAL</div>
                    <div>₡@venta.Total</div>
                </div>

            </div>
        }

    </div>
</UserValidator>

@code {

    [Parameter] public int id { get; set; }

    private PulperiaDbContext db;
    private Pulperia.Models.Venta? venta;
    private Pulperia.Models.Empleado? empleado;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            db = DbContextFactory.CreateDbContext();

            venta = await db.Venta
                .Include(v => v.DetalleVentas)
                    .ThenInclude(d => d.Producto)
                .FirstOrDefaultAsync(v => v.Id == id);

            if (venta != null)
            {
                empleado = await emp.GetByIdAsync(venta.ClienteId);
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Print()
    {
        await JS.InvokeVoidAsync("print");
    }
}