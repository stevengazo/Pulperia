@page "/venta/{id:int}"

@inject IDbContextFactory<PulperiaDbContext> DbContextFactory
@inject EmpleadoService emp
@inject IJSRuntime JS

<style>
    .page {
        min-height: 100vh;
        background: #0b0d11;
        padding: 2rem;
        font-family: system-ui, sans-serif;
        color: #f5f7fa;
    }

    .actions {
        max-width: 420px;
        margin: auto;
        margin-bottom: 1rem;
        display: flex;
        justify-content: flex-end;
    }

    .btn-print {
        background: #ffaa43;
        border: none;
        padding: 10px 14px;
        border-radius: 10px;
        color: #111;
        cursor: pointer;
        font-weight: 700;
    }

    /* RECEIPT */
    .receipt {
        max-width: 420px;
        margin: auto;
        background: #11151b;
        border: 1px solid #1b1f27;
        border-radius: 16px;
        padding: 1.5rem;
        box-shadow: 0 20px 50px rgba(0, 0, 0, .4);
    }

    .header {
        text-align: center;
        border-bottom: 1px dashed #2a2f3a;
        padding-bottom: 1rem;
        margin-bottom: 1rem;
    }

    .title {
        font-weight: 700;
        font-size: 1.1rem;
        letter-spacing: 1px;
    }

    .muted {
        color: #707887;
        font-size: .8rem;
    }

    .info {
        margin-bottom: .8rem;
        font-size: .85rem;
    }

    .line {
        display: flex;
        justify-content: space-between;
        font-size: .9rem;
        padding: .25rem 0;
        gap: .5rem;
    }

    .item {
        border-bottom: 1px dashed #2a2f3a;
        padding-bottom: .5rem;
        margin-bottom: .5rem;
    }

    .name {
        font-weight: 600;
    }

    .total {
        margin-top: 1rem;
        border-top: 1px solid #2a2f3a;
        padding-top: 1rem;
        display: flex;
        justify-content: space-between;
        font-weight: 800;
        color: #ffaa43;
        font-size: 1.05rem;
    }

    @@media print {
        body * {
            visibility: hidden;
        }

        .receipt,
        .receipt * {
            visibility: visible;
        }

        .receipt {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            border: none;
            box-shadow: none;
        }

        .actions {
            display: none;
        }

        body {
            background: white;
        }
    }
</style>

<UserValidator>
    <div class="page">

        @if (isLoading)
        {
            <p>Cargando...</p>
        }
        else if (venta is null)
        {
            <p>No se encontró la venta</p>
        }
        else
        {
            <div class="actions">
                <button class="btn-print" @onclick="Print">🧾 Imprimir recibo</button>
            </div>

            <div class="receipt">

                <!-- HEADER -->
                <div class="header">
                    <div class="title">RECIBO DE VENTA</div>
                    <div class="muted">ID Venta #@venta.Id</div>
                    <div class="muted">@venta.Fecha</div>
                </div>

                <!-- INFO -->
                <div class="info">
                    <div><b>Método de pago:</b> @venta.MetodoPago</div>

                    @if (empleado != null)
                    {
                       
                            <div><b>Empleado:</b> <a href="/empleado/@empleado.Id"> @empleado.Nombre @empleado.Apellido </a></div>
                        

                    }
                </div>

                <!-- ITEMS -->
                @foreach (var item in venta.DetalleVentas)
                {
                    <div class="item">

                        <div class="line">
                            <div class="name">@item.Producto.Nombre</div>
                            <div>₡@item.CostoUnitarioHistorico</div>
                            <div>₡@(item.PrecioUnitarioHistorico * item.Cantidad)</div>
                        </div>

                        <div class="line muted">
                            <div>@item.Producto.Presentacion</div>
                            <div>Cant: @item.Cantidad</div>
                        </div>

                    </div>
                }

                <!-- TOTAL -->
                <div class="total">
                    <div>TOTAL</div>
                    <div>₡@venta.Total</div>
                </div>

            </div>
        }

    </div>
</UserValidator>

@code {

    [Parameter] public int id { get; set; }

    private PulperiaDbContext db;
    private Pulperia.Models.Venta? venta;
    private Pulperia.Models.Empleado? empleado;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            db = DbContextFactory.CreateDbContext();

            venta = await db.Venta
                .Include(v => v.DetalleVentas)
                    .ThenInclude(d => d.Producto)
                .FirstOrDefaultAsync(v => v.Id == id);

            if (venta != null)
            {
                empleado = await emp.GetByIdAsync(venta.ClienteId);
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Print()
    {
        await JS.InvokeVoidAsync("print");
    }
}