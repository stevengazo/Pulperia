@page "/configuracion"

@inject IDbContextFactory<PulperiaDbContext> dbContextFactory

@using Microsoft.EntityFrameworkCore

<UserValidator>

    <div class="settings-page">

        <div class="settings-header">

            <div class="settings-title">
                Configuración
            </div>

            <div class="settings-subtitle">
                Administración del sistema y registros
            </div>

        </div>

        <div class="tabs">

            <button class="tab-btn @(tab == 0 ? "active" : "")" @onclick="() => tab = 0">
                <i class="bi bi-tags-fill"></i>
                Categorías
            </button>

            <button class="tab-btn @(tab == 1 ? "active" : "")" @onclick="() => tab = 1">
                <i class="bi bi-truck"></i>
                Proveedores
            </button>

                        <button class="tab-btn @(tab == 2 ? "active" : "")" @onclick="() => tab = 2">
                <i class="bi bi-truck"></i>
                Permisos
            </button>

        </div>

        @* ================= CATEGORIAS ================= *@
        @if (tab == 0)
        {
            <div class="grid-layout">

                <div class="card-modern">

                    <div class="card-title mb-4">
                        Nueva categoría
                    </div>

                    <input class="input-modern" placeholder="Nombre de categoría" @bind="newCategory" />

                    <button class="btn-modern mt-3" @onclick="AgregarCategoria">

                        <i class="bi bi-plus-lg"></i>
                        Guardar categoría

                    </button>

                </div>

                <div class="card-modern">

                    <div class="card-title mb-4">
                        Categorías registradas
                    </div>

                    @if (categories.Count == 0)
                    {
                        <div class="empty-state">
                            No hay categorías registradas
                        </div>
                    }
                    else
                    {
                        @foreach (var c in categories)
                        {
                            <div class="list-item">

                                <div>

                                    <div class="item-title">
                                        @c.Nombre
                                    </div>

                                    <div class="item-subtitle">
                                        Categoría de productos
                                    </div>

                                </div>

                                <div class="item-id">
                                    #@c.Id
                                </div>

                            </div>
                        }
                    }

                </div>

            </div>
        }

        @* ================= PROVEEDORES ================= *@
        @if (tab == 1)
        {
            <div class="grid-layout">

                <div class="card-modern">

                    <div class="card-title mb-4">
                        Nuevo proveedor
                    </div>

                    <input class="input-modern mb-3" placeholder="Nombre" @bind="newProveedor.Nombre" />

                    <input class="input-modern mb-3" placeholder="Teléfono" @bind="newProveedor.Telefono" />

                    <input class="input-modern mb-3" placeholder="Correo electrónico" @bind="newProveedor.Email" />

                    <button class="btn-modern" @onclick="AgregarProveedor">

                        <i class="bi bi-check-lg"></i>
                        Guardar proveedor

                    </button>

                </div>

                <div class="card-modern">

                    <div class="card-title mb-4">
                        Proveedores registrados
                    </div>

                    @if (proveedors.Count == 0)
                    {
                        <div class="empty-state">
                            No hay proveedores registrados
                        </div>
                    }
                    else
                    {
                        @foreach (var p in proveedors)
                        {
                            <div class="provider-card">

                                <div>

                                    <div class="item-title">
                                        @p.Nombre
                                    </div>

                                    <div class="item-subtitle">
                                        @p.Email
                                    </div>

                                </div>

                                <div class="provider-side">

                                    <div>
                                        @p.Telefono
                                    </div>

                                    <div class="item-id">
                                        #@p.Id
                                    </div>

                                </div>

                            </div>
                        }
                    }

                </div>

            </div>
        }

        @if (tab == 2)
        {
            <div class="grid-layout">

               <UserList />
            
            </div>
        }

    </div>

</UserValidator>

<style>
    :root {

        --accent: #ffaa43;
        --accent-soft: rgba(255, 170, 67, .12);
        --accent-border: rgba(255, 170, 67, .18);

        --surface: #121217;

        --border: #23232c;

        --text: #f5f5f7;
        --muted: #8b8b97;
    }

    .settings-page {

        color: var(--text);
        animation: fadeIn .25s ease;
    }

    @@keyframes fadeIn {

        from {

            opacity: 0;
            transform: translateY(8px);
        }

        to {

            opacity: 1;
            transform: translateY(0);
        }
    }

    .settings-header {

        margin-bottom: 2rem;
    }

    .settings-title {

        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -.04em;
    }

    .settings-subtitle {

        color: var(--muted);
        margin-top: .35rem;
    }

    .tabs {

        display: flex;
        gap: .8rem;
        margin-bottom: 2rem;
        flex-wrap: wrap;
    }

    .tab-btn {

        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--muted);

        padding: .85rem 1.2rem;
        border-radius: 14px;

        font-weight: 700;

        display: flex;
        align-items: center;
        gap: .6rem;

        transition: .2s ease;
    }

    .tab-btn:hover {

        border-color: var(--accent-border);
        color: var(--accent);
    }

    .tab-btn.active {

        background: var(--accent-soft);
        border-color: var(--accent-border);
        color: var(--accent);
    }

    .grid-layout {

        display: grid;
        grid-template-columns: 350px 1fr;
        gap: 1.5rem;
    }

    .card-modern {

        background: linear-gradient(180deg,
                rgba(255, 255, 255, .015),
                rgba(255, 255, 255, .01));

        border: 1px solid var(--border);

        border-radius: 24px;
        padding: 1.5rem;

        backdrop-filter: blur(10px);

        box-shadow:
            0 10px 30px rgba(0, 0, 0, .22);
    }

    .card-title {

        font-size: 1.1rem;
        font-weight: 800;
    }

    .input-modern {

        width: 100%;

        background: var(--surface);

        border: 1px solid var(--border);

        color: var(--text);

        padding: .95rem 1rem;

        border-radius: 14px;

        outline: none;

        transition: .2s ease;
    }

    .input-modern:focus {

        border-color: var(--accent);

        box-shadow:
            0 0 0 4px rgba(255, 170, 67, .08);
    }

    .btn-modern {

        width: 100%;

        border: none;

        background: linear-gradient(135deg,
                #ffaa43 0%,
                #ff8c1f 100%);

        color: #111;

        padding: 1rem;

        border-radius: 14px;

        font-weight: 800;

        display: flex;
        align-items: center;
        justify-content: center;
        gap: .6rem;

        transition: .2s ease;
    }

    .btn-modern:hover {

        transform: translateY(-1px);

        box-shadow:
            0 12px 28px rgba(255, 170, 67, .2);
    }

    .list-item,
    .provider-card {

        display: flex;
        align-items: center;
        justify-content: space-between;

        padding: 1rem 0;

        border-bottom: 1px solid rgba(255, 255, 255, .05);
    }

    .item-title {

        font-weight: 700;
    }

    .item-subtitle {

        color: var(--muted);

        margin-top: .2rem;

        font-size: .85rem;
    }

    .item-id {

        color: var(--accent);

        font-size: .82rem;
        font-weight: 700;
    }

    .provider-side {

        text-align: right;
    }

    .empty-state {

        color: var(--muted);

        padding: 2rem 0;

        text-align: center;
    }

    @@media(max-width: 900px) {

        .grid-layout {

            grid-template-columns: 1fr;
        }
    }
</style>

@code {

    private PulperiaDbContext db = default!;

    private List<Categoria> categories = new();
    private List<Proveedor> proveedors = new();

    private int tab = 0;

    private string newCategory = "";

    private Proveedor newProveedor = new();

    protected override async Task OnInitializedAsync()
    {
        db = await dbContextFactory.CreateDbContextAsync();

        await LoadData();
    }

    private async Task LoadData()
    {
        categories = await db.Categoria
            .OrderBy(x => x.Nombre)
            .ToListAsync();

        proveedors = await db.Proveedores
            .OrderBy(x => x.Nombre)
            .ToListAsync();
    }

    private async Task AgregarCategoria()
    {
        if (string.IsNullOrWhiteSpace(newCategory))
            return;

        db.Categoria.Add(new Categoria
        {
            Nombre = newCategory.Trim()
        });

        await db.SaveChangesAsync();

        newCategory = "";

        await LoadData();
    }

    private async Task AgregarProveedor()
    {
        if (string.IsNullOrWhiteSpace(newProveedor.Nombre))
            return;

        db.Proveedores.Add(new Proveedor
        {
            Nombre = newProveedor.Nombre.Trim(),
            Telefono = newProveedor.Telefono,
            Email = newProveedor.Email
        });

        await db.SaveChangesAsync();

        newProveedor = new();

        await LoadData();
    }
}