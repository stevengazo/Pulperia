@page "/configuracion"
@inject IDbContextFactory<PulperiaDbContext> dbContextFactory
    @using System.Text.Json

<h2 class="text-light">Configuración</h2>
<hr class="border-secondary" />

<ul class="nav nav-pills mb-4 gap-2">
    <li class="nav-item">
        <button class="btn @(tab == 0 ? "btn-primary" : "btn-outline-light")" @onclick="() => tab = 0">
            Logs
        </button>
    </li>

    <li class="nav-item">
        <button class="btn @(tab == 1 ? "btn-primary" : "btn-outline-light")" @onclick="() => tab = 1">
            Categorías
        </button>
    </li>

    <li class="nav-item">
        <button class="btn @(tab == 2 ? "btn-primary" : "btn-outline-light")" @onclick="() => tab = 2">
            Proveedores
        </button>
    </li>
</ul>

<!-- ================= LOGS ================= -->
@if (tab == 0)
{
    <div class="card bg-dark text-light border-secondary p-3">
        <h4>Logs del sistema</h4>

        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Usuario</th>
                        <th>Acción</th>
                        <th>Tabla</th>
                        <th>Registro</th>
                        <th>Nuevo</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var log in logs)
                    {
                        <tr>
                            <td>@log.Fecha.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@log.Usuario</td>
                            <td>
                                <span class="badge bg-info text-dark">@log.Accion</span>
                            </td>
                            <td>@log.Tabla</td>
                            <td>@log.RegistroId</td>
                         <td>
    @if (!string.IsNullOrWhiteSpace(log.ValoresNuevos))
    {
        <pre class="json-box">
@FormatJson(log.ValoresNuevos)
        </pre>
    }
</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- ================= CATEGORÍAS ================= -->
@if (tab == 1)
{
    <div class="row g-3">
        <div class="col-md-4">
            <div class="card bg-dark text-light border-secondary p-3">
                <h5>Nueva categoría</h5>

                <input class="form-control bg-dark text-light border-secondary mb-2" placeholder="Nombre categoría"
                       @bind="newCategory" />

                <button class="btn btn-success w-100" @onclick="AgregarCategoria">
                    Guardar categoría
                </button>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card bg-dark text-light border-secondary p-3">
                <h5>Categorías</h5>

                @if (categories.Count == 0)
                {
                    <p class="text-muted">No hay categorías</p>
                }
                else
                {
                    @foreach (var c in categories)
                    {
                        <div class="d-flex justify-content-between border-bottom border-secondary py-2">
                            <div>
                                <strong>@c.Nombre</strong>
                            </div>
                            <span class="text-muted">#@c.Id</span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

<!-- ================= PROVEEDORES ================= -->
@if (tab == 2)
{
    <div class="row g-3">

        <!-- FORM -->
        <div class="col-md-4">
            <div class="card bg-dark text-light border-secondary p-3">
                <h5>Nuevo proveedor</h5>

                <input class="form-control bg-dark text-light border-secondary mb-2" placeholder="Nombre"
                       @bind="newProveedor.Nombre" />

                <input class="form-control bg-dark text-light border-secondary mb-2" placeholder="Teléfono"
                       @bind="newProveedor.Telefono" />

                <input class="form-control bg-dark text-light border-secondary mb-2" placeholder="Email"
                       @bind="newProveedor.Email" />

                <button class="btn btn-primary w-100" @onclick="AgregarProveedor">
                    Guardar proveedor
                </button>
            </div>
        </div>

        <!-- LISTA -->
        <div class="col-md-8">
            <div class="card bg-dark text-light border-secondary p-3">
                <h5>Proveedores</h5>

                @if (proveedors.Count == 0)
                {
                    <p class="text-muted">No hay proveedores</p>
                }
                else
                {
                    @foreach (var p in proveedors)
                    {
                        <div class="border border-secondary rounded p-2 mb-2 d-flex justify-content-between">
                            <div>
                                <strong>@p.Nombre</strong><br />
                                <small class="text-muted">@p.Email</small>
                            </div>

                            <div class="text-end">
                                <div>@p.Telefono</div>
                                <small class="text-muted">#@p.Id</small>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    private PulperiaDbContext db;

    private List<LogCambio> logs = new();
    private List<Categoria> categories = new();
    private List<Proveedor> proveedors = new();

    private int tab = 0;

    private string newCategory = "";
    private Proveedor newProveedor = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

private string FormatJson(string json)
{
    try
    {
        using var doc = JsonDocument.Parse(json);
        return JsonSerializer.Serialize(doc, new JsonSerializerOptions
        {
            WriteIndented = true
        });
    }
    catch
    {
        return json;
    }
}
    private async Task LoadData()
    {
        db = await dbContextFactory.CreateDbContextAsync();

        logs = await db.LogsCambios
            .OrderByDescending(x => x.Fecha)
            .Take(100)
            .ToListAsync();

        categories = await db.Categoria
            .OrderBy(x => x.Nombre)
            .ToListAsync();

        proveedors = await db.Proveedores
            .OrderBy(x => x.Nombre)
            .ToListAsync();
    }

    private async Task AgregarCategoria()
    {
        if (string.IsNullOrWhiteSpace(newCategory))
            return;

        db.Categoria.Add(new Categoria
        {
            Nombre = newCategory.Trim()
        });

        await db.SaveChangesAsync();

        newCategory = "";
        await LoadData();
    }

    private async Task AgregarProveedor()
    {
        if (string.IsNullOrWhiteSpace(newProveedor.Nombre))
            return;

        db.Proveedores.Add(new Proveedor
        {
            Nombre = newProveedor.Nombre.Trim(),
            Telefono = newProveedor.Telefono,
            Email = newProveedor.Email
        });

        await db.SaveChangesAsync();

        newProveedor = new Proveedor();
        await LoadData();
    }
}