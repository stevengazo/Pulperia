                    </span>

                    <span class="nav-text">
                        Nueva Venta
                    </span>

                </NavLink>

            </div>

            <div class="nav-divider"></div>

            <div class="nav-section">

                <div class="nav-section-label">
                    GESTIÓN
                </div>

                <NavLink class="nav-link"
                         href="productos">

                    <span class="nav-icon">
                        <i class="bi bi-box-seam-fill"></i>
                    </span>

                    <span class="nav-text">
                        Productos
                    </span>

                </NavLink>

                <NavLink class="nav-link"
                         href="inventario">

                    <span class="nav-icon">
                        <i class="bi bi-stack"></i>
