                        Inventario
                    </span>

                </NavLink>

                <NavLink class="nav-link"
                         href="empleados">

                    <span class="nav-icon">
                        <i class="bi bi-people-fill"></i>
                    </span>

                    <span class="nav-text">
                        Empleados
                    </span>

                </NavLink>

            </div>

            <div class="nav-divider"></div>

            <div class="nav-section">

                <div class="nav-section-label">
                    SISTEMA
                </div>

                <NavLink class="nav-link"
                         href="configuracion">

                    <span class="nav-icon">
                        <i class="bi bi-gear-fill"></i>
                    </span>

                    <span class="nav-text">
                        Configuración
                    </span>

                </NavLink>

                <NavLink class="nav-link"
                         href="logs">

