<div class="sidebar-wrapper">
    @* Navbar superior (Brand) *@
    <nav class="sidebar-header px-3">
        <div class="brand-logo">
            <span class="brand-icon"><i class="bi bi-bag-check-fill"></i></span>
            <span class="brand-name">Gestión</span>
        </div>
        <button class="toggler-btn d-md-none" @onclick="ToggleNavMenu">
            <i class="bi bi-list"></i>
        </button>
    </nav>

    @* Contenedor de navegación *@
    <div class="@NavMenuCssClass">
        <nav class="nav-content d-flex flex-column p-3 gap-1">

            <p class="nav-section-label">MENÚ PRINCIPAL</p>

            <NavLink class="nav-link d-flex align-items-center gap-2" href="" Match="NavLinkMatch.All">
                <span class="nav-icon"><i class="bi bi-house-fill"></i></span>
                <span>Inicio</span>
            </NavLink>

            <NavLink class="nav-link d-flex align-items-center gap-2" href="productos">
                <span class="nav-icon"><i class="bi bi-box-seam-fill"></i></span>
                <span>Productos</span>
            </NavLink>

            <NavLink class="nav-link d-flex align-items-center gap-2" href="empleados">
                <span class="nav-icon"><i class="bi bi-people-fill"></i></span>
                <span>Empleados</span>
            </NavLink>

            <NavLink class="nav-link d-flex align-items-center gap-2" href="ventas">
                <span class="nav-icon"><i class="bi bi-receipt-cutoff"></i></span>
                <span>Ventas</span>
            </NavLink>

            <NavLink class="nav-link d-flex align-items-center gap-2" href="inventario">
                <span class="nav-icon"><i class="bi bi-clipboard-data-fill"></i></span>
                <span>Inventario</span>
            </NavLink>

            <hr class="nav-divider" />

            <p class="nav-section-label">SISTEMA</p>

            <NavLink class="nav-link d-flex align-items-center gap-2" href="configuracion">
                <span class="nav-icon"><i class="bi bi-gear-fill"></i></span>
                <span>Configuración</span>
            </NavLink>

            @* BOTÓN INFERIOR *@
            <div class="mt-auto pt-3">
                <NavLink class="btn-nueva-venta d-flex align-items-center justify-content-center gap-2" href="nueva-venta">
                    <i class="bi bi-plus-lg"></i>
                    <span>NUEVA VENTA</span>
                </NavLink>
            </div>

        </nav>
    </div>
</div>

<style>
    :root {
        --accent: #ffaa43;
        --accent-glow: rgba(255, 170, 67, 0.15);
        --accent-dim: rgba(255, 170, 67, 0.6);
        --sidebar-bg: #0f1117;
        --sidebar-surface: #181c27;
        --text-muted: rgba(255,255,255,0.4);
        --text-main: rgba(255,255,255,0.85);
        --border: rgba(255,255,255,0.07);
    }

    /* Wrapper principal */
    .sidebar-wrapper {
        position: sticky;
        top: 0;
        height: 100vh;
        display: flex;
        flex-direction: column;
        background-color: var(--sidebar-bg);
        border-right: 1px solid var(--border);
        overflow: hidden;
    }

    /* Header / Brand */
    .sidebar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem 1rem;
        border-bottom: 1px solid var(--border);
    }

    .brand-logo {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .brand-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        background: var(--accent);
        border-radius: 8px;
        color: #0f1117;
        font-size: 1rem;
    }

    .brand-name {
        font-size: 1rem;
        font-weight: 700;
        color: var(--text-main);
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .toggler-btn {
        background: none;
        border: 1px solid var(--border);
        color: var(--text-muted);
        border-radius: 6px;
        padding: 0.3rem 0.6rem;
        font-size: 1.1rem;
        cursor: pointer;
        transition: color 0.2s;
    }

    .toggler-btn:hover {
        color: var(--accent);
    }

    /* Etiquetas de sección */
    .nav-section-label {
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        color: var(--text-muted);
        margin: 0.5rem 0.25rem 0.25rem;
        text-transform: uppercase;
    }

    /* Nav content */
    .nav-content {
        flex-grow: 1;
        overflow: hidden;
    }

    /* Links */
    .nav-link {
        color: var(--text-muted) !important;
        transition: all 0.2s ease;
        padding: 0.65rem 0.85rem;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        position: relative;
    }

    .nav-link:hover {
        color: var(--text-main) !important;
        background-color: rgba(255,255,255,0.05);
    }

    .nav-link.active {
        color: var(--accent) !important;
        background-color: var(--accent-glow);
    }

    /* Icono de nav */
    .nav-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        font-size: 0.95rem;
    }

    .nav-link.active .nav-icon {
        color: var(--accent);
    }

    /* Línea divisora */
    .nav-divider {
        border: none;
        border-top: 1px solid var(--border);
        margin: 0.5rem 0;
        opacity: 1;
    }

    /* Botón nueva venta */
    .btn-nueva-venta {
        display: flex;
        width: 100%;
        padding: 0.8rem;
        background: var(--accent);
        color: #0f1117 !important;
        border-radius: 10px;
        font-size: 0.85rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-decoration: none;
        transition: all 0.2s ease;
        box-shadow: 0 4px 15px rgba(255, 170, 67, 0.25);
    }

    .btn-nueva-venta:hover {
        background: #ffc266;
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(255, 170, 67, 0.4);
        color: #0f1117 !important;
    }

    .btn-nueva-venta:active {
        transform: translateY(0);
    }

    /* Responsivo */
    @@media (max-width: 767.98px) {
        .sidebar-wrapper {
            height: auto;
            position: relative;
        }
    }
</style>

@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse d-md-block flex-grow-1" : "d-block flex-grow-1";

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;
}
