@inherits LayoutComponentBase

@inject AppSessionService Session

<PageTitle>Pulpería - Sistema POS</PageTitle>

<div class="layout">

    @if (Session.IsAuthenticated)
    {
        <aside class="sidebar">
            <div class="brand">
                <span class="brand-icon">P</span>
                <span class="brand-name">Pulpe<span class="brand-accent">POS</span></span>
            </div>
            <NavMenu />
        </aside>
    }


    <div class="main-area">

        <header class="topbar p-2">

            <div class="topbar-right d-flex flex-row gap-2">
                @if (!Session.IsAuthenticated)
                {
                    <a href="/login">iniciar Sesion</a>
                }
                else
                {
                    <span class="user-label">
                        <i class="bi bi-person-circle text-white "></i> @Session?.CurrentUser?.Email
                    </span>
                    <a href="logout" class="btn-logout">Salir</a>

                }
            </div>
        </header>

        <article class="content">
            @Body
        </article>
    </div>
</div>

<style>
    *,
    *::before,
    *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

:root {
    --bg: #000000;
    --surface: #0e0e11;
    --border: #17171c;
    --text: #d8d8e0;
    --muted: #3a3a46;

    --accent: #ffaa43;
    --accent-dim: #2a1a06;

    --sidebar-w: 220px;
    --topbar-h: 50px;
}
    .layout {
        display: flex;
        background: var(--bg);
        color: var(--text);
        font-family: 'DM Sans', system-ui, sans-serif;
    }

    .sidebar {
        width: var(--sidebar-w);
        background: var(--surface);
        border-right: 0.5px solid var(--border);
        position: fixed;
        top: 0;
        left: 0;
        height: 100vh;
        display: flex;
        flex-direction: column;
        z-index: 100;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 17px 20px 15px;
        border-bottom: 0.5px solid var(--border);
    }

    .brand-icon {
        width: 26px;
        height: 26px;
        background: var(--accent);
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 700;
        color: #fff;
        flex-shrink: 0;
    }

    .brand-name {
        font-size: 14px;
        font-weight: 600;
        color: var(--text);
        letter-spacing: -0.01em;
    }

    .brand-accent {
        color: var(--accent);
    }

    .main-area {
        height: 100vh;
        margin-left: var(--sidebar-w);
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .topbar {
        height: var(--topbar-h);
        background: var(--surface);
        border-bottom: 0.5px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: flex-end;
        padding: 0 24px;
        position: sticky;
        top: 0;
        z-index: 50;
    }

    .topbar-right {
        display: flex;
        align-items: center;
        gap: 0px;
    }

    .user-label {
        font-size: 12px;
        color: var(--muted);
    }

    .btn-logout {
        font-size: 12px;
        color: red;
        text-decoration: none;
        border: 0.5px solid #bb0d0d;
        border-radius: 5px;
        padding: 5px 11px;
        transition: color 0.15s, border-color 0.15s;
    }

    .btn-logout:hover {
        color: #e2734a;
        border-color: #e2734a44;
    }

    .content {
        flex: 1;
        padding: 2rem 2.5rem;
        background: var(--bg);
    }

    ::-webkit-scrollbar {
        width: 5px;
    }

    ::-webkit-scrollbar-track {
        background: transparent;
    }

    ::-webkit-scrollbar-thumb {
        background: #202026;
        border-radius: 10px;
    }

    ::-webkit-scrollbar-thumb:hover {
        background: var(--muted);
    }
</style>