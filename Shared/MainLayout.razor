@inherits LayoutComponentBase

@inject AppSessionService Session
@inject NavigationManager Navigation

<PageTitle>Pulpería - Sistema POS</PageTitle>

@code {

    private bool IsLoginPage =>
        Navigation.Uri.Contains("/login", StringComparison.OrdinalIgnoreCase);

    private async Task OnClose()
    {
        await Session.LogoutAsync();

        Navigation.NavigateTo("/login", true);
    }
}

@if (IsLoginPage)
{
    <AppErrorBoundary>
        @Body
    </AppErrorBoundary>
}
else
{
    <div class="layout">

        @if (Session.IsAuthenticated)
        {
            <aside class="sidebar">

                <div class="brand">

                    <div class="brand-logo">
                        P
                    </div>

                    <div class="brand-content">
                        <div class="brand-title">
                            Pulpe<span>POS</span>
                        </div>

                        <div class="brand-subtitle">
                            Sistema Administrativo
                        </div>
                    </div>

                </div>

                <div class="sidebar-menu">
                    <NavMenu />
                </div>

                <div class="sidebar-footer">

                    <div class="footer-user">
                        <i class="bi bi-person-circle"></i>

                        <div>
                            <div class="footer-email">
                                @Session?.CurrentUser?.Email
                            </div>

                            <div class="footer-role">
                                Usuario activo
                            </div>
                        </div>
                    </div>

                    <button class="logout-btn"
                            @onclick="OnClose">

                        <i class="bi bi-box-arrow-right"></i>
                        Cerrar sesión

                    </button>

                </div>

            </aside>
        }

        <div class="main-area @(Session.IsAuthenticated ? "" : "full-width")">

            <header class="topbar">

                <div class="topbar-left">

                    @if (Session.IsAuthenticated)
                    {
                        <TopbarSearch />
                    }
                    else
                    {
                        <div class="page-title">
                            Sistema POS
                        </div>
                    }

                </div>

                <div class="topbar-right">

                    <ThemeToggle />

                    @if (!Session.IsAuthenticated)
                    {
                        <a href="/login" class="login-link">
                            Iniciar Sesión
                        </a>
                    }
                    else
                    {
                        <a class="status-badge" href="/nueva-venta">
                           <i class="fa-solid fa-cart-shopping"></i> Generar Venta

                        </a>
                    }

                </div>

            </header>

            <main class="content">
                <AppErrorBoundary>
                    @Body
                </AppErrorBoundary>
            </main>

        </div>

    </div>
}